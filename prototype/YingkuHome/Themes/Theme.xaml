<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ============ typography ============ -->
    <FontFamily x:Key="DisplayFont">Segoe UI Variable Display, Noto Sans SC</FontFamily>
    <FontFamily x:Key="UiFont">Segoe UI Variable Text, Noto Sans SC</FontFamily>
    <FontFamily x:Key="IconFont">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>

    <!-- ============ colour ============ -->
    <SolidColorBrush x:Key="AppBgBrush" Color="#0B0D12" />
    <SolidColorBrush x:Key="SurfaceBrush" Color="#12161F" />
    <SolidColorBrush x:Key="SurfaceRaisedBrush" Color="#171C27" />
    <SolidColorBrush x:Key="CardBorderBrush" Color="#202634" />
    <SolidColorBrush x:Key="CardHoverBorderBrush" Color="#3B4A6E" />
    <SolidColorBrush x:Key="DividerBrush" Color="#1B212D" />
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="#F2F5FA" />
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#98A2B5" />
    <SolidColorBrush x:Key="TextTertiaryBrush" Color="#6B7488" />
    <SolidColorBrush x:Key="AccentBrush" Color="#6E86FF" />
    <SolidColorBrush x:Key="OnMediaBrush" Color="#FFFFFF" />

    <LinearGradientBrush x:Key="HeroLeftScrim" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="#D90B0D12" Offset="0" />
        <GradientStop Color="#B80B0D12" Offset="0.26" />
        <GradientStop Color="#7A0B0D12" Offset="0.50" />
        <GradientStop Color="#2E0B0D12" Offset="0.74" />
        <GradientStop Color="#000B0D12" Offset="1" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="HeroBottomScrim" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#000B0D12" Offset="0" />
        <GradientStop Color="#8C0B0D12" Offset="0.55" />
        <GradientStop Color="#0B0D12" Offset="1" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="CardTopScrim" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#B3000000" Offset="0" />
        <GradientStop Color="#4D000000" Offset="0.34" />
        <GradientStop Color="#00000000" Offset="0.62" />
        <GradientStop Color="#59000000" Offset="1" />
    </LinearGradientBrush>

    <!-- ============ base text ============ -->
    <Style TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
        <Setter Property="TextOptions.TextFormattingMode" Value="Ideal" />
        <Setter Property="TextOptions.TextRenderingMode" Value="ClearType" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
    </Style>

    <!-- ============ hero buttons ============ -->
    <Style x:Key="HeroPrimaryButton" TargetType="Button">
        <Setter Property="Height" Value="42" />
        <Setter Property="Padding" Value="20,0" />
        <Setter Property="Foreground" Value="#0B0D12" />
        <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
        <Setter Property="FontSize" Value="13.5" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" CornerRadius="9" Background="#F2F5FA" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="#FFFFFF" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="#D9E0EC" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="HeroGhostButton" TargetType="Button">
        <Setter Property="Height" Value="42" />
        <Setter Property="Padding" Value="18,0" />
        <Setter Property="Foreground" Value="#F2F5FA" />
        <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
        <Setter Property="FontSize" Value="13.5" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" CornerRadius="9" Background="#26FFFFFF"
                            BorderBrush="#33FFFFFF" BorderThickness="1" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="#38FFFFFF" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="#1FFFFFFF" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="HeroIconButton" TargetType="Button" BasedOn="{StaticResource HeroGhostButton}">
        <Setter Property="Width" Value="42" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="FontFamily" Value="{StaticResource IconFont}" />
        <Setter Property="FontSize" Value="15" />
    </Style>

    <!-- ============ header ============ -->
    <Style x:Key="NavPill" TargetType="RadioButton">
        <Setter Property="Height" Value="34" />
        <Setter Property="Padding" Value="14,0" />
        <Setter Property="Foreground" Value="#C7D0DE" />
        <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
        <Setter Property="FontSize" Value="13.5" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Border x:Name="Bd" CornerRadius="17" Background="Transparent" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="#1FFFFFFF" />
                            <Setter Property="Foreground" Value="#F2F5FA" />
                            <Setter Property="FontWeight" Value="SemiBold" />
                        </Trigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsMouseOver" Value="True" />
                                <Condition Property="IsChecked" Value="False" />
                            </MultiTrigger.Conditions>
                            <Setter TargetName="Bd" Property="Background" Value="#14FFFFFF" />
                            <Setter Property="Foreground" Value="#E6EBF3" />
                        </MultiTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="SectionAction" TargetType="Button">
        <Setter Property="Foreground" Value="{StaticResource TextTertiaryBrush}" />
        <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
        <Setter Property="FontSize" Value="12.5" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border Background="Transparent" Padding="8,4">
                        <ContentPresenter VerticalAlignment="Center" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
            </Trigger>
        </Style.Triggers>
    </Style>

</ResourceDictionary>

