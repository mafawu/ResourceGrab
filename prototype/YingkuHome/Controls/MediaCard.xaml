<UserControl x:Class="YingkuHome.Controls.MediaCard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:YingkuHome.Controls"
             x:Name="Self" Width="170" Height="255" Margin="0,0,16,0"
             Background="Transparent" Cursor="Hand"
             MouseEnter="OnMouseEnter" MouseLeave="OnMouseLeave"
             MouseLeftButtonUp="OnClick">
    <Grid x:Name="Root" RenderTransformOrigin="0.5,0.5">
        <Grid.RenderTransform>
            <ScaleTransform x:Name="Scale" ScaleX="1" ScaleY="1" />
        </Grid.RenderTransform>

        <Border x:Name="Frame" CornerRadius="14" BorderThickness="1"
                BorderBrush="{DynamicResource CardBorderBrush}"
                Background="{DynamicResource SurfaceBrush}">
            <Grid ClipToBounds="True">
                <Border CornerRadius="13">
                    <Border.Background>
                        <ImageBrush x:Name="PosterBrush" Stretch="UniformToFill" />
                    </Border.Background>
                </Border>

                <Border CornerRadius="13" Background="{DynamicResource CardTopScrim}" />

                <StackPanel VerticalAlignment="Top" Margin="12,12,12,0">
                    <Border Background="#A6000000" BorderBrush="#33FFFFFF" BorderThickness="1"
                            CornerRadius="6" Padding="7,3" HorizontalAlignment="Left">
                        <TextBlock x:Name="CodeText" FontSize="10.5" Foreground="#F2F5FA"
                                   FontWeight="Medium" />
                    </Border>

                    <TextBlock x:Name="TitleText" Margin="0,20,0,0" HorizontalAlignment="Center"
                               FontSize="14.5" FontWeight="SemiBold" Foreground="#FFFFFF"
                               TextTrimming="CharacterEllipsis" />

                    <TextBlock x:Name="SubText" Margin="0,6,0,0" HorizontalAlignment="Center"
                               FontSize="7.2" Foreground="#C4FFFFFF" MaxWidth="140"
                               TextTrimming="CharacterEllipsis" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- hover ring -->
        <Border x:Name="HoverRing" CornerRadius="14" BorderThickness="1"
                BorderBrush="#7A8FB8" Opacity="0" IsHitTestVisible="False" />

        <!-- selected ring -->
        <Border x:Name="SelectedRing" CornerRadius="14" BorderThickness="2"
                BorderBrush="{DynamicResource AccentBrush}" Opacity="0" IsHitTestVisible="False" />
    </Grid>
</UserControl>
