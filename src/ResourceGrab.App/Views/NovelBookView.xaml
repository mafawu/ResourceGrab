<UserControl x:Class="ResourceGrab.App.Views.NovelBookView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />

        <DataTemplate x:Key="NovelChapterRowTemplate">
            <Grid Height="38" Background="Transparent">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="72" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="96" />
                    <ColumnDefinition Width="22" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="{Binding IndexText}" FontSize="11.5" VerticalAlignment="Center"
                           Foreground="{DynamicResource TextDisabledBrush}" />
                <TextBlock Grid.Column="1" Text="{Binding Title}" FontSize="13" VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis" Foreground="{DynamicResource TextPrimaryBrush}" />
                <TextBlock Grid.Column="2" Text="{Binding TimeText}" FontSize="11.5" VerticalAlignment="Center"
                           HorizontalAlignment="Right" Foreground="{DynamicResource TextDisabledBrush}" />
                <Path Grid.Column="3" Data="{StaticResource IconCheck}" Width="12" Height="12" Stretch="Uniform"
                      Stroke="{DynamicResource SuccessBrush}" StrokeThickness="2"
                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                      HorizontalAlignment="Right" VerticalAlignment="Center"
                      Visibility="{Binding IsRead, Converter={StaticResource BoolToVis}}" />
            </Grid>
        </DataTemplate>

        <Style x:Key="NovelChapterItemStyle" TargetType="ListBoxItem">
            <Setter Property="Padding" Value="8,0" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Bd" Background="Transparent" Padding="{TemplateBinding Padding}"
                                BorderBrush="{DynamicResource DividerBrush}" BorderThickness="0,0,0,1">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource HoverBgBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 书籍头 -->
        <Border Grid.Row="0" Style="{StaticResource CardPanelStyle}" Padding="18">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Grid Width="140" Height="186" VerticalAlignment="Top">
                    <Border CornerRadius="{DynamicResource RadiusLg}" Background="{DynamicResource HoverBgBrush}"
                            BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" ClipToBounds="True" />
                    <Image x:Name="CoverImage" Stretch="UniformToFill" />
                    <TextBlock x:Name="CoverFallback" FontSize="44" FontWeight="Bold"
                               Foreground="{DynamicResource TextDisabledBrush}"
                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Grid>

                <StackPanel Grid.Column="1" Margin="18,0,0,0">
                    <StackPanel Orientation="Horizontal">
                        <Button Style="{StaticResource IconButtonStyle}" ToolTip="返回" Click="BackButton_Click"
                                VerticalAlignment="Center">
                            <Path Data="{StaticResource IconBack}" Stroke="{DynamicResource TextPrimaryBrush}"
                                  StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                  StrokeLineJoin="Round" Stretch="Uniform" Width="15" Height="15" />
                        </Button>
                        <TextBlock x:Name="TitleText" FontSize="20" FontWeight="Bold" Margin="9,0,12,0"
                                   VerticalAlignment="Center" TextWrapping="Wrap" />
                    </StackPanel>

                    <TextBlock x:Name="FactsText" FontSize="12" Margin="0,8,0,0"
                               Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" />

                    <ItemsControl x:Name="TagsHost" Margin="0,8,0,0">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <!-- 标签可点：命中分类名就去分类页，否则按标签搜索 -->
                                <Button Tag="{Binding}" Click="Tag_Click" Cursor="Hand" Focusable="False"
                                        ToolTip="{Binding}" Background="Transparent" BorderThickness="0"
                                        Margin="0,0,6,6" Padding="0">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="Bd" Background="{DynamicResource HoverBgBrush}"
                                                    CornerRadius="10" Padding="9,3">
                                                <TextBlock Text="{Binding}" FontSize="11.5"
                                                           Foreground="{DynamicResource TextSecondaryBrush}" />
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="Bd" Property="Background"
                                                            Value="{DynamicResource DividerStrongBrush}" />
                                                    <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <TextBlock x:Name="IntroText" FontSize="13" Margin="0,8,0,0" MaxHeight="58"
                               TextWrapping="Wrap" LineHeight="21" ClipToBounds="True"
                               Foreground="{DynamicResource TextSecondaryBrush}" />
                    <Button x:Name="IntroToggle" Content="展开" Style="{StaticResource GhostButtonStyle}"
                            HorizontalAlignment="Left" Padding="0" BorderThickness="0" FontSize="12"
                            Foreground="{DynamicResource TextLinkBrush}" Margin="0,2,0,0" Click="IntroToggle_Click"
                            Visibility="Collapsed" />

                    <!-- 本地优先条：命中本地索引时出现 -->
                    <Border x:Name="LocalBar" Margin="0,12,0,0" Padding="10,8" CornerRadius="{DynamicResource RadiusMd}"
                            Background="{DynamicResource HoverBgBrush}" BorderBrush="{DynamicResource CardBorderBrush}"
                            BorderThickness="1" Visibility="Collapsed">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Path Data="{StaticResource IconCheck}" Width="13" Height="13" Stretch="Uniform"
                                  Stroke="{DynamicResource SuccessBrush}" StrokeThickness="2"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                  VerticalAlignment="Center" />
                            <TextBlock Grid.Column="1" x:Name="LocalTitle" Text="本地已有" FontSize="12"
                                       FontWeight="SemiBold" Margin="7,0,0,0" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="2" x:Name="LocalPath" FontSize="11.5" Margin="10,0,8,0"
                                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                       Foreground="{DynamicResource TextDisabledBrush}" />
                            <StackPanel Grid.Column="3" Orientation="Horizontal">
                                <Button x:Name="OpenLocalFolderBtn" Content="打开文件夹" Style="{StaticResource GhostButtonStyle}"
                                        Padding="8,3" FontSize="11.5" Click="OpenLocalFolder_Click" />
                                <Button x:Name="UseOnlineBtn" Content="改用在线数据" Style="{StaticResource GhostButtonStyle}"
                                        Padding="8,3" FontSize="11.5" Margin="6,0,0,0" Click="UseOnline_Click" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                        <Button x:Name="ReadButton" Style="{StaticResource PrimaryButtonStyle}"
                                Content="开始阅读" Click="ReadButton_Click" Padding="16,7" />
                        <Button x:Name="ExportButton" Style="{StaticResource GhostButtonStyle}" Content="导出 TXT"
                                Margin="8,0,0,0" Padding="14,7" Click="ExportButton_Click" />
                        <Button x:Name="ShelfButton" Style="{StaticResource GhostButtonStyle}" Content="加入书架"
                                Margin="8,0,0,0" Padding="14,7" Click="ShelfButton_Click" />
                        <TextBlock x:Name="ActionHint" FontSize="11.5" Margin="10,0,0,0" VerticalAlignment="Center"
                                   Foreground="{DynamicResource TextDisabledBrush}" />
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 目录头 -->
        <Grid Grid.Row="1" Margin="4,16,4,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="目录" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center" />
            <TextBlock Grid.Column="1" x:Name="ChapterCountText" FontSize="12" Margin="10,0,0,0"
                       VerticalAlignment="Center" Foreground="{DynamicResource TextDisabledBrush}" />
            <Button Grid.Column="3" x:Name="SortButton" Content="倒序" Style="{StaticResource GhostButtonStyle}"
                    Padding="10,4" FontSize="11.5" Click="SortButton_Click" />
            <Button Grid.Column="4" x:Name="JumpLatestButton" Content="跳到最新" Style="{StaticResource GhostButtonStyle}"
                    Padding="10,4" FontSize="11.5" Margin="6,0,0,0" Click="JumpLatest_Click" />
        </Grid>

        <ListBox Grid.Row="2" x:Name="ChapterList" Margin="4,10,4,0"
                 Background="Transparent" BorderThickness="0"
                 ItemContainerStyle="{StaticResource NovelChapterItemStyle}"
                 ItemTemplate="{StaticResource NovelChapterRowTemplate}"
                 VirtualizingPanel.IsVirtualizing="True"
                 VirtualizingPanel.VirtualizationMode="Recycling"
                 VirtualizingPanel.ScrollUnit="Pixel"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                 SelectionChanged="ChapterList_SelectionChanged">
            <ListBox.ItemsPanel>
                <ItemsPanelTemplate>
                    <VirtualizingStackPanel />
                </ItemsPanelTemplate>
            </ListBox.ItemsPanel>
        </ListBox>

        <!-- 底部状态：导出进度 / 提示 -->
        <Border Grid.Row="3" x:Name="StatusBar" Margin="4,10,4,0" Padding="10,7" CornerRadius="{DynamicResource RadiusMd}"
                Background="{DynamicResource HoverBgBrush}" Visibility="Collapsed">
            <TextBlock x:Name="StatusText" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" />
        </Border>
    </Grid>
</UserControl>
