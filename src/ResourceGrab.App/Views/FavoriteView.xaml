<controls:CardGridViewBase x:Class="ResourceGrab.App.Views.FavoriteView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:ResourceGrab.App.Controls">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 未登录提示 -->
        <StackPanel x:Name="LoginPrompt" Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Center">
            <Border Width="76" Height="76" CornerRadius="24"
                    Background="{DynamicResource PrimarySubtleBrush}">
                <Path Data="{StaticResource IconFavoriteStar}" Stroke="{DynamicResource PrimaryBrush}" StrokeThickness="2.2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Stretch="Uniform" Width="30" Height="30" HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <TextBlock Text="登录后即可查看收藏夹" FontSize="15" FontWeight="SemiBold"
                       Margin="0,18,0,0" HorizontalAlignment="Center" />
            <TextBlock Text="登录账号后，收藏的漫画会同步到这里" FontSize="12"
                       Foreground="{DynamicResource TextSecondaryBrush}"
                       Margin="0,6,0,0" HorizontalAlignment="Center" />
            <Button Content="去登录" Style="{StaticResource PrimaryButtonStyle}"
                    Margin="0,18,0,0" HorizontalAlignment="Center"
                    Click="LoginButton_Click" />
        </StackPanel>

        <!-- 收藏内容 -->
        <Grid x:Name="FavoriteContent" Visibility="Collapsed">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="0,0,0,14">
                <StackPanel Orientation="Horizontal">
                    <TextBlock x:Name="FavoriteTitle" Text="我的收藏" FontSize="18" FontWeight="Bold"
                               VerticalAlignment="Center" />
                    <Border Style="{StaticResource CountBadgeStyle}" Margin="10,0,0,0">
                        <TextBlock x:Name="FavoriteCount" FontSize="11"
                                   Foreground="{DynamicResource PrimaryBrush}" />
                    </Border>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"
                            VerticalAlignment="Center">
                    <controls:CardSizeSlider Columns="{Binding Columns, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                             VerticalAlignment="Center" />
                    <Button Style="{StaticResource LibraryActionButtonStyle}" Content="刷新"
                            Click="RefreshButton_Click" />
                </StackPanel>
            </Grid>

            <Grid Grid.Row="1">
                <StackPanel x:Name="FavoriteLoading" VerticalAlignment="Center" HorizontalAlignment="Center">
                    <Border Width="72" Height="72" CornerRadius="24"
                            Background="{DynamicResource HoverBgBrush}">
                        <Path Data="{StaticResource IconLoading}" Stroke="{DynamicResource TextSecondaryBrush}" StrokeThickness="2.2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Stretch="Uniform" Width="26" Height="26" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <TextBlock Text="加载中…" FontSize="15" FontWeight="SemiBold"
                               Margin="0,16,0,0" HorizontalAlignment="Center" />
                    <TextBlock Text="正在同步收藏夹，稍候片刻" FontSize="12"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               Margin="0,6,0,0" HorizontalAlignment="Center" />
                </StackPanel>
                <StackPanel x:Name="FavoriteEmpty" VerticalAlignment="Center" HorizontalAlignment="Center"
                            Visibility="Collapsed">
                    <Border Width="72" Height="72" CornerRadius="24"
                            Background="{DynamicResource HoverBgBrush}">
                        <Path Data="{StaticResource IconHeart}" Stroke="{DynamicResource TextDisabledBrush}" StrokeThickness="2.2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Stretch="Uniform" Width="26" Height="26" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <TextBlock Text="收藏夹空空如也" FontSize="15" FontWeight="SemiBold"
                               Margin="0,16,0,0" HorizontalAlignment="Center" />
                    <TextBlock Text="在漫画详情页点击收藏即可加入这里" FontSize="12"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               Margin="0,6,0,0" HorizontalAlignment="Center" />
                </StackPanel>
                <Grid x:Name="FavoriteScroller" Visibility="Collapsed">
                    <controls:VirtualizedCardGrid x:Name="FavoriteItems"
                                                  SlotWidth="{Binding SlotWidth, RelativeSource={RelativeSource AncestorType=UserControl}}" DesiredColumns="{Binding Columns, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                  CardWidth="{Binding CardWidth, RelativeSource={RelativeSource AncestorType=UserControl}}">
                        <controls:VirtualizedCardGrid.ItemTemplate>
                            <DataTemplate>
                                <controls:AlbumCard Width="{Binding CardWidth, RelativeSource={RelativeSource AncestorType=controls:VirtualizedCardGrid}}" />
                            </DataTemplate>
                        </controls:VirtualizedCardGrid.ItemTemplate>
                    </controls:VirtualizedCardGrid>
                </Grid>
            </Grid>
        </Grid>

        <!-- 分页 -->
        <StackPanel x:Name="FavoritePaging" Grid.Row="2" Orientation="Horizontal"
                    HorizontalAlignment="Center" Visibility="Collapsed" Margin="0,14,0,0">
            <Border Background="{DynamicResource HoverBgBrush}" CornerRadius="999" Padding="4">
                <StackPanel Orientation="Horizontal">
                    <Button x:Name="FavPrevButton" Style="{StaticResource PaginationButtonStyle}"
                            ToolTip="上一页" Click="FavPrevButton_Click">
                        <Path Data="{StaticResource IconChevronLeft}" Stroke="{DynamicResource TextPrimaryBrush}" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Stretch="Uniform" Width="16" Height="16" />
                    </Button>
                    <Border Style="{StaticResource CountBadgeStyle}" Margin="4,0"
                            MinWidth="84">
                        <TextBlock x:Name="FavPageText" FontSize="12.5"
                                   Foreground="{DynamicResource PrimaryBrush}"
                                   HorizontalAlignment="Center" />
                    </Border>
                    <Button x:Name="FavNextButton" Style="{StaticResource PaginationButtonStyle}"
                            ToolTip="下一页" Click="FavNextButton_Click">
                        <Path Data="{StaticResource IconChevronRight}" Stroke="{DynamicResource TextPrimaryBrush}" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Stretch="Uniform" Width="16" Height="16" />
                    </Button>
                </StackPanel>
            </Border>
        </StackPanel>
    </Grid>
</controls:CardGridViewBase>


