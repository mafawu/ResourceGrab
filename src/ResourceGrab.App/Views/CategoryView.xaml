<?xml version="1.0" encoding="utf-8"?>
<controls:CardGridViewBase x:Class="ResourceGrab.App.Views.CategoryView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:views="clr-namespace:ResourceGrab.App.Views" xmlns:controls="clr-namespace:ResourceGrab.App.Controls">
  <FrameworkElement.Resources>
    <ResourceDictionary>
      <DataTemplate x:Key="TagEntryTemplate">
        <Button Style="{StaticResource ChipButtonStyle}" Content="{Binding Name}" Tag="{Binding}" Click="Entry_Click" />
      </DataTemplate>
      <DataTemplate x:Key="CategoryChildTemplate">
        <RadioButton GroupName="CategoryNav" Style="{StaticResource NavigationChipRadioStyle}" Content="{Binding Name}" Tag="{Binding}" Click="Entry_Click" />
      </DataTemplate>
      <DataTemplate x:Key="CategoryEntryTemplate">
        <StackPanel Margin="0,0,0,2">
          <RadioButton GroupName="CategoryNav" Style="{StaticResource NavigationChipRadioStyle}" Content="{Binding Name}" Tag="{Binding}" IsChecked="{Binding IsDefault}" Click="Entry_Click" />
          <ItemsControl Margin="0,6,0,0" ItemTemplate="{StaticResource CategoryChildTemplate}" ItemsSource="{Binding Children}">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <WrapPanel />
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
          </ItemsControl>
        </StackPanel>
      </DataTemplate>
      <views:ThemeEntryTemplateSelector x:Key="EntryTemplateSelector" CategoryTemplate="{StaticResource CategoryEntryTemplate}" TagTemplate="{StaticResource TagEntryTemplate}" />
      <DataTemplate x:Key="SectionTemplate">
        <StackPanel Margin="0,0,0,18">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Border Width="3" Height="13" CornerRadius="2" Background="{DynamicResource PrimaryBrush}" VerticalAlignment="Center" />
            <TextBlock Grid.Column="1" FontSize="12.5" FontWeight="SemiBold" Margin="8,0,0,0" VerticalAlignment="Center" Foreground="{DynamicResource TextPrimaryBrush}" Text="{Binding Title}" />
          </Grid>
          <Border Height="1" Background="{DynamicResource DividerBrush}" Opacity="0.7" Margin="0,8,0,10" />
          <ItemsControl ItemTemplateSelector="{StaticResource EntryTemplateSelector}" ItemsSource="{Binding Entries}">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <WrapPanel />
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
          </ItemsControl>
        </StackPanel>
      </DataTemplate>
    </ResourceDictionary>
  </FrameworkElement.Resources>
  <Grid Margin="20">
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="258" />
      <ColumnDefinition Width="*" />
    </Grid.ColumnDefinitions>
    <Border Grid.Column="0" Style="{StaticResource CardPanelStyle}" Padding="16" Margin="0,0,12,0">
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <StackPanel Orientation="Horizontal">
          <Path Data="{StaticResource IconCategory}" Stroke="{DynamicResource PrimaryBrush}" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Stretch="Uniform" Width="14" Height="14" Margin="0,0,8,0" VerticalAlignment="Center" />
          <TextBlock Text="主题分区" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center" />
          <TextBlock Text="点击分类或标签浏览" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="10,0,0,0" />
        </StackPanel>
        <ScrollViewer Grid.Row="1" Margin="0,12,0,0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
          <ItemsControl Name="SidebarPanel" ItemTemplate="{StaticResource SectionTemplate}" />
        </ScrollViewer>
      </Grid>
    </Border>
    <Grid Column="1" Margin="12,0,0,0">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>
      <Border Grid.Row="0" Style="{StaticResource CardPanelStyle}" Padding="16" Margin="0,0,0,12">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <Grid Margin="0,0,10,0">
          <TextBox Name="KeywordBox" Style="{StaticResource ModernTextBoxStyle}" Height="{StaticResource ToolbarHeight}" MinWidth="120" Padding="34,0,30,0" VerticalContentAlignment="Center" ToolTip="输入标签或关键词，与当前分类组合搜索" KeyDown="KeywordBox_KeyDown" GotFocus="KeywordBox_GotFocus" LostFocus="KeywordBox_LostFocus" TextChanged="KeywordBox_TextChanged" />
            <Path Data="{StaticResource IconSearch}" Stroke="{DynamicResource TextDisabledBrush}" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Stretch="Uniform" Width="14" Height="14" Margin="12,0,0,0" HorizontalAlignment="Left" VerticalAlignment="Center" />
            <TextBlock Name="KeywordPlaceholder" Text="输入标签或关键词，与当前分类组合搜索" FontSize="12.5" Foreground="{DynamicResource TextDisabledBrush}" IsHitTestVisible="False" Margin="34,0,0,0" VerticalAlignment="Center" HorizontalAlignment="Left" />
            <Button Name="ClearKeywordButton" Style="{StaticResource IconButtonStyle}" ToolTip="清除" HorizontalAlignment="Right" Margin="0,0,4,0" VerticalAlignment="Center" Padding="6" FontSize="12" Click="ClearKeywordButton_Click">
              <Path Data="{StaticResource IconClose}" Stroke="{DynamicResource TextPrimaryBrush}" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Stretch="Uniform" Width="16" Height="16" />
            </Button>
          </Grid>
          <ComboBox Name="SortBox" Grid.Column="1" Style="{StaticResource LibrarySortComboBoxStyle}" SelectionChanged="SortBox_SelectionChanged">
            <ComboBoxItem Content="最新发布" Tag="Latest" />
            <ComboBoxItem Content="最多观看" Tag="View" />
            <ComboBoxItem Content="图片最多" Tag="Picture" />
            <ComboBoxItem Content="最多点赞" Tag="Like" />
          </ComboBox>
          <ComboBox Name="PeriodBox" Grid.Column="2" Style="{StaticResource LibrarySortComboBoxStyle}" Margin="8,0,0,0" SelectionChanged="PeriodBox_SelectionChanged">
            <ComboBoxItem Content="全部时间" Tag="All" />
            <ComboBoxItem Content="今天" Tag="Today" />
            <ComboBoxItem Content="本周" Tag="Week" />
            <ComboBoxItem Content="本月" Tag="Month" />
          </ComboBox>
          <Button Grid.Column="3" Style="{StaticResource LibraryPrimaryButtonStyle}" Content="搜索" Click="SearchButton_Click" />
          <controls:CardSizeSlider Grid.Column="4" Margin="{StaticResource ToolbarItemSpacing}" VerticalAlignment="Center" Columns="{Binding Columns, RelativeSource={RelativeSource AncestorType=UserControl}}" />
        </Grid>
      </Border>
      <controls:StateHostControl Grid.Row="1"
                         State="{Binding CurrentState, RelativeSource={RelativeSource AncestorType=UserControl}}"
                         Result="{Binding Results, RelativeSource={RelativeSource AncestorType=UserControl}}"
                         ResultTemplate="{StaticResource ComicCardResultTemplate}"
                         SlotWidth="{Binding SlotWidth, RelativeSource={RelativeSource AncestorType=UserControl}}"
                         DesiredColumns="{Binding Columns, RelativeSource={RelativeSource AncestorType=UserControl}}"
                         CardWidth="{Binding CardWidth, RelativeSource={RelativeSource AncestorType=UserControl}}"
                         EmptyTitle="暂无漫画数据"
                         RetryText="重新加载"
                         RetryCommand="{Binding RetryCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" />
      <StackPanel Name="PagingPanel" Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center" Visibility="Collapsed" Margin="0,14,0,0">
          <Button Name="PrevButton" Style="{StaticResource GhostButtonStyle}" Content="‹ 上一页" Click="PrevButton_Click" Padding="12,5" />
          <TextBlock Name="PageText" FontSize="12" VerticalAlignment="Center"
                     Foreground="{DynamicResource TextSecondaryBrush}"
                     Margin="14,0" MinWidth="76" TextAlignment="Center" />
          <Button Name="NextButton" Style="{StaticResource GhostButtonStyle}"
                  Content="下一页 ›" Click="NextButton_Click" Padding="12,5" />
      </StackPanel>
    </Grid>
  </Grid>
</controls:CardGridViewBase>
