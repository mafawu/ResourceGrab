<UserControl x:Class="ResourceGrab.App.Views.ActorListView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:ResourceGrab.App.Controls">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 工具条：搜索 + 排序 + 每页数量 + 缓存恢复（窄窗口自动换行） -->
        <WrapPanel Grid.Row="0" Margin="4,10,4,0">
            <TextBox x:Name="SearchBox" Style="{StaticResource ModernTextBoxStyle}"
                     Width="220" Height="30" FontSize="12" VerticalContentAlignment="Center"
                     TextChanged="SearchBox_TextChanged"
                     ToolTip="按演员名过滤" />
            <ComboBox x:Name="SortBox" Width="104" Height="30" Margin="10,0,0,0" FontSize="12"
                      VerticalContentAlignment="Center" SelectionChanged="SortBox_SelectionChanged">
                <ComboBoxItem Content="按作品数" Tag="count" IsSelected="True" />
                <ComboBoxItem Content="按名称" Tag="name" />
            </ComboBox>
            <ComboBox x:Name="PageSizeBox" Width="100" Height="30" Margin="10,0,0,0" FontSize="12"
                      VerticalContentAlignment="Center" SelectionChanged="PageSizeBox_SelectionChanged">
                <ComboBoxItem Content="每页 40" Tag="40" IsSelected="True" />
                <ComboBoxItem Content="每页 80" Tag="80" />
                <ComboBoxItem Content="每页 160" Tag="160" />
            </ComboBox>
            <Button x:Name="RestoreCacheButton" Content="从刮削缓存恢复" Style="{StaticResource LibraryActionButtonStyle}"
                    Margin="16,0,0,0" Height="30" Click="RestoreCache_Click"
                    ToolTip="本地视频的标题/演员等刮削信息为空时，从本地刮削缓存（免联网）恢复" />
            <Button x:Name="FetchAvatarsButton" Content="拉取全部头像" Style="{StaticResource LibraryActionButtonStyle}"
                    Margin="10,0,0,0" Height="30" Click="FetchAvatars_Click"
                    ToolTip="遍历全部演员，从 GFriends 开源头像库下载本人照片（需要代理）；已下载的自动跳过" />
        </WrapPanel>

        <!-- 演员海报卡片网格：海报取该演员作品的封面，虚拟化渲染 -->
        <controls:VirtualizedCardGrid x:Name="ActorCards" Grid.Row="1" Margin="0,4,0,0"
                                      CardWidth="150" SlotWidth="164">
            <controls:VirtualizedCardGrid.ItemTemplate>
                <DataTemplate>
                    <controls:PosterCard CoverSource="{Binding Poster}"
                                         CoverFallback="{Binding Fallback}"
                                         Title="{Binding Name}"
                                         MetaRight="{Binding CountText}"
                                         Width="{Binding CardWidth, RelativeSource={RelativeSource AncestorType=controls:VirtualizedCardGrid}}"
                                         HorizontalAlignment="Center"
                                         Cursor="Hand"
                                         CardClick="ActorCard_Click" />
                </DataTemplate>
            </controls:VirtualizedCardGrid.ItemTemplate>
        </controls:VirtualizedCardGrid>

        <!-- 分页条 -->
        <Grid Grid.Row="2" Margin="4,4,4,10">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                <Button x:Name="PrevPageButton" Style="{StaticResource GhostButtonStyle}"
                        Content="‹ 上一页" Click="ChangePage_Click" Padding="12,5" />
                <TextBlock x:Name="PageText" FontSize="12" VerticalAlignment="Center"
                           Foreground="{DynamicResource TextSecondaryBrush}" Margin="14,0" MinWidth="76" TextAlignment="Center" />
                <Button x:Name="NextPageButton" Style="{StaticResource GhostButtonStyle}"
                        Content="下一页 ›" Click="ChangePage_Click" Padding="12,5" />
            </StackPanel>
        </Grid>

        <StackPanel x:Name="EmptyState" Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Center" Visibility="Collapsed">
            <Border Width="72" Height="72" CornerRadius="{DynamicResource RadiusXl}" Background="{DynamicResource HoverBgBrush}">
                <Path Data="{DynamicResource IconUser}" Stroke="{DynamicResource TextSecondaryBrush}" StrokeThickness="2" Stretch="Uniform" Width="26" Height="26" HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <TextBlock Text="还没有演员数据" FontSize="15" FontWeight="SemiBold" Margin="0,16,0,0" HorizontalAlignment="Center" />
            <TextBlock Text="扫描本地视频后这里会列出全部演员" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,6,0,0" HorizontalAlignment="Center" />
        </StackPanel>
    </Grid>
</UserControl>
