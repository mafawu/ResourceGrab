<UserControl x:Class="ResourceGrab.App.Views.LocalSearchPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{DynamicResource SurfaceBrush}">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- 标题栏 -->
        <Grid Grid.Row="0" Margin="18,16,18,12">
            <StackPanel Orientation="Horizontal">
                <Path Data="{StaticResource IconSearch}" Stroke="{DynamicResource PrimaryBrush}" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Stretch="Uniform" Width="14" Height="14" VerticalAlignment="Center" />
                <TextBlock Text="本地搜索" FontSize="15" FontWeight="Bold"
                           Margin="8,0,0,0" VerticalAlignment="Center" />
            </StackPanel>
        </Grid>

        <!-- 关键字输入框 -->
        <Border Grid.Row="1" Height="{StaticResource ToolbarHeight}" Margin="14,0,14,12"
                Style="{StaticResource SearchFieldBorderStyle}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Path Grid.Column="0" Data="{StaticResource IconSearch}" Stroke="{DynamicResource TextDisabledBrush}"
                      StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                      Stretch="Uniform" Width="16" Height="16" Margin="14,0,0,0"
                      VerticalAlignment="Center" IsHitTestVisible="False" />
                <TextBox x:Name="KeywordBox" Style="{StaticResource SearchInputTextStyle}"
                         Grid.Column="1" Margin="10,0,0,0" Padding="0"
                         TextChanged="KeywordBox_TextChanged"
                         GotFocus="KeywordBox_GotFocus" LostFocus="KeywordBox_LostFocus" />
                <TextBlock x:Name="PlaceholderText" Text="搜索漫画名 / 作者 / 标签"
                           Grid.Column="1" Margin="34,0,0,0" HorizontalAlignment="Left"
                           Style="{StaticResource SearchWatermarkTextStyle}" />
                <Button x:Name="ClearButton" Grid.Column="2"
                        Style="{StaticResource SidebarSearchClearButtonStyle}"
                        ToolTip="清除筛选" Click="ClearButton_Click"
                        Visibility="Collapsed">
                </Button>
            </Grid>
        </Border>

        <!-- 筛选区：标签 + 作者（仿 Green FilterSidebar） -->
        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                      Padding="14,0,14,14">
            <StackPanel>
                <!-- 标签筛选 -->
                <Grid Margin="0,0,0,6">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="标签筛选" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" />
                        <TextBlock x:Name="TagCountText" FontSize="10.5" Foreground="{DynamicResource TextDisabledBrush}" Margin="6,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                    <Button x:Name="ClearTagFilterButton" Style="{StaticResource GhostButtonStyle}" Content="清除" FontSize="10.5" Padding="6,2"
                            HorizontalAlignment="Right" VerticalAlignment="Center" Visibility="Collapsed" Click="ClearTagFilter_Click" />
                </Grid>
                <TextBlock x:Name="TagEmptyText" Text="暂无标签" FontSize="11" Foreground="{DynamicResource TextDisabledBrush}" Margin="0,2,0,8" Visibility="Collapsed" />
                <ItemsControl x:Name="TagItems">
                    <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                </ItemsControl>
                <Border Height="1" Background="{DynamicResource DividerBrush}" Margin="0,10,0,10" />
                <!-- 作者筛选 -->
                <Grid Margin="0,0,0,6">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="作者筛选" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" />
                        <TextBlock x:Name="AuthorCountText" FontSize="10.5" Foreground="{DynamicResource TextDisabledBrush}" Margin="6,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                    <Button x:Name="ClearAuthorFilterButton" Style="{StaticResource GhostButtonStyle}" Content="清除" FontSize="10.5" Padding="6,2"
                            HorizontalAlignment="Right" VerticalAlignment="Center" Visibility="Collapsed" Click="ClearAuthorFilter_Click" />
                </Grid>
                <TextBlock x:Name="AuthorEmptyText" Text="暂无作者" FontSize="11" Foreground="{DynamicResource TextDisabledBrush}" Margin="0,2,0,8" Visibility="Collapsed" />
                <ItemsControl x:Name="AuthorItems">
                    <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                </ItemsControl>
                <TextBlock Text="左键包含 · 右键排除" FontSize="10" Foreground="{DynamicResource TextDisabledBrush}" Margin="0,12,0,0" HorizontalAlignment="Center" Opacity="0.7" />
                <Border Height="1" Background="{DynamicResource DividerBrush}" Margin="0,10,0,10" />
                <!-- 评分筛选 -->
                <Grid Margin="0,0,0,6">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="评分筛选" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" />
                        <TextBlock x:Name="RatingCountText" FontSize="10.5" Foreground="{DynamicResource TextDisabledBrush}" Margin="6,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                    <Button x:Name="ClearRatingFilterButton" Style="{StaticResource GhostButtonStyle}" Content="清除" FontSize="10.5" Padding="6,2"
                            HorizontalAlignment="Right" VerticalAlignment="Center" Visibility="Collapsed" Click="ClearRatingFilter_Click" />
                </Grid>
                <TextBlock x:Name="RatingEmptyText" Text="暂无已评分漫画" FontSize="11" Foreground="{DynamicResource TextDisabledBrush}" Margin="0,2,0,8" Visibility="Collapsed" />
                <ItemsControl x:Name="RatingItems">
                    <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                </ItemsControl>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
