<controls:CardGridViewBase x:Class="ResourceGrab.App.Views.WeeklyView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:ResourceGrab.App.Controls">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- 页头：标题 + 计数 + 右侧刷新 -->
        <Grid Grid.Row="0" Margin="0,0,0,14">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="每周必看" FontSize="18" FontWeight="Bold"
                           VerticalAlignment="Center" />
                <Border Style="{StaticResource CountBadgeStyle}" Margin="10,0,0,0">
                    <TextBlock x:Name="WeeklyCount" FontSize="11"
                               Foreground="{DynamicResource PrimaryBrush}" />
                </Border>
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"
                        VerticalAlignment="Center">
                <controls:CardSizeSlider Columns="{Binding Columns, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                         VerticalAlignment="Center" />
                <Button Style="{StaticResource LibraryActionButtonStyle}" Content="刷新"
                        Click="RefreshButton_Click" />
            </StackPanel>
        </Grid>

        <!-- 筛选区：分类下拉 + 类型分段 -->
        <Border Grid.Row="1" Style="{StaticResource CardPanelStyle}" Padding="16"
                Margin="0,0,0,14">
            <StackPanel Orientation="Horizontal">
                <ComboBox x:Name="CategoryBox" Style="{StaticResource LibrarySortComboBoxStyle}"
                          SelectionChanged="CategoryBox_SelectionChanged" />
                <Border Background="{DynamicResource HoverBgBrush}" CornerRadius="{DynamicResource RadiusMd}"
                        Padding="3" Margin="8,0,0,0" VerticalAlignment="Center">
                    <StackPanel x:Name="TypePanel" Orientation="Horizontal" />
                </Border>
            </StackPanel>
        </Border>

        <!-- 内容区 -->
        <Grid Grid.Row="2">
            <StackPanel x:Name="LoadingPanel" VerticalAlignment="Center" HorizontalAlignment="Center"
                        Visibility="Collapsed">
                <Border Width="72" Height="72" CornerRadius="{DynamicResource RadiusXl}"
                        Background="{DynamicResource HoverBgBrush}">
                    <Path Data="{StaticResource IconLoading}" Stroke="{DynamicResource TextSecondaryBrush}" StrokeThickness="2.2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Stretch="Uniform" Width="26" Height="26" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <TextBlock Text="加载中…" FontSize="15" FontWeight="SemiBold"
                           Margin="0,16,0,0" HorizontalAlignment="Center" />
                <TextBlock Text="正在获取每周必看内容，稍候片刻" FontSize="12"
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           Margin="0,6,0,0" HorizontalAlignment="Center" />
            </StackPanel>

            <StackPanel x:Name="EmptyPanel" VerticalAlignment="Center" HorizontalAlignment="Center"
                        Visibility="Collapsed">
                <Border Width="72" Height="72" CornerRadius="{DynamicResource RadiusXl}"
                        Background="{DynamicResource HoverBgBrush}">
                    <Path Data="{StaticResource IconWeekly}" Stroke="{DynamicResource TextDisabledBrush}" StrokeThickness="2.2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Stretch="Uniform" Width="26" Height="26" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <TextBlock Text="本周暂无必看内容" FontSize="15" FontWeight="SemiBold"
                           Margin="0,16,0,0" HorizontalAlignment="Center" />
                <TextBlock Text="换个分类或类型再试试吧" FontSize="12"
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           Margin="0,6,0,0" HorizontalAlignment="Center" />
                <Button Style="{StaticResource PillGhostButtonStyle}" Content="重新加载"
                        Margin="0,18,0,0" HorizontalAlignment="Center"
                        Click="RefreshButton_Click" />
            </StackPanel>

            <Grid x:Name="ResultScroller" Visibility="Collapsed">
                <controls:VirtualizedCardGrid x:Name="WeeklyItems"
                                              SlotWidth="{Binding SlotWidth, RelativeSource={RelativeSource AncestorType=UserControl}}" DesiredColumns="{Binding Columns, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                              CardWidth="{Binding CardWidth, RelativeSource={RelativeSource AncestorType=UserControl}}">
                    <controls:VirtualizedCardGrid.ItemTemplate>
                        <DataTemplate>
                            <controls:AlbumCard Width="{Binding CardWidth, RelativeSource={RelativeSource AncestorType=controls:VirtualizedCardGrid}}" />
                        </DataTemplate>
                    </controls:VirtualizedCardGrid.ItemTemplate>
                </controls:VirtualizedCardGrid>
            </Grid>
        </Grid>
    </Grid>
</controls:CardGridViewBase>



