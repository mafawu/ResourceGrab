<controls:CardGridViewBase x:Class="ResourceGrab.App.Views.CategoryBrowseView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:ResourceGrab.App.Controls">

    <Grid Margin="20">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="240" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- 左侧：分类列表 -->
        <Border Grid.Column="0" Style="{StaticResource CardPanelStyle}" Padding="16" Margin="0,0,12,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <StackPanel Orientation="Horizontal">
                    <Path Data="{StaticResource IconCategory}" Stroke="{DynamicResource PrimaryBrush}" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Stretch="Uniform" Width="14" Height="14" Margin="0,0,8,0" VerticalAlignment="Center" />
                    <TextBlock x:Name="CategoryTitle" Text="分类" FontSize="14" FontWeight="SemiBold"
                               VerticalAlignment="Center" />
                </StackPanel>
                <ScrollViewer Grid.Row="1" Margin="0,12,0,0" VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <StackPanel x:Name="CategoryList" />
                </ScrollViewer>
            </Grid>
        </Border>

        <!-- 右侧：页头 + 漫画网格 + 分页 -->
        <Grid Grid.Column="1" Margin="12,0,0,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- 页头：标题 + 分格 -->
            <Grid Grid.Row="0" Margin="0,0,0,12">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Path Data="{StaticResource IconCategory}" Stroke="{DynamicResource PrimaryBrush}" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Stretch="Uniform" Width="14" Height="14" Margin="0,0,8,0" VerticalAlignment="Center" />
                    <TextBlock Text="分类浏览" FontSize="15" FontWeight="SemiBold"
                               VerticalAlignment="Center" />
                </StackPanel>
                <controls:CardSizeSlider Columns="{Binding Columns, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                         HorizontalAlignment="Right" VerticalAlignment="Center" />
            </Grid>

            <controls:StateHostControl Grid.Row="1"
                               State="{Binding CurrentState, RelativeSource={RelativeSource AncestorType=UserControl}}"
                               Result="{Binding Results, RelativeSource={RelativeSource AncestorType=UserControl}}"
                               ResultTemplate="{StaticResource ComicCardResultTemplate}"
                               SlotWidth="{Binding SlotWidth, RelativeSource={RelativeSource AncestorType=UserControl}}"
                               DesiredColumns="{Binding Columns, RelativeSource={RelativeSource AncestorType=UserControl}}"
                               CardWidth="{Binding CardWidth, RelativeSource={RelativeSource AncestorType=UserControl}}"
                               EmptyTitle="暂无漫画数据"
                               RetryText="重新加载"
                               RetryCommand="{Binding RetryCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" />

            <StackPanel x:Name="PagingPanel" Grid.Row="2" Orientation="Horizontal"
                        HorizontalAlignment="Center" Visibility="Collapsed" Margin="0,14,0,0">
                <Button x:Name="PrevButton" Style="{StaticResource GhostButtonStyle}" Content="‹ 上一页" Click="PrevButton_Click" Padding="12,5" />
                <TextBlock Name="PageText" FontSize="12" VerticalAlignment="Center"
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           Margin="14,0" MinWidth="76" TextAlignment="Center" />
                <Button Name="NextButton" Style="{StaticResource GhostButtonStyle}"
                        Content="下一页 ›" Click="NextButton_Click" Padding="12,5" />
            </StackPanel>
        </Grid>
    </Grid>
</controls:CardGridViewBase>

