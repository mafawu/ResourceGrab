<UserControl x:Class="ResourceGrab.App.Views.PhotobookBrowseView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Margin="20">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="240" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- 左侧：维度条目列表。条目数可达数百（标签 507 / 出演 2166），
             故带关键词过滤与渲染上限，避免一次性生成上千个按钮。 -->
        <Border Grid.Column="0" Style="{StaticResource CardPanelStyle}" Padding="16" Margin="0,0,12,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel Orientation="Horizontal">
                    <Path x:Name="DimensionIcon"
                          Stroke="{DynamicResource PhotobookAccentBrush}"
                          StrokeThickness="1.8"
                          StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                          Stretch="Uniform" Width="14" Height="14" Margin="0,0,8,0"
                          VerticalAlignment="Center" />
                    <TextBlock x:Name="DimensionTitle" Text="写真" FontSize="14" FontWeight="SemiBold"
                               VerticalAlignment="Center" />
                </StackPanel>

                <TextBox x:Name="FilterBox" Grid.Row="1"
                         Margin="0,10,0,0"
                         Visibility="Collapsed"
                         TextChanged="FilterBox_TextChanged"
                         FontSize="12" Padding="6,4"
                         ToolTip="输入关键词过滤左侧条目" />

                <ScrollViewer Grid.Row="2" Margin="0,10,0,0"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <StackPanel x:Name="ItemList" />
                </ScrollViewer>

                <TextBlock x:Name="ItemCountText" Grid.Row="3"
                           Margin="0,8,0,0"
                           FontSize="11" TextWrapping="Wrap"
                           Foreground="{DynamicResource TextSecondaryBrush}" />
            </Grid>
        </Border>

        <!-- 右侧：该条目下的图集卡片 + 分页 -->
        <Border Grid.Column="1" Style="{StaticResource CardPanelStyle}" Padding="16" Margin="12,0,0,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock x:Name="ResultHeader" Text="请选择左侧条目"
                           FontSize="14" FontWeight="SemiBold"
                           TextTrimming="CharacterEllipsis" />

                <ScrollViewer Grid.Row="1" Margin="0,12,0,0"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <Grid>
                        <WrapPanel x:Name="AlbumList" />
                        <TextBlock x:Name="HintText"
                                   Text="正在加载…"
                                   FontSize="13"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   TextWrapping="Wrap"
                                   MaxWidth="460"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Grid>
                </ScrollViewer>

                <StackPanel x:Name="Pager" Grid.Row="2"
                            Orientation="Horizontal"
                            HorizontalAlignment="Right"
                            Margin="0,12,0,0"
                            Visibility="Collapsed">
                    <Button x:Name="PrevButton" Content="上一页" Click="PrevButton_Click"
                            Style="{StaticResource GhostButtonStyle}" Padding="12,5" />
                    <TextBlock x:Name="PageText" VerticalAlignment="Center" Margin="12,0"
                               FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" />
                    <Button x:Name="NextButton" Content="下一页" Click="NextButton_Click"
                            Style="{StaticResource GhostButtonStyle}" Padding="12,5" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
