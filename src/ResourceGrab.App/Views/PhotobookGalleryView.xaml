<UserControl x:Class="ResourceGrab.App.Views.PhotobookGalleryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 顶栏：标题 + 搜索（写真）/ 换一批（随机） -->
        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Path x:Name="HeaderIcon"
                      Stroke="{DynamicResource PhotobookAccentBrush}"
                      StrokeThickness="1.8"
                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                      Stretch="Uniform" Width="16" Height="16" Margin="0,0,8,0"
                      VerticalAlignment="Center" />
                <TextBlock x:Name="HeaderText" Text="写真" FontSize="15" FontWeight="SemiBold"
                           VerticalAlignment="Center" />
            </StackPanel>

            <StackPanel x:Name="SearchPanel" Grid.Column="1" Orientation="Horizontal">
                <TextBox x:Name="SearchBox"
                         Width="240" FontSize="12" Padding="8,5"
                         VerticalContentAlignment="Center"
                         KeyDown="SearchBox_KeyDown"
                         ToolTip="按关键词在图集标题中搜索" />
                <Button x:Name="SearchButton" Content="搜索" Click="SearchButton_Click"
                        Style="{StaticResource GhostButtonStyle}" Padding="14,5" Margin="8,0,0,0" />
                <Button x:Name="ClearButton" Content="全部" Click="ClearButton_Click"
                        Style="{StaticResource GhostButtonStyle}" Padding="14,5" Margin="6,0,0,0"
                        ToolTip="清空关键词，回到全站列表" />
            </StackPanel>

            <Button x:Name="RerollButton" Grid.Column="1" Content="换一批" Click="RerollButton_Click"
                    Style="{StaticResource GhostButtonStyle}" Padding="14,5" Visibility="Collapsed"
                    ToolTip="重新随机抽取" />
        </Grid>

        <!-- 图集卡片网格 -->
        <Border Grid.Row="1" Style="{StaticResource CardPanelStyle}" Padding="16" Margin="0,12,0,0">
            <Grid>
                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <Grid>
                        <WrapPanel x:Name="AlbumList" />
                        <TextBlock x:Name="HintText"
                                   Text="正在加载…"
                                   FontSize="13"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   TextWrapping="Wrap"
                                   MaxWidth="460"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Grid>
                </ScrollViewer>
            </Grid>
        </Border>

        <!-- 分页（随机模式隐藏） -->
        <StackPanel x:Name="Pager" Grid.Row="2"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,12,0,0"
                    Visibility="Collapsed">
            <TextBlock x:Name="ResultCountText" VerticalAlignment="Center" Margin="0,0,12,0"
                       FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" />
            <Button x:Name="PrevButton" Content="上一页" Click="PrevButton_Click"
                    Style="{StaticResource GhostButtonStyle}" Padding="12,5" />
            <TextBlock x:Name="PageText" VerticalAlignment="Center" Margin="12,0"
                       FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" />
            <Button x:Name="NextButton" Content="下一页" Click="NextButton_Click"
                    Style="{StaticResource GhostButtonStyle}" Padding="12,5" />
        </StackPanel>
    </Grid>
</UserControl>
