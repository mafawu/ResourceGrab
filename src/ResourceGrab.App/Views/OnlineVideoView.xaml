<UserControl x:Class="ResourceGrab.App.Views.OnlineVideoView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:ResourceGrab.App.Controls"
             Background="{DynamicResource SurfaceBrush}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- 内容区域 -->
        <Grid Grid.Row="0">
            <!-- 结果列表 -->
            <ScrollViewer x:Name="ResultsScroll" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
                <StackPanel>
                    <WrapPanel x:Name="ResultCardsPanel" />
                    <StackPanel x:Name="OnlinePagingHost" Orientation="Horizontal" HorizontalAlignment="Center"
                                Margin="0,10,0,4" Visibility="Collapsed">
                        <Button x:Name="PrevPageBtn" Style="{StaticResource LibraryActionButtonStyle}"
                                Content="上一页" Margin="{StaticResource ToolbarItemSpacing}" Click="PrevPage_Click" />
                        <TextBlock x:Name="PageInfoText" FontSize="12" VerticalAlignment="Center" />
                        <Button x:Name="NextPageBtn" Style="{StaticResource LibraryActionButtonStyle}"
                                Content="下一页" Margin="{StaticResource ToolbarItemSpacing}" Click="NextPage_Click" />
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>

            <!-- 空状态 -->
            <StackPanel x:Name="EmptyState" VerticalAlignment="Center" HorizontalAlignment="Center">
                <Border Width="72" Height="72" CornerRadius="{DynamicResource RadiusXl}" Background="{DynamicResource HoverBgBrush}">
                    <Path Data="{StaticResource IconSearch}" Stroke="{DynamicResource TextSecondaryBrush}"
                          StrokeThickness="1.8" Stretch="Uniform" Width="28" Height="28"
                          HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <TextBlock x:Name="EmptyHintText" Text="输入关键词开始在线搜索"
                           FontSize="14" Foreground="{DynamicResource TextSecondaryBrush}"
                           HorizontalAlignment="Center" Margin="0,16,0,0" />
                <TextBlock Text="在线源正在开发中，敬请期待"
                           FontSize="11" Foreground="{DynamicResource TextDisabledBrush}"
                           HorizontalAlignment="Center" Margin="0,6,0,0" />
            </StackPanel>

            <!-- 加载中 -->
            <StackPanel x:Name="LoadingState" Visibility="Collapsed"
                        VerticalAlignment="Center" HorizontalAlignment="Center">
                <ProgressBar Width="180" Height="4" IsIndeterminate="True" />
                <TextBlock x:Name="LoadingText" Text="搜索中…" FontSize="13" Foreground="{DynamicResource TextSecondaryBrush}"
                           HorizontalAlignment="Center" Margin="0,12,0,0" />
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>

