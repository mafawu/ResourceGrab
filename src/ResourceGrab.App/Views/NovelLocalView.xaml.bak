<controls:CardGridViewBase x:Class="ResourceGrab.App.Views.NovelLocalView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:ResourceGrab.App.Controls">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid Grid.Row="0" Margin="0,0,0,14">
            <StackPanel Orientation="Horizontal">
                <Border Background="#7C6CF6" CornerRadius="6" Padding="8,4" VerticalAlignment="Center">
                    <TextBlock Text="小" FontSize="11" Foreground="White" FontWeight="Bold"/>
                </Border>
                <TextBlock Text="本地小说" FontSize="18" FontWeight="Bold" Margin="10,0,0,0" VerticalAlignment="Center"/>
                <Border Style="{StaticResource CountBadgeStyle}" Margin="10,0,0,0">
                    <TextBlock x:Name="NovelCount" FontSize="11" Foreground="{DynamicResource PrimaryBrush}"/>
                </Border>
                <TextBlock x:Name="RootPathText" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="12,0,0,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="220"/>
                <TextBlock x:Name="DebugText" FontSize="10" Foreground="OrangeRed" Margin="12,0,0,0" VerticalAlignment="Center" ToolTip="调试：实际列宽计算"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                <TextBlock Text="排序" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                <ComboBox x:Name="SortBox" Style="{StaticResource SortPillComboBoxStyle}" Width="140" VerticalAlignment="Center" SelectedIndex="0" SelectionChanged="SortBox_SelectionChanged">
                    <ComboBoxItem Content="名称 A → Z" Tag="NameAsc"/>
                    <ComboBoxItem Content="大小 ↓" Tag="SizeDesc"/>
                    <ComboBoxItem Content="大小 ↑" Tag="SizeAsc"/>
                </ComboBox>
                <controls:CardSizeSlider Columns="{Binding Columns, RelativeSource={RelativeSource AncestorType=controls:CardGridViewBase}, Mode=TwoWay}" VerticalAlignment="Center"/>
                <Button Style="{StaticResource GhostButtonStyle}" Content="重新加载索引" Margin="8,0,0,0" Click="ReloadButton_Click"/>
                
            </StackPanel>
        </Grid>
        <Grid Grid.Row="1">
            <StackPanel x:Name="LoadingPanel" VerticalAlignment="Center" HorizontalAlignment="Center">
                <TextBlock Text="加载小说索引中…" FontSize="14" Foreground="{DynamicResource TextSecondaryBrush}" HorizontalAlignment="Center"/>
                <TextBlock x:Name="LoadingDetail" FontSize="12" Foreground="{DynamicResource TextDisabledBrush}" Margin="0,6,0,0" HorizontalAlignment="Center"/>
            </StackPanel>
            <StackPanel x:Name="EmptyPanel" VerticalAlignment="Center" HorizontalAlignment="Center" Visibility="Collapsed">
                <TextBlock Text="未找到小说" FontSize="15" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                <TextBlock x:Name="EmptyDetail" Text="请检查 E:\备份\小说\小说标签索引.json 是否存在" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,6,0,0" HorizontalAlignment="Center"/>
                <Button Style="{StaticResource PrimaryButtonStyle}" Content="选择索引文件" Margin="0,14,0,0" HorizontalAlignment="Center" Click="PickFileButton_Click"/>
            </StackPanel>
            <ScrollViewer x:Name="GridScroll" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
                <ItemsControl x:Name="NovelItems">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="10" Margin="0,0,14,14" Width="{Binding CardWidth, RelativeSource={RelativeSource AncestorType=controls:CardGridViewBase}}" Cursor="Hand" MouseLeftButtonUp="Card_MouseLeftButtonUp">
                                <StackPanel>
                                    <Border Height="92" CornerRadius="10,10,0,0" Background="{DynamicResource HoverBgBrush}" ClipToBounds="True">
                                        <Grid>
                                            <TextBlock Text="{Binding Initial}" FontSize="28" FontWeight="Bold" Foreground="{DynamicResource PrimaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0.85"/>
                                            <Border Background="#7C6CF6" CornerRadius="6" Padding="6,2" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="8,8,0,0"><TextBlock Text="小" FontSize="10" Foreground="White" FontWeight="Bold"/></Border>
                                            <Border Background="#33000000" CornerRadius="6" Padding="6,2" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,8,8,0"><TextBlock Text="{Binding SizeText}" FontSize="10" Foreground="White"/></Border>
                                        </Grid>
                                    </Border>
                                    <StackPanel Margin="10,8,10,10">
                                        <TextBlock Text="{Binding DisplayName}" FontSize="12.5" FontWeight="SemiBold" TextWrapping="Wrap" MaxHeight="56" TextTrimming="CharacterEllipsis" ToolTip="{Binding DisplayName}"/>
                                        <TextBlock Text="{Binding PrimaryTag}" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,4,0,0" TextTrimming="CharacterEllipsis"/>
                                        <Grid Margin="0,8,0,0" Visibility="{Binding ProgressVisibility}">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                            <Border Grid.Column="0" Height="4" CornerRadius="2" Background="{DynamicResource DividerBrush}" VerticalAlignment="Center">
                                                <Border CornerRadius="2" Background="#7C6CF6" HorizontalAlignment="Left" Width="{Binding ProgressWidth}"/>
                                            </Border>
                                            <TextBlock Grid.Column="1" Text="{Binding ProgressText}" FontSize="10" Foreground="#7C6CF6" Margin="6,0,0,0" VerticalAlignment="Center"/>
                                        </Grid>
                                        <ItemsControl ItemsSource="{Binding DisplayTags}" Margin="0,6,0,0">
                                            <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate><DataTemplate><Border Background="{DynamicResource HoverBgBrush}" CornerRadius="6" Padding="6,2" Margin="0,0,4,4"><TextBlock Text="{Binding}" FontSize="10" Foreground="{DynamicResource TextSecondaryBrush}"/></Border></DataTemplate></ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Grid>
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,12,0,0" x:Name="PagingPanel" Visibility="Collapsed">
            <Button Style="{StaticResource GhostButtonStyle}" Content="上一页" Click="PrevPage_Click" x:Name="PrevPageBtn"/>
            <TextBlock x:Name="PageInfo" Text="1 / 1" Margin="12,0" VerticalAlignment="Center" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}"/>
            <Button Style="{StaticResource GhostButtonStyle}" Content="下一页" Click="NextPage_Click" x:Name="NextPageBtn"/>
        </StackPanel>
    </Grid>
</controls:CardGridViewBase>