<UserControl x:Class="ResourceGrab.App.Views.VideoRecommendView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:ResourceGrab.App.Controls"
             Background="{DynamicResource SurfaceBrush}">
    <ScrollViewer x:Name="RootScroll" VerticalScrollBarVisibility="Auto" Padding="20,20,20,20">
        <StackPanel>
            <TextBlock Text="推荐" FontSize="20" FontWeight="Bold" Margin="0,0,0,4" />
            <TextBlock Text="基于本地视频库自动整理" FontSize="12"
                       Foreground="{DynamicResource TextDisabledBrush}" Margin="0,0,0,18" />

            <!-- 分组由代码构建：竖向整页滚动，卡片自适应换行，无嵌套横向滚动 -->
            <StackPanel x:Name="SectionsHost" />

            <!-- 空状态 -->
            <StackPanel x:Name="EmptyState" VerticalAlignment="Center" HorizontalAlignment="Center"
                        Margin="0,40,0,0" Visibility="Collapsed">
                <Border Width="64" Height="64" CornerRadius="{DynamicResource RadiusXl}"
                        Background="{DynamicResource HoverBgBrush}">
                    <Path Data="{StaticResource IconLibrary}" Stroke="{DynamicResource TextDisabledBrush}"
                          StrokeThickness="2" Stretch="Uniform" Width="24" Height="24"
                          HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <TextBlock Text="本地库暂无视频" FontSize="14" Foreground="{DynamicResource TextSecondaryBrush}"
                           HorizontalAlignment="Center" Margin="0,14,0,0" />
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>
