<UserControl x:Class="ResourceGrab.App.Views.VideoRecommendView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:ResourceGrab.App.Controls"
             Background="{DynamicResource SurfaceBrush}">
    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="20,20,20,20">
        <StackPanel>
            <TextBlock Text="推荐" FontSize="18" FontWeight="Bold" Margin="0,0,0,16" />

            <!-- 最近添加 -->
            <TextBlock Text="最近添加" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,8" />
            <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" Margin="0,0,0,20">
                <StackPanel x:Name="RecentPanel" Orientation="Horizontal" />
            </ScrollViewer>

            <!-- 高评分 -->
            <TextBlock Text="高评分" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,8" />
            <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" Margin="0,0,0,20">
                <StackPanel x:Name="TopRatedPanel" Orientation="Horizontal" />
            </ScrollViewer>

            <!-- 热门系列 -->
            <TextBlock Text="热门系列" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,8" />
            <StackPanel x:Name="SeriesPanel" />

            <!-- 空状态 -->
            <StackPanel x:Name="EmptyState" VerticalAlignment="Center" HorizontalAlignment="Center"
                        Margin="0,40,0,0" Visibility="Collapsed">
                <Border Width="64" Height="64" CornerRadius="{DynamicResource RadiusXl}"
                        Background="{DynamicResource HoverBgBrush}">
                    <Path Data="{StaticResource IconLibrary}" Stroke="{DynamicResource TextDisabledBrush}"
                          StrokeThickness="2" Stretch="Uniform" Width="24" Height="24"
                          HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <TextBlock Text="本地库暂无视频" FontSize="14" Foreground="{DynamicResource TextSecondaryBrush}"
                           HorizontalAlignment="Center" Margin="0,14,0,0" />
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>
