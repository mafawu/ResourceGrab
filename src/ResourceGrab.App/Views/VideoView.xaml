<controls:CardGridViewBase x:Class="ResourceGrab.App.Views.VideoView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:ResourceGrab.App.Controls"
             xmlns:views="clr-namespace:ResourceGrab.App.Views"
>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 主布局：左侧导航栏 + 右侧内容 -->
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- 左侧导航栏：与漫画主窗口同款（阴影 + Margin 14,14,0,14 + Width 196）-->
            <Grid Width="196" Margin="14,14,0,14" Visibility="Collapsed">
                <Border Background="{DynamicResource SurfaceBrush}"
                        BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1"
                        CornerRadius="{DynamicResource RadiusXl}"
                        Effect="{StaticResource CardShadowEffect}" />
                <Border CornerRadius="{DynamicResource RadiusXl}" Padding="10,12">
                    <StackPanel>
                    <TextBlock Text="视频" FontSize="10.5" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextDisabledBrush}" Margin="12,4,0,6" />
                    <RadioButton x:Name="NavSearch" GroupName="VideoNavGroup"
                                 Style="{StaticResource NavItemStyle}" IsChecked="True"
                                 Click="NavSearch_Click">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Border Width="28" Height="28" CornerRadius="9" Margin="-2,0,0,0" Background="Transparent"
                                    BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" VerticalAlignment="Center">
                                <Path Data="{StaticResource IconSearch}"
                                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"
                                      StrokeThickness="1.55" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                      Stretch="Uniform" Width="15" Height="15" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <TextBlock Text="搜索" Margin="10,0,0,0" FontWeight="SemiBold" VerticalAlignment="Center" />
                        </StackPanel>
                    </RadioButton>
                    <RadioButton x:Name="NavRecommend" GroupName="VideoNavGroup"
                                 Style="{StaticResource NavItemStyle}"
                                 Click="NavRecommend_Click">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Border Width="28" Height="28" CornerRadius="9" Margin="-2,0,0,0" Background="Transparent"
                                    BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" VerticalAlignment="Center">
                                <Path Data="{StaticResource IconLibrary}"
                                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"
                                      StrokeThickness="1.55" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                      Stretch="Uniform" Width="15" Height="15" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <TextBlock Text="推荐" Margin="10,0,0,0" FontWeight="SemiBold" VerticalAlignment="Center" />
                        </StackPanel>
                    </RadioButton>
                    <RadioButton x:Name="NavLocal" GroupName="VideoNavGroup"
                                 Style="{StaticResource NavItemStyle}"
                                 Click="NavLocal_Click">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Border Width="28" Height="28" CornerRadius="9" Margin="-2,0,0,0" Background="Transparent"
                                    BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" VerticalAlignment="Center">
                                <Path Data="{StaticResource IconFolderOpen}"
                                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"
                                      StrokeThickness="1.55" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                      Stretch="Uniform" Width="15" Height="15" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <TextBlock Text="本地" Margin="10,0,0,0" FontWeight="SemiBold" VerticalAlignment="Center" />
                        </StackPanel>
                    </RadioButton>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- 右侧内容区 -->
            <Grid Grid.Column="1" Margin="20">
                <!-- 搜索页 -->
                <Grid x:Name="SearchPage" Visibility="Visible">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- 顶部：统一工具栏（搜索框 + 源筛选 + 卡片尺寸；进入完整详情页时隐藏，整页被替换） -->
                    <StackPanel Grid.Row="0">
                        <controls:BrowserToolbar x:Name="OnlineToolbar"
                                                 Watermark="输入番号 / 标题 / 演员；#标签名 按标签搜索"
                                                 SearchSubmitted="OnlineSearch_Submitted"
                                                 SearchButtonClick="SearchButton_Click"
                                                 SizeSliderColumns="{Binding Columns, RelativeSource={RelativeSource AncestorType=views:VideoView}}"
                                                 Margin="0,0,0,14" />
                        <!-- 榜单切换（在线推荐模式）：今日/本周/本月热门 + 新作上市；搜索模式下隐藏 -->
                        <WrapPanel x:Name="OnlineListingBar" Visibility="Collapsed" Margin="0,0,0,12" />
                    </StackPanel>

                    <!-- 结果区域：虚拟化卡片网格（按需实例化海报卡） + 悬浮详情抽屉（覆盖层，不挤压卡片布局；进入完整详情页时整页被替换） -->
                    <Grid x:Name="OnlineResultsArea" Grid.Row="1">
                        <controls:VirtualizedCardGrid x:Name="OnlineCards" Visibility="Collapsed"
                                                      MinCardWidth="200" Spacing="10"
                                                      CardWidth="200" SlotWidth="210" DesiredColumns="5">
                            <controls:VirtualizedCardGrid.ItemTemplate>
                                <DataTemplate>
                                    <ContentPresenter Content="{Binding Card}" />
                                </DataTemplate>
                            </controls:VirtualizedCardGrid.ItemTemplate>
                        </controls:VirtualizedCardGrid>
                        <StackPanel x:Name="OnlineEmptyState" VerticalAlignment="Center" HorizontalAlignment="Center">
                            <Border Width="72" Height="72" CornerRadius="{DynamicResource RadiusXl}" Background="{DynamicResource HoverBgBrush}">
                                <Path Data="{StaticResource IconSearch}" Stroke="{DynamicResource TextSecondaryBrush}"
                                      StrokeThickness="1.8" Stretch="Uniform" Width="28" Height="28" />
                            </Border>
                            <TextBlock x:Name="OnlineEmptyHint" Text="输入关键词开始在线搜索"
                                       FontSize="14" Foreground="{DynamicResource TextSecondaryBrush}"
                                       HorizontalAlignment="Center" Margin="0,16,0,0" />
                        </StackPanel>
                        <StackPanel x:Name="OnlineLoadingState" Visibility="Collapsed"
                                    VerticalAlignment="Center" HorizontalAlignment="Center">
                            <ProgressBar Width="180" Height="4" IsIndeterminate="True" />
                            <TextBlock x:Name="OnlineLoadingText" Text="搜索中…" FontSize="13"
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       HorizontalAlignment="Center" Margin="0,12,0,0" />
                        </StackPanel>

                        <!-- 悬浮抽屉遮罩：覆盖结果区，点击关闭详情 -->
                        <Border x:Name="OnlineDetailMask" Panel.ZIndex="9" Background="#66000000"
                                Visibility="Collapsed" MouseLeftButtonUp="OnlineDetailMask_Click" />

                        <!-- 悬浮详情抽屉：覆盖在结果区上（不参与卡片布局），Surface 卡片 + 圆角 + 阴影 -->
                        <Border x:Name="OnlineDetailDrawer" Panel.ZIndex="10" HorizontalAlignment="Right" Width="620"
                                Margin="0,0,14,0" Visibility="Collapsed"
                                Background="{DynamicResource SurfaceBrush}"
                                BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1"
                                CornerRadius="{DynamicResource RadiusXl}" Effect="{StaticResource CardShadowEffect}">
                            <ScrollViewer x:Name="OnlineDetailPanel" VerticalScrollBarVisibility="Auto"
                                          HorizontalScrollBarVisibility="Disabled">
                            <!-- 布局：顶部 16:9 大播放器（封面/在线预览）→ 番号+评分+标题 → Tab 信息区 -->
                            <StackPanel>
                                <!-- 标题栏：强调条 + 标题 + 放大播放 + 关闭 -->
                                <Grid Margin="0,0,0,12">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <Border Width="4" Height="15" CornerRadius="2"
                                                Background="{DynamicResource PrimaryBrush}" VerticalAlignment="Center" />
                                        <TextBlock Text="在线详情" FontSize="15" FontWeight="Bold"
                                                   Margin="8,0,0,0" VerticalAlignment="Center" />
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                        <Button x:Name="OnlineDetailFullButton" Style="{StaticResource LibraryActionButtonStyle}"
                                                Content="完整详情 →" Click="OnlineDetailFull_Click"
                                                ToolTip="打开完整详情页" Margin="0,0,6,0" Visibility="Collapsed" />
                                        <Button x:Name="OnlineDetailPopoutButton" Style="{StaticResource IconButtonStyle}"
                                                Content="⛶" Click="OnlineDetailPopout_Click"
                                                ToolTip="放大播放（独立窗口）" Margin="0,0,6,0" Visibility="Collapsed" />
                                        <Button x:Name="OnlineDetailCloseButton" Style="{StaticResource IconButtonStyle}"
                                                Content="✕" Click="OnlineDetailClose_Click"
                                                ToolTip="关闭详情" />
                                    </StackPanel>
                                </Grid>

                                <!-- 封面 + 在线播放（详情有流地址时显示播放器，复用同一槽位；16:9 大屏便于预览） -->
                                <Border CornerRadius="{DynamicResource RadiusLg}" Height="349"
                                        Background="{DynamicResource HoverBgBrush}"
                                        BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1">
                                    <Grid x:Name="OnlinePlayerSlot" ClipToBounds="True">
                                        <Image x:Name="OnlineDetailPoster" Stretch="Uniform" Margin="6" />
                                        <controls:OnlineVideoPreviewPlayer x:Name="OnlinePreviewPlayer"
                                                                           Visibility="Collapsed" Margin="1" />
                                    </Grid>
                                </Border>

                                <!-- 预览图（剧照）：紧跟播放器，打开详情即见；横向滚动，点击在浏览器看原图；无预览图时整段隐藏 -->
                                <StackPanel x:Name="OnlinePreviewImagesSection" Visibility="Collapsed">
                                    <StackPanel Orientation="Horizontal" Margin="0,14,0,6">
                                        <Border Width="3" Height="11" CornerRadius="1.5"
                                                Background="{DynamicResource PrimaryBrush}" VerticalAlignment="Center" />
                                        <TextBlock Text="预览图" FontSize="12" FontWeight="SemiBold" Margin="6,0,0,0" />
                                    </StackPanel>
                                    <ScrollViewer HorizontalScrollBarVisibility="Hidden"
                                                  VerticalScrollBarVisibility="Disabled">
                                        <StackPanel x:Name="OnlinePreviewImagesHost" Orientation="Horizontal" />
                                    </ScrollViewer>
                                </StackPanel>

                                <!-- JAVDB/MissAV 式版式：封面 → 番号+评分胶囊 → 标题 → Tab(详情/磁力) -->
                                <Grid Margin="0,12,0,0">
                                    <TextBlock x:Name="OnlineDetailNumber" FontSize="17" FontWeight="Bold"
                                               Foreground="{DynamicResource PrimaryBrush}" VerticalAlignment="Center" />
                                    <Border x:Name="OnlineDetailRating" HorizontalAlignment="Right" VerticalAlignment="Center"
                                            CornerRadius="{DynamicResource RadiusXs}" Background="#26FFB347" Padding="9,3" Visibility="Collapsed">
                                        <TextBlock x:Name="OnlineDetailRatingText" Text="" FontSize="12" FontWeight="Bold"
                                                   Foreground="#E8890C" />
                                    </Border>
                                </Grid>
                                <TextBlock x:Name="OnlineDetailTitle" FontSize="14" FontWeight="SemiBold"
                                           TextWrapping="Wrap" Margin="0,6,0,0" />
                                <TextBlock x:Name="OnlineDetailOriginalTitle" FontSize="11.5"
                                           Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap"
                                           Margin="0,3,0,0" />

                                <!-- Tab 分段控件：视频详情 / 磁力列表；右侧“打开详情页”直达源站 -->
                                <Grid Margin="0,12,0,0">
                                    <Border HorizontalAlignment="Left" Background="{DynamicResource HoverBgBrush}"
                                            BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1"
                                            CornerRadius="{DynamicResource ControlCornerRadius}" Padding="3">
                                        <StackPanel Orientation="Horizontal">
                                            <Button x:Name="OnlineTabDetailButton" Content="视频详情" Click="OnlineTabDetail_Click" />
                                            <Button x:Name="OnlineTabMagnetButton" Content="磁力列表" Margin="2,0,0,0" Click="OnlineTabMagnet_Click" />
                                        </StackPanel>
                                    </Border>
                                    <Button x:Name="OnlineDetailOpenUrlButton" Content="打开详情页 ↗" HorizontalAlignment="Right"
                                            Style="{StaticResource LibraryActionButtonStyle}" Visibility="Collapsed"
                                            Click="OnlineDetailOpenUrl_Click" ToolTip="在浏览器打开源站详情页" />
                                </Grid>

                                <!-- Tab 1：视频详情（表格式信息行，代码生成） -->
                                <StackPanel x:Name="OnlineDetailTabInfo" Margin="0,12,0,0">
                                    <Border Background="{DynamicResource HoverBgBrush}"
                                            BorderBrush="{DynamicResource CardBorderBrush}"
                                            BorderThickness="1" CornerRadius="{DynamicResource RadiusMd}"
                                            Padding="12,4">
                                        <StackPanel x:Name="OnlineInfoHost" />
                                    </Border>

                                    <StackPanel Orientation="Horizontal" Margin="0,14,0,6">
                                        <Border Width="3" Height="11" CornerRadius="1.5"
                                                Background="{DynamicResource PrimaryBrush}" VerticalAlignment="Center" />
                                        <TextBlock Text="标签（点击搜索）" FontSize="12" FontWeight="SemiBold" Margin="6,0,0,0" />
                                    </StackPanel>
                                    <WrapPanel x:Name="OnlineDetailTagChips" />

                                    <StackPanel Orientation="Horizontal" Margin="0,12,0,6">
                                        <Border Width="3" Height="11" CornerRadius="1.5"
                                                Background="{DynamicResource PrimaryBrush}" VerticalAlignment="Center" />
                                        <TextBlock Text="简介" FontSize="12" FontWeight="SemiBold" Margin="6,0,0,0" />
                                    </StackPanel>
                                    <Border Background="{DynamicResource HoverBgBrush}"
                                            BorderBrush="{DynamicResource CardBorderBrush}"
                                            BorderThickness="1" CornerRadius="{DynamicResource RadiusMd}"
                                            Padding="10,8" Margin="0,0,0,4">
                                        <TextBox x:Name="OnlineDetailDescription" Style="{StaticResource SelectableTextStyle}"
                                                 MaxHeight="110" VerticalScrollBarVisibility="Auto" FontSize="12"
                                                 Foreground="{DynamicResource TextSecondaryBrush}" />
                                    </Border>
                                </StackPanel>

                                <!-- Tab 2：磁力列表（每条可复制，JAVDB 表格式：名称 | 体积 | 复制） -->
                                <StackPanel x:Name="OnlineDetailTabMagnets" Margin="0,12,0,0" Visibility="Collapsed">
                                    <TextBlock x:Name="OnlineMagnetHint" Text="该影片暂无磁力链接" FontSize="12"
                                               Foreground="{DynamicResource TextSecondaryBrush}" />
                                    <StackPanel x:Name="OnlineMagnetListHost" />
                                </StackPanel>
                            </StackPanel>
                            </ScrollViewer>
                        </Border>
                    </Grid>

                    <!-- 分页 -->
                    <StackPanel x:Name="OnlinePagingHost" Grid.Row="2" Orientation="Horizontal"
                                HorizontalAlignment="Center" Visibility="Collapsed" Margin="0,14,0,0">
                        <Button x:Name="PrevPageBtn" Style="{StaticResource LibraryActionButtonStyle}"
                                Content="上一页" Click="PrevPage_Click" />
                        <TextBlock x:Name="PageInfoText" FontSize="12" VerticalAlignment="Center" Margin="14,0" />
                        <Button x:Name="NextPageBtn" Style="{StaticResource LibraryActionButtonStyle}"
                                Content="下一页" Click="NextPage_Click" />
                    </StackPanel>

                    <!-- 完整详情页：整页子页（同 ActorProfileView 模式），进入时替换搜索页三行（搜索框/结果区/分页），独占整个 SearchPage -->
                    <!-- 背景与窗口一致：整页子页需不透明，避免被它覆盖的搜索页元素透出来 -->
                    <Grid x:Name="OnlineFullDetailPage" Grid.RowSpan="3" Visibility="Collapsed"
                          Background="{DynamicResource AppBackgroundBrush}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <!-- 标题栏：返回搜索结果 + 番号 + 评分胶囊 + 打开详情页/弹出播放 -->
                        <Grid Grid.Row="0" Margin="0,0,0,14">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Button x:Name="OnlineFullBackButton" Style="{StaticResource LibraryActionButtonStyle}"
                                        Content="← 返回搜索结果" Click="OnlineFullBack_Click" />
                                <TextBlock x:Name="OnlineFullNumber" FontSize="17" FontWeight="Bold"
                                           Foreground="{DynamicResource PrimaryBrush}" VerticalAlignment="Center"
                                           Margin="14,0,0,0" />
                                <Border x:Name="OnlineFullRating" HorizontalAlignment="Left" VerticalAlignment="Center"
                                        CornerRadius="{DynamicResource RadiusXs}" Background="#26FFB347" Padding="9,3"
                                        Visibility="Collapsed" Margin="10,0,0,0">
                                    <TextBlock x:Name="OnlineFullRatingText" Text="" FontSize="12" FontWeight="Bold"
                                               Foreground="#E8890C" />
                                </Border>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                <Button x:Name="OnlineFullOpenUrlButton" Content="打开详情页 ↗"
                                        Style="{StaticResource LibraryActionButtonStyle}" Visibility="Collapsed"
                                        Click="OnlineFullOpenUrl_Click" ToolTip="在浏览器打开源站详情页" />
                                <Button x:Name="OnlineFullPopoutButton" Style="{StaticResource IconButtonStyle}"
                                        Content="⛶" Click="OnlineFullPopout_Click"
                                        ToolTip="放大播放（独立窗口）" Margin="8,0,0,0" Visibility="Collapsed" />
                            </StackPanel>
                        </Grid>

                        <!-- 滚动内容区：16:9 大播放器 → 剧照 → 标题 → 双列信息 -->
                        <ScrollViewer x:Name="OnlineFullScroll" Grid.Row="1" VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled">
                            <StackPanel MaxWidth="1100" HorizontalAlignment="Center">
                                <!-- 16:9 大播放器槽：高度随宽度自适应（SizeChanged 更新） -->
                                <Border x:Name="OnlineFullPlayerSlot" CornerRadius="{DynamicResource RadiusLg}"
                                        Background="{DynamicResource HoverBgBrush}"
                                        BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1"
                                        ClipToBounds="True" SizeChanged="OnlineFullPlayerSlot_SizeChanged">
                                    <Grid>
                                        <Image x:Name="OnlineFullPoster" Stretch="Uniform" Margin="6" />
                                        <controls:OnlineVideoPreviewPlayer x:Name="OnlineFullPreviewPlayer"
                                                                           Visibility="Collapsed" Margin="1" />
                                    </Grid>
                                </Border>

                                <!-- 剧照横滚区 -->
                                <StackPanel x:Name="OnlineFullPreviewImagesSection" Visibility="Collapsed">
                                    <StackPanel Orientation="Horizontal" Margin="0,14,0,6">
                                        <Border Width="3" Height="11" CornerRadius="1.5"
                                                Background="{DynamicResource PrimaryBrush}" VerticalAlignment="Center" />
                                        <TextBlock Text="预览图" FontSize="12" FontWeight="SemiBold" Margin="6,0,0,0" />
                                    </StackPanel>
                                    <ScrollViewer HorizontalScrollBarVisibility="Hidden"
                                                  VerticalScrollBarVisibility="Disabled">
                                        <StackPanel x:Name="OnlineFullPreviewImagesHost" Orientation="Horizontal" />
                                    </ScrollViewer>
                                </StackPanel>

                                <!-- 标题信息区 -->
                                <TextBlock x:Name="OnlineFullTitle" FontSize="18" FontWeight="Bold"
                                           TextWrapping="Wrap" Margin="0,14,0,0" />
                                <TextBlock x:Name="OnlineFullOriginalTitle" FontSize="12.5"
                                           Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap"
                                           Margin="0,4,0,0" />

                                <!-- 双列信息区：左=信息表+标签，右=简介+磁力 -->
                                <Grid Margin="0,16,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="12" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0">
                                        <Border Background="{DynamicResource HoverBgBrush}"
                                                BorderBrush="{DynamicResource CardBorderBrush}"
                                                BorderThickness="1" CornerRadius="{DynamicResource RadiusMd}"
                                                Padding="12,4">
                                            <StackPanel x:Name="OnlineFullInfoHost" />
                                        </Border>
                                        <StackPanel Orientation="Horizontal" Margin="0,14,0,6">
                                            <Border Width="3" Height="11" CornerRadius="1.5"
                                                    Background="{DynamicResource PrimaryBrush}" VerticalAlignment="Center" />
                                            <TextBlock Text="标签（点击搜索）" FontSize="12" FontWeight="SemiBold" Margin="6,0,0,0" />
                                        </StackPanel>
                                        <WrapPanel x:Name="OnlineFullTagChips" />
                                    </StackPanel>

                                    <StackPanel Grid.Column="2">
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                            <Border Width="3" Height="11" CornerRadius="1.5"
                                                    Background="{DynamicResource PrimaryBrush}" VerticalAlignment="Center" />
                                            <TextBlock Text="简介" FontSize="12" FontWeight="SemiBold" Margin="6,0,0,0" />
                                        </StackPanel>
                                        <Border Background="{DynamicResource HoverBgBrush}"
                                                BorderBrush="{DynamicResource CardBorderBrush}"
                                                BorderThickness="1" CornerRadius="{DynamicResource RadiusMd}"
                                                Padding="10,8" Margin="0,0,0,12">
                                            <TextBox x:Name="OnlineFullDescription" Style="{StaticResource SelectableTextStyle}"
                                                     VerticalScrollBarVisibility="Auto" FontSize="12" TextWrapping="Wrap"
                                                     Foreground="{DynamicResource TextSecondaryBrush}" />
                                        </Border>
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                            <Border Width="3" Height="11" CornerRadius="1.5"
                                                    Background="{DynamicResource PrimaryBrush}" VerticalAlignment="Center" />
                                            <TextBlock Text="磁力列表" FontSize="12" FontWeight="SemiBold" Margin="6,0,0,0" />
                                        </StackPanel>
                                        <TextBlock x:Name="OnlineFullMagnetHint" Text="该影片暂无磁力链接" FontSize="12"
                                                   Foreground="{DynamicResource TextSecondaryBrush}" Visibility="Collapsed" />
                                        <StackPanel x:Name="OnlineFullMagnetsHost" />
                                    </StackPanel>
                                </Grid>

                                <!-- 同系列推荐：JavDB 详情页同系列番号，后台逐番号搜索渲染卡片；点击切换完整详情 -->
                                <StackPanel x:Name="OnlineFullRelatedSection" Visibility="Collapsed">
                                    <StackPanel Orientation="Horizontal" Margin="0,18,0,8">
                                        <Border Width="3" Height="13" CornerRadius="1.5"
                                                Background="{DynamicResource PrimaryBrush}" VerticalAlignment="Center" />
                                        <TextBlock Text="同系列推荐" FontSize="12" FontWeight="SemiBold" Margin="6,0,0,0" />
                                    </StackPanel>
                                    <ScrollViewer HorizontalScrollBarVisibility="Hidden"
                                                  VerticalScrollBarVisibility="Disabled">
                                        <StackPanel x:Name="OnlineFullRelatedHost" Orientation="Horizontal" />
                                    </ScrollViewer>
                                </StackPanel>
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>
                </Grid>

                <!-- 推荐页（占位） -->
                <views:VideoRecommendView x:Name="RecommendPage" Visibility="Collapsed" />

                <!-- 本地页：左侧卡片 + 右侧筛选边栏 -->
                <!-- 刮削任务页 -->
                <views:VideoTaskDashboard x:Name="TaskPage" Visibility="Collapsed" />
                <views:ActorListView x:Name="ActorListPage" Visibility="Collapsed" />
                <views:ActorProfileView x:Name="ActorPage" Visibility="Collapsed" />
                <Grid x:Name="LocalPage" Visibility="Collapsed">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- 右侧详情栏：点击卡片后顶替右侧本地搜索面板的位置 -->
                    <ScrollViewer x:Name="DetailScroll" Grid.Column="1" Width="348"
                                  VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                                  Visibility="Collapsed">
                        <StackPanel>
                            <Grid Margin="0,0,0,10">
                                <TextBlock Text="详情" FontSize="15" FontWeight="Bold" VerticalAlignment="Center" />
                                <Button x:Name="DetailCloseButton" Style="{StaticResource IconButtonStyle}"
                                        Content="✕" HorizontalAlignment="Right" VerticalAlignment="Center"
                                        Click="DetailClose_Click" ToolTip="关闭详情" />
                            </Grid>

                            <Border Height="230" CornerRadius="{DynamicResource RadiusLg}"
                                    Background="{DynamicResource HoverBgBrush}"
                                    BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1">
                                <Image x:Name="DetailPoster" Stretch="Uniform" Margin="6" />
                            </Border>

                            <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                                <TextBlock x:Name="DetailNumber" FontSize="15" FontWeight="Bold"
                                           Foreground="{DynamicResource PrimaryBrush}" VerticalAlignment="Center" />
                                <Button x:Name="FavoriteButton" Style="{StaticResource IconButtonStyle}"
                                        Margin="8,0,0,0" Click="DetailFavorite_Click" ToolTip="收藏">
                                    <TextBlock x:Name="FavoriteHeart" Text="♡" FontSize="15" />
                                </Button>
                            </StackPanel>
                            <WrapPanel Margin="0,10,0,0">
                                <Button Style="{StaticResource LibraryPrimaryButtonStyle}" Content="播放" Click="PlayDetail_Click" />
                                <Button Style="{StaticResource LibraryActionButtonStyle}" Content="重刮削" Margin="6,0,0,0" Click="ScrapeDetail_Click" />
                                <Button Style="{StaticResource LibraryActionButtonStyle}" Content="编辑信息" Margin="6,0,0,0" Click="DetailEdit_Click" />
                                <Button Style="{StaticResource LibraryActionButtonStyle}" Content="打开目录" Margin="6,0,0,0" Click="OpenFolder_Click" />
                                <Button Style="{StaticResource LibraryActionButtonStyle}" Content="移除" Margin="6,0,0,0" Click="RemoveDetail_Click" />
                            </WrapPanel>

                            <TextBlock x:Name="DetailTitle" FontSize="16" FontWeight="Bold" TextWrapping="Wrap" Margin="0,10,0,2" />
                            <TextBlock x:Name="OriginalTitleText" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" />
                            <TextBlock Text="演员" FontSize="11.5" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,12,0,3" />
                            <WrapPanel x:Name="ActorChips" />
                            <TextBlock Text="标签" FontSize="11.5" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,10,0,3" />
                            <WrapPanel x:Name="TagChips" />
                            <TextBlock x:Name="MetaText" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,12,0,0" />
                            <TextBlock Text="简介" FontSize="12" FontWeight="SemiBold" Margin="0,12,0,3" />
                            <TextBox x:Name="DescriptionText" IsReadOnly="True" BorderThickness="0" Background="Transparent"
                                     TextWrapping="Wrap" MaxHeight="96" VerticalScrollBarVisibility="Auto" FontSize="12" />
                            <StackPanel x:Name="PartsHost" Orientation="Horizontal" Margin="0,12,0,0" Visibility="Collapsed" />
                            <TextBlock x:Name="SeriesPartsHeader" FontSize="11.5" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,12,0,4" Visibility="Collapsed" />
                            <WrapPanel x:Name="SeriesPartsHost" Orientation="Horizontal" Visibility="Collapsed" />
                            <StackPanel x:Name="RatingHost" Orientation="Horizontal" Margin="0,12,0,0" />

                            <TextBlock x:Name="PreviewHeader" Text="剧照" FontSize="15" FontWeight="Bold" Margin="0,16,0,8" />
                            <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                                <StackPanel x:Name="PreviewsHost" Orientation="Horizontal" />
                            </ScrollViewer>

                            <TextBlock Text="观看与文件" FontSize="15" FontWeight="Bold" Margin="0,18,0,8" />
                            <Border Background="{DynamicResource HoverBgBrush}" BorderBrush="{DynamicResource CardBorderBrush}"
                                    BorderThickness="1" CornerRadius="{DynamicResource RadiusMd}" Padding="14,12">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="96" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="文件路径" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Top" />
                                    <TextBlock x:Name="FilePathText" Grid.Row="0" Grid.Column="1" FontSize="12" TextWrapping="Wrap"
                                               Cursor="Hand" MouseLeftButtonUp="CopyFilePath_Click" ToolTip="点击复制完整路径" />

                                    <TextBlock Grid.Row="1" Grid.Column="0" Text="文件大小" FontSize="12" Margin="0,9,0,0" Foreground="{DynamicResource TextSecondaryBrush}" />
                                    <TextBlock x:Name="FileSizeText" Grid.Row="1" Grid.Column="1" FontSize="12" Margin="0,9,0,0" />

                                    <TextBlock Grid.Row="2" Grid.Column="0" Text="修改时间" FontSize="12" Margin="0,9,0,0" Foreground="{DynamicResource TextSecondaryBrush}" />
                                    <TextBlock x:Name="FileModifiedText" Grid.Row="2" Grid.Column="1" FontSize="12" Margin="0,9,0,0" />

                                    <TextBlock Grid.Row="3" Grid.Column="0" Text="观看次数" FontSize="12" Margin="0,9,0,0" Foreground="{DynamicResource TextSecondaryBrush}" />
                                    <TextBlock x:Name="WatchStatsText" Grid.Row="3" Grid.Column="1" FontSize="12" Margin="0,9,0,0" />

                                    <TextBlock Grid.Row="4" Grid.Column="0" Text="打开目录" FontSize="12" Margin="0,9,0,0" Foreground="{DynamicResource TextSecondaryBrush}" />
                                    <TextBlock x:Name="OpenStatsText" Grid.Row="4" Grid.Column="1" FontSize="12" Margin="0,9,0,0" />

                                    <TextBlock Grid.Row="5" Grid.Column="0" Text="目录路径" FontSize="12" Margin="0,9,0,0" Foreground="{DynamicResource TextSecondaryBrush}" />
                                    <TextBlock x:Name="DirectoryPathText" Grid.Row="5" Grid.Column="1" FontSize="12" Margin="0,9,0,0" TextWrapping="Wrap"
                                               Cursor="Hand" MouseLeftButtonUp="OpenDetailDirectory_Click" ToolTip="点击打开目录" />

                                    <TextBlock Grid.Row="6" Grid.Column="0" Text="NFO 文件" FontSize="12" Margin="0,9,0,0" Foreground="{DynamicResource TextSecondaryBrush}" />
                                    <TextBlock x:Name="NfoStatusText" Grid.Row="6" Grid.Column="1" FontSize="12" Margin="0,9,0,0" />

                                    <TextBlock Grid.Row="7" Grid.Column="0" Text="文件状态" FontSize="12" Margin="0,9,0,0" Foreground="{DynamicResource TextSecondaryBrush}" />
                                    <TextBlock x:Name="FileStatusText" Grid.Row="7" Grid.Column="1" FontSize="12" FontWeight="SemiBold" Margin="0,9,0,0" />

                                    <TextBlock Grid.Row="8" Grid.Column="0" Text="外部详情页" FontSize="12" Margin="0,9,0,0" Foreground="{DynamicResource TextSecondaryBrush}" />
                                    <TextBlock x:Name="SourceUrlText" Grid.Row="8" Grid.Column="1" FontSize="12" Margin="0,9,0,0" TextWrapping="Wrap"
                                               Cursor="Hand" MouseLeftButtonUp="CopySourceUrl_Click" ToolTip="点击复制来源详情页地址" />
                                </Grid>
                            </Border>

                            <TextBlock x:Name="SeriesRecommendHeader" Text="同系列" FontSize="15" FontWeight="Bold" Margin="0,16,0,8" />
                            <WrapPanel x:Name="SeriesRecommends" />
                            <TextBlock x:Name="ActorRecommendHeader" Text="同演员" FontSize="15" FontWeight="Bold" Margin="0,16,0,8" />
                            <WrapPanel x:Name="ActorRecommends" />
                            <TextBlock x:Name="RelatedRecommendHeader" Text="相关推荐" FontSize="15" FontWeight="Bold" Margin="0,16,0,8" />
                            <WrapPanel x:Name="RelatedRecommends" />
                            <controls:ScrapeReportPanel x:Name="ScrapeReportPanel" Margin="0,16,0,0" />
                            <TextBlock x:Name="ReviewHeader" Text="短评" FontSize="15" FontWeight="Bold" Margin="0,16,0,8" />
                            <StackPanel x:Name="ReviewHost" />
                        </StackPanel>
                    </ScrollViewer>

                    <!-- 本地卡片区域 -->
                    <Grid Grid.Column="0" Margin="0,0,14,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <!-- 本地页工具栏：标题/排序/动作在代码后置组装（内容属性元素内不能注册 x:Name） -->
                        <controls:BrowserToolbar x:Name="LocalToolbar" Grid.Row="0" Margin="0,0,0,14"
                                                 ShowSearchBox="False" ShowSearchButton="False" />

                        <controls:VirtualizedCardGrid x:Name="VideoItems" Grid.Row="1" Visibility="Collapsed"
                                                       SlotWidth="{Binding SlotWidth, RelativeSource={RelativeSource AncestorType=views:VideoView}}"
                                                       DesiredColumns="{Binding Columns, RelativeSource={RelativeSource AncestorType=views:VideoView}}"
                                                       CardWidth="{Binding CardWidth, RelativeSource={RelativeSource AncestorType=views:VideoView}}">
                            <controls:VirtualizedCardGrid.ItemTemplate>
                                <DataTemplate>
                                    <controls:MediaCard Width="{Binding CardWidth, RelativeSource={RelativeSource AncestorType=controls:VirtualizedCardGrid}}"
                                                        Margin="0,0,14,14"
                                                        HorizontalAlignment="Center" />
                                </DataTemplate>
                            </controls:VirtualizedCardGrid.ItemTemplate>
                        </controls:VirtualizedCardGrid>

                        <StackPanel x:Name="EmptyPanel" Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Center" Visibility="Collapsed">
                            <Border Width="72" Height="72" CornerRadius="{DynamicResource RadiusXl}" Background="{DynamicResource HoverBgBrush}">
                                <Path Data="{StaticResource IconLibrary}" Stroke="{DynamicResource TextDisabledBrush}" StrokeThickness="2.2"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Stretch="Uniform"
                                      Width="26" Height="26" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <TextBlock x:Name="EmptyTitle" Text="还没有视频文件" FontSize="15" FontWeight="SemiBold" Margin="0,16,0,0" HorizontalAlignment="Center" />
                            <TextBlock Text="添加文件夹后即可在本地模式浏览视频" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,6,0,0" HorizontalAlignment="Center" />
                            <Button x:Name="EmptyAddButton" Content="添加第一个文件夹" Style="{StaticResource LibraryPrimaryButtonStyle}"
                                    Margin="0,18,0,0" Click="AddFolder_Click" />
                        </StackPanel>

                        <Grid Grid.Row="2" Margin="0,8,0,0">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Button x:Name="PrevPageButton" Style="{StaticResource GhostButtonStyle}"
                                        Content="‹ 上一页" Click="ChangePage" Padding="12,5" />
                                <TextBlock x:Name="PageText" FontSize="12" VerticalAlignment="Center"
                                           Foreground="{DynamicResource TextSecondaryBrush}" Margin="14,0" MinWidth="76" TextAlignment="Center" />
                                <Button x:Name="NextPageButton" Style="{StaticResource GhostButtonStyle}"
                                        Content="下一页 ›" Click="ChangePage" Padding="12,5" />
                                <TextBox x:Name="JumpPageBox" Style="{StaticResource ModernTextBoxStyle}"
                                         Width="52" Height="28" Margin="16,0,0,0" FontSize="12"
                                         VerticalContentAlignment="Center" HorizontalContentAlignment="Center"
                                         ToolTip="输入页码后回车或点跳转" KeyDown="JumpPageBox_KeyDown" />
                                <Button x:Name="JumpPageButton" Style="{StaticResource GhostButtonStyle}"
                                        Content="跳转" Click="JumpPage_Click" Padding="12,5" Margin="6,0,0,0" />
                                <ComboBox x:Name="PageSizeBox" Width="84" Margin="16,0,0,0" VerticalAlignment="Center"
                                          SelectionChanged="PageSizeBox_SelectionChanged">
                                    <ComboBoxItem Content="每页 20" Tag="20" />
                                    <ComboBoxItem Content="每页 30" Tag="30" IsSelected="True" />
                                    <ComboBoxItem Content="每页 40" Tag="40" />
                                </ComboBox>
                            </StackPanel>
                        </Grid>
                    </Grid>

                </Grid>
            </Grid>
        </Grid>

        <Border x:Name="TaskBar" Grid.Row="1" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource CardBorderBrush}"
                BorderThickness="1" CornerRadius="{DynamicResource RadiusSm}" Padding="10,6" Margin="0,10,0,0" Visibility="Collapsed">
            <StackPanel>
                <Grid>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock x:Name="TaskTitle" Text="刮削中" FontSize="12" FontWeight="Bold" VerticalAlignment="Center" />
                        <ProgressBar x:Name="TaskProgress" Width="180" Height="6" Minimum="0" Maximum="100" Value="0" Margin="10,0,10,0" VerticalAlignment="Center" />
                        <TextBlock x:Name="TaskSummary" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button x:Name="ViewNoMatchButton" Style="{StaticResource LibraryActionButtonStyle}"
                                Content="查看未匹配" Visibility="Collapsed" Click="ViewNoMatch_Click" />
                        <Button x:Name="RetryFailedButton" Style="{StaticResource LibraryActionButtonStyle}"
                                Margin="8,0,0,0" Content="重试失败" Visibility="Collapsed" Click="RetryFailed_Click" />
                        <Button Style="{StaticResource LibraryActionButtonStyle}" Content="展开日志" Click="ToggleLogs_Click" />
                        <Button x:Name="StopButton" Style="{StaticResource LibraryActionButtonStyle}" Content="停止" Margin="8,0,0,0" Click="StopScrape_Click" />
                    </StackPanel>
                </Grid>
                <ListBox x:Name="TaskLogList" MaxHeight="120" Visibility="Collapsed" FontSize="11" BorderThickness="0" Background="Transparent" Margin="0,8,0,0" />
            </StackPanel>
        </Border>
    </Grid>
</controls:CardGridViewBase>
