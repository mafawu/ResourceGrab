<UserControl x:Class="ResourceGrab.App.Views.NovelReaderView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid x:Name="ReaderRoot">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ================= 顶栏 ================= -->
        <Grid Grid.Row="0" Margin="18,10,14,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Button Style="{StaticResource GhostButtonStyle}" Content="‹ 返回" Click="BackButton_Click" Padding="12,6" FontSize="12.5"/>
                <TextBlock x:Name="TitleText" FontSize="13.5" FontWeight="SemiBold" Margin="14,0,0,0"
                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="360"
                           Foreground="{DynamicResource TextPrimaryBrush}"/>
            </StackPanel>

            <!-- 中间：模式 · 页码（照稿子放中间，不抢右侧控件） -->
            <TextBlock x:Name="PageText" Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center"
                       FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}"/>

            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                <Border x:Name="ModeToggleBorder" CornerRadius="{DynamicResource RadiusSm}" Background="{DynamicResource HoverBgBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" Padding="2">
                    <StackPanel Orientation="Horizontal">
                        <Button x:Name="PageModeBtn" Content="翻页" Padding="12,4" Click="ModePage_Click" Style="{StaticResource GhostButtonStyle}" FontSize="12"/>
                        <Button x:Name="ScrollModeBtn" Content="滚动" Padding="12,4" Click="ModeScroll_Click" Style="{StaticResource GhostButtonStyle}" FontSize="12"/>
                    </StackPanel>
                </Border>
                <Border Width="1" Background="{DynamicResource DividerBrush}" Margin="12,4" Height="18"/>
                <Button Style="{StaticResource GhostButtonStyle}" Content="A-" Click="FontDec_Click" Padding="8,5" FontSize="12"/>
                <TextBlock x:Name="FontSizeText" Text="18" FontSize="12" VerticalAlignment="Center" Margin="6,0"
                           Foreground="{DynamicResource TextSecondaryBrush}"/>
                <Button Style="{StaticResource GhostButtonStyle}" Content="A+" Click="FontInc_Click" Padding="8,5" FontSize="12"/>
                <Border Width="1" Background="{DynamicResource DividerBrush}" Margin="12,4" Height="18"/>
                <TextBlock Text="背景" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <StackPanel x:Name="BgPanel" Orientation="Horizontal" VerticalAlignment="Center"/>

                <!-- 在线阅读才有：目录 -->
                <Border x:Name="ChapterBar" Visibility="Collapsed" Margin="14,0,0,0">
                    <Button x:Name="ChapterListButton" Style="{StaticResource GhostButtonStyle}" Click="ChapterList_Click" Padding="10,5">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource IconDocument}" Stroke="{DynamicResource TextSecondaryBrush}" StrokeThickness="1.5"
                                  Stretch="Uniform" Width="11" Height="11" VerticalAlignment="Center"/>
                            <TextBlock Text="目录" FontSize="12" Margin="6,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </Border>

                <Button Style="{StaticResource IconButtonStyle}" Click="BackButton_Click" ToolTip="关闭阅读" Margin="6,0,0,0">
                    <Path Data="{StaticResource IconClose}" Stroke="{DynamicResource TextSecondaryBrush}"
                          StrokeThickness="1.6" Stretch="Uniform" Width="11" Height="11"/>
                </Button>
            </StackPanel>
        </Grid>

        <!-- ================= 正文：整幅纸面 + 居中版心 ================= -->
        <Border x:Name="ReaderBorder" Grid.Row="1" Background="White" BorderThickness="0" ClipToBounds="True">
            <Grid>
                <ScrollViewer x:Name="ReaderScroll" VerticalScrollBarVisibility="Auto" PanningMode="VerticalOnly"
                              PreviewMouseWheel="ReaderScroll_PreviewMouseWheel" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel MaxWidth="900" HorizontalAlignment="Center" Margin="0,34,0,64">
                        <!-- 章节头（在线阅读才有） -->
                        <StackPanel x:Name="ChapterHeaderPanel" Visibility="Collapsed" Margin="0,0,0,30">
                            <TextBlock x:Name="ChapterNoText" FontSize="12" HorizontalAlignment="Center"
                                       Foreground="{DynamicResource TextDisabledBrush}"/>
                            <TextBlock x:Name="ChapterTitleText" FontSize="27" FontWeight="Bold" HorizontalAlignment="Center"
                                       Margin="0,10,0,0" TextWrapping="Wrap" TextAlignment="Center"/>
                            <TextBlock x:Name="ChapterMetaText" FontSize="11.5" HorizontalAlignment="Center"
                                       Margin="0,10,0,0" Foreground="{DynamicResource TextDisabledBrush}"/>
                        </StackPanel>

                        <TextBlock x:Name="ContentText" FontSize="17" LineHeight="34" TextWrapping="Wrap"
                                   Foreground="{DynamicResource TextPrimaryBrush}"/>
                    </StackPanel>
                </ScrollViewer>

                <!-- 滚动模式：整本书分块虚拟化 -->
                <ListBox x:Name="ScrollList" Visibility="Collapsed" Background="Transparent" BorderThickness="0"
                         MaxWidth="900" HorizontalAlignment="Center" Padding="0,34,0,64"
                         ScrollViewer.CanContentScroll="True" VirtualizingPanel.IsVirtualizing="True"
                         VirtualizingPanel.VirtualizationMode="Recycling" VirtualizingPanel.ScrollUnit="Pixel"
                         ScrollViewer.VerticalScrollBarVisibility="Auto" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         ScrollViewer.ScrollChanged="ScrollList_ScrollChanged">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem" BasedOn="{StaticResource SpacedPlainListBoxItemStyle}" />
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding}" TextWrapping="Wrap" LineHeight="{Binding LineHeight, ElementName=ContentText}"
                                       Foreground="{Binding Foreground, ElementName=ContentText}" FontSize="{Binding FontSize, ElementName=ContentText}"/>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                    <ListBox.ItemsPanel>
                        <ItemsPanelTemplate>
                            <VirtualizingStackPanel IsVirtualizing="True" VirtualizationMode="Recycling" ScrollUnit="Pixel"/>
                        </ItemsPanelTemplate>
                    </ListBox.ItemsPanel>
                </ListBox>
            </Grid>
        </Border>

        <!-- ================= 底栏 ================= -->
        <Grid Grid.Row="2" Margin="18,10,18,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- 左：切章 + 章节跳转（在线阅读才有） -->
            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                <StackPanel x:Name="ChapterNavPanel" Orientation="Horizontal" Visibility="Collapsed">
                    <Button x:Name="PrevChapterButton" Content="上一章" Style="{StaticResource GhostButtonStyle}"
                            Padding="12,6" FontSize="12" Click="PrevChapter_Click"/>
                    <TextBlock x:Name="ChapterPosText" Margin="10,0" MinWidth="56" TextAlignment="Center"
                               VerticalAlignment="Center" FontSize="12"
                               Foreground="{DynamicResource TextSecondaryBrush}"/>
                    <Button x:Name="NextChapterButton" Content="下一章" Style="{StaticResource GhostButtonStyle}"
                            Padding="12,6" FontSize="12" Click="NextChapter_Click"/>
                    <Border Width="1" Background="{DynamicResource DividerBrush}" Margin="12,4" Height="16"/>
                    <TextBlock Text="跳至" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}"
                               VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <TextBox x:Name="ChapterJumpBox" Width="48" Height="26" VerticalContentAlignment="Center"
                             Padding="6,0" FontSize="12" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1"
                             KeyDown="ChapterJumpBox_KeyDown"/>
                    <TextBlock Text="章" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}"
                               VerticalAlignment="Center" Margin="6,0,0,0"/>
                    <Button Content="跳转" Style="{StaticResource GhostButtonStyle}" Margin="8,0,0,0" Padding="10,5"
                            FontSize="12" Click="ChapterJumpButton_Click"/>
                </StackPanel>
                <TextBlock x:Name="ScrollBar" Text="滚动模式 · 滚轮自由滚动 · 虚拟化渲染" Visibility="Collapsed"
                           FontSize="12" VerticalAlignment="Center" Margin="12,0,0,0"
                           Foreground="{DynamicResource TextSecondaryBrush}"/>
            </StackPanel>

            <!-- 中：百分比 + 进度条（进度条弹性宽度，窗口再窄也不会被挤没） -->
            <Grid Grid.Column="1" Margin="16,0" VerticalAlignment="Center">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="ProgressText" Grid.Column="0" FontSize="12" VerticalAlignment="Center" MinWidth="38"
                           Foreground="{DynamicResource TextSecondaryBrush}"/>
                <Grid x:Name="ProgressTrack" Grid.Column="1" Height="4" Margin="12,0" MinWidth="120" MaxWidth="520"
                      VerticalAlignment="Center" Background="Transparent" SizeChanged="ProgressTrack_SizeChanged">
                    <Border Background="{DynamicResource CardBorderBrush}" CornerRadius="2"/>
                    <Border x:Name="ProgressFill" Background="{DynamicResource PrimaryBrush}" CornerRadius="2"
                            HorizontalAlignment="Left" Width="0"/>
                </Grid>
            </Grid>

            <!-- 右：翻页 -->
            <StackPanel x:Name="PageBar" Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                <Button Style="{StaticResource GhostButtonStyle}" Content="上一页" Click="PrevPage_Click" x:Name="PrevBtn" Padding="12,6" FontSize="12"/>
                <TextBlock x:Name="PagerText" Text="1 / 1" Margin="10,0" VerticalAlignment="Center" FontSize="12"
                           Foreground="{DynamicResource TextSecondaryBrush}"/>
                <Button Style="{StaticResource GhostButtonStyle}" Content="下一页" Click="NextPage_Click" x:Name="NextBtn" Padding="12,6" FontSize="12"/>
                <Border Width="1" Background="{DynamicResource DividerBrush}" Margin="12,4" Height="16"/>
                <TextBlock Text="跳至" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                <TextBox x:Name="JumpBox" Width="48" Height="26" VerticalContentAlignment="Center" Padding="6,0" FontSize="12"
                         BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" KeyDown="JumpBox_KeyDown"/>
                <TextBlock x:Name="JumpTotalText" Text="/ 1" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}"
                           VerticalAlignment="Center" Margin="6,0,0,0"/>
            </StackPanel>
        </Grid>

        <!-- ================= 目录抽屉：整幅高度，从右侧盖上来 ================= -->
        <Grid x:Name="ChapterDrawer" Grid.RowSpan="3" Visibility="Collapsed">
            <Border Background="#1410141F" MouseLeftButtonDown="DrawerScrim_Click"/>
            <Border Width="344" HorizontalAlignment="Right" Background="{DynamicResource SurfaceBrush}"
                    BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1,0,0,0" ClipToBounds="True">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="18,16,10,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="目录" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center"
                                   Foreground="{DynamicResource TextPrimaryBrush}"/>
                        <TextBlock x:Name="DrawerSubtitleText" Grid.Column="1" FontSize="11.5" Margin="10,2,0,0"
                                   VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                   Foreground="{DynamicResource TextDisabledBrush}"/>
                        <Button Grid.Column="2" Style="{StaticResource IconButtonStyle}" Click="DrawerClose_Click" ToolTip="关闭">
                            <Path Data="{StaticResource IconClose}" Stroke="{DynamicResource TextSecondaryBrush}"
                                  StrokeThickness="1.6" Stretch="Uniform" Width="11" Height="11"/>
                        </Button>
                    </Grid>
                    <Border Grid.Row="0" Height="1" VerticalAlignment="Bottom" Background="{DynamicResource DividerBrush}"/>

                    <ListBox x:Name="DrawerList" Grid.Row="1" Background="Transparent" BorderThickness="0" Padding="6,6,6,6"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             SelectionChanged="DrawerList_SelectionChanged">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Padding" Value="12,0"/>
                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <Border x:Name="Bd" Background="Transparent" Height="34" CornerRadius="6">
                                                <ContentPresenter VerticalAlignment="Center"/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="Bd" Property="Background" Value="{DynamicResource HoverBgBrush}"/>
                                                </Trigger>
                                                <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                                                    <Setter TargetName="Bd" Property="Background" Value="{DynamicResource HoverBgBrush}"/>
                                                </DataTrigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="38"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding IndexText}" FontSize="11.5" VerticalAlignment="Center">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="{DynamicResource TextDisabledBrush}"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                                                        <Setter Property="Foreground" Value="{DynamicResource PrimaryBrush}"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                    <TextBlock Grid.Column="1" Text="{Binding Title}" FontSize="12.5"
                                               TextTrimming="CharacterEllipsis" VerticalAlignment="Center">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                                                        <Setter Property="Foreground" Value="{DynamicResource PrimaryBrush}"/>
                                                        <Setter Property="FontWeight" Value="SemiBold"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                    <Path Grid.Column="2" Data="{StaticResource IconCheck}" Stretch="Uniform" Width="12" Height="12"
                                          Stroke="{DynamicResource SuccessBrush}" StrokeThickness="1.8" VerticalAlignment="Center"
                                          Margin="8,0,0,0" Visibility="{Binding IsRead, Converter={StaticResource BoolToVis}}"/>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <Border Grid.Row="2" Padding="18,10" BorderBrush="{DynamicResource DividerBrush}" BorderThickness="0,1,0,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="DrawerCurrentText" FontSize="11.5" TextTrimming="CharacterEllipsis"
                                       Foreground="{DynamicResource TextSecondaryBrush}"/>
                            <TextBlock x:Name="DrawerFootText" Grid.Column="1" FontSize="11" Margin="10,0,0,0"
                                       Foreground="{DynamicResource TextDisabledBrush}"/>
                        </Grid>
                    </Border>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
