<UserControl x:Class="ResourceGrab.App.Views.VideoTaskDashboard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:ResourceGrab.App.Controls"
             Background="{DynamicResource SurfaceBrush}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- 标题栏 + 操作按钮 -->
        <Border Grid.Row="0" Style="{StaticResource CardPanelStyle}" Padding="16" Margin="20,20,20,0">
            <Grid>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="刮削任务" FontSize="18" FontWeight="Bold" VerticalAlignment="Center" />
                    <Border Style="{StaticResource CountBadgeStyle}" Margin="12,0,0,0" VerticalAlignment="Center">
                        <TextBlock x:Name="TotalCountText" FontSize="11" Foreground="{DynamicResource PrimaryBrush}" />
                    </Border>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="重试失败" Style="{StaticResource LibraryActionButtonStyle}"
                            Click="RetryFailed_Click" Margin="0,0,8,0" />
                    <Button Content="全部取消" Style="{StaticResource LibraryActionButtonStyle}"
                            Click="CancelAll_Click" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- 统计条 -->
        <Border Grid.Row="1" Margin="20,8,20,0" Padding="12,8"
                Background="{DynamicResource HoverBgBrush}" BorderBrush="{DynamicResource CardBorderBrush}"
                BorderThickness="1" CornerRadius="{DynamicResource RadiusSm}">
            <StackPanel Orientation="Horizontal">
                <TextBlock FontSize="12" Margin="0,0,16,0">
                    <Run Text="运行中: " Foreground="{DynamicResource TextSecondaryBrush}" />
                    <Run x:Name="RunningText" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryBrush}" />
                </TextBlock>
                <TextBlock FontSize="12" Margin="0,0,16,0">
                    <Run Text="等待: " Foreground="{DynamicResource TextSecondaryBrush}" />
                    <Run x:Name="PendingText" FontWeight="SemiBold" />
                </TextBlock>
                <TextBlock FontSize="12" Margin="0,0,16,0">
                    <Run Text="完成: " Foreground="{DynamicResource TextSecondaryBrush}" />
                    <Run x:Name="CompletedText" FontWeight="SemiBold" Foreground="{DynamicResource SuccessBrush}" />
                </TextBlock>
                <TextBlock FontSize="12" Margin="0,0,16,0">
                    <Run Text="失败: " Foreground="{DynamicResource TextSecondaryBrush}" />
                    <Run x:Name="FailedText" FontWeight="SemiBold" Foreground="{DynamicResource DangerBrush}" />
                </TextBlock>
                <TextBlock FontSize="12">
                    <Run Text="跳过: " Foreground="{DynamicResource TextSecondaryBrush}" />
                    <Run x:Name="SkippedText" FontWeight="SemiBold" />
                </TextBlock>
            </StackPanel>
        </Border>

        <!-- 来源健康：per-source 成功率 / Block 率（阶段3观测） -->
        <Border x:Name="HealthPanel" Grid.Row="2" Margin="20,8,20,0" Padding="12,8"
                Background="{DynamicResource HoverBgBrush}" BorderBrush="{DynamicResource CardBorderBrush}"
                BorderThickness="1" CornerRadius="{DynamicResource RadiusSm}" Visibility="Collapsed">
            <StackPanel>
                <TextBlock Text="来源健康" FontSize="12" FontWeight="SemiBold"
                           Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4" />
                <TextBlock x:Name="HealthText" FontSize="11" TextWrapping="Wrap"
                           Foreground="{DynamicResource TextSecondaryBrush}" />
            </StackPanel>
        </Border>

        <!-- 任务列表 -->
        <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto" Margin="20,8,20,20">
            <StackPanel>
                <StackPanel x:Name="TaskListPanel" />
                <StackPanel x:Name="EmptyState" VerticalAlignment="Center" HorizontalAlignment="Center"
                            Margin="0,60,0,0">
                    <Border Width="64" Height="64" CornerRadius="{DynamicResource RadiusXl}"
                            Background="{DynamicResource HoverBgBrush}">
                        <Path Data="{StaticResource IconTaskProgress}" Stroke="{DynamicResource TextDisabledBrush}"
                              StrokeThickness="1.8" Stretch="Uniform" Width="24" Height="24"
                              HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <TextBlock Text="暂无刮削任务" FontSize="14" Foreground="{DynamicResource TextSecondaryBrush}"
                               HorizontalAlignment="Center" Margin="0,14,0,0" />
                    <TextBlock Text="在本地视频页触发刮削后，任务将显示在此处"
                               FontSize="11" Foreground="{DynamicResource TextDisabledBrush}"
                               HorizontalAlignment="Center" Margin="0,4,0,0" />
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
