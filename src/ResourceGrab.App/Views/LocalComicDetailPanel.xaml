<UserControl x:Class="ResourceGrab.App.Views.LocalComicDetailPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{DynamicResource SurfaceBrush}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- 标题栏 -->
        <Grid Grid.Row="0" Margin="18,16,18,12">
            <StackPanel Orientation="Horizontal">
                <Path Data="{StaticResource IconInfo}" Stroke="{DynamicResource PrimaryBrush}" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Stretch="Uniform" Width="14" Height="14" VerticalAlignment="Center" />
                <TextBlock Text="本地详情" FontSize="15" FontWeight="Bold"
                           Margin="8,0,0,0" VerticalAlignment="Center" />
            </StackPanel>
            <Button Style="{StaticResource GhostButtonStyle}" x:Name="BackButton" Content="返回列表"
                    HorizontalAlignment="Right" Padding="10,4"
                    Click="BackButton_Click" />
        </Grid>

        <!-- 详情内容 -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      Padding="18,0,18,18">
            <StackPanel>
                <!-- 封面 -->
                <Border Height="220" CornerRadius="{DynamicResource RadiusXl}"
                        Background="{DynamicResource HoverBgBrush}"
                        BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1">
                    <Image x:Name="CoverImage" Stretch="Uniform" Margin="8" />
                </Border>

                <TextBlock x:Name="TitleText" FontSize="16" FontWeight="Bold"
                           TextWrapping="Wrap" Margin="0,12,0,0" />
                <TextBlock x:Name="TitleCnText" FontSize="12"
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           TextWrapping="Wrap" Margin="0,4,0,0" Visibility="Collapsed" />

                <TextBlock x:Name="MetaText" FontSize="12"
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           TextWrapping="Wrap" Margin="0,8,0,0" />

                <!-- 更新检查 -->
                <Border Height="1" Background="{DynamicResource DividerBrush}" Margin="0,14,0,0" />
                <TextBlock Text="更新检查" FontSize="12.5" FontWeight="SemiBold"
                           Margin="0,14,0,0" />
                <TextBlock x:Name="UpdateStatusText" FontSize="12"
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           TextWrapping="Wrap" Margin="0,6,0,0"
                           Text="点击「检查更新」查看是否有新章节" />
                <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                    <Button x:Name="CheckUpdateButton" Style="{StaticResource PrimaryButtonStyle}"
                            Content="检查更新" Padding="14,6"
                            Click="CheckUpdateButton_Click" />
                    <Button x:Name="DownloadUpdateButton" Style="{StaticResource GhostButtonStyle}"
                            Content="更新下载" Margin="8,0,0,0" Padding="14,6"
                            IsEnabled="False"
                            ToolTip="将新增章节加入下载队列"
                            Click="DownloadUpdateButton_Click" />
                </StackPanel>

                <!-- 统计区（仿 Green DetailPanel） -->
                <Border Background="{DynamicResource HoverBgBrush}" CornerRadius="{DynamicResource RadiusMd}" Padding="12,10" Margin="0,14,0,0" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1">
                    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" HorizontalAlignment="Center"><TextBlock x:Name="StatChapterText" Text="--" FontSize="14" FontWeight="Bold" HorizontalAlignment="Center"/><TextBlock Text="章节" FontSize="10.5" Foreground="{DynamicResource TextSecondaryBrush}" HorizontalAlignment="Center" Margin="0,2,0,0"/></StackPanel>
                        <StackPanel Grid.Column="1" HorizontalAlignment="Center"><TextBlock x:Name="StatImageText" Text="--" FontSize="14" FontWeight="Bold" HorizontalAlignment="Center"/><TextBlock Text="图片" FontSize="10.5" Foreground="{DynamicResource TextSecondaryBrush}" HorizontalAlignment="Center" Margin="0,2,0,0"/></StackPanel>
                    </Grid>
                </Border>
                <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                    <Button Style="{StaticResource PrimaryButtonStyle}" Content="阅读" Padding="14,6" x:Name="ReadButton"/>
                    <Button Style="{StaticResource GhostButtonStyle}" Content="打开目录" Margin="8,0,0,0" Padding="14,6" x:Name="OpenFolderButton"/>
                </StackPanel>
                <!-- 评分与备注 -->
                <Border Height="1" Background="{DynamicResource DividerBrush}" Margin="0,14,0,0" />
                <TextBlock Text="我的评价" FontSize="12.5" FontWeight="SemiBold" Margin="0,14,0,0" />
                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                    <Button x:Name="Star1" Content="★" FontSize="18" Padding="2,0" Background="Transparent" BorderThickness="0" Cursor="Hand" Click="Rating_Click" Tag="1" Foreground="Gray" />
                    <Button x:Name="Star2" Content="★" FontSize="18" Padding="2,0" Background="Transparent" BorderThickness="0" Cursor="Hand" Click="Rating_Click" Tag="2" Foreground="Gray" />
                    <Button x:Name="Star3" Content="★" FontSize="18" Padding="2,0" Background="Transparent" BorderThickness="0" Cursor="Hand" Click="Rating_Click" Tag="3" Foreground="Gray" />
                    <Button x:Name="Star4" Content="★" FontSize="18" Padding="2,0" Background="Transparent" BorderThickness="0" Cursor="Hand" Click="Rating_Click" Tag="4" Foreground="Gray" />
                    <Button x:Name="Star5" Content="★" FontSize="18" Padding="2,0" Background="Transparent" BorderThickness="0" Cursor="Hand" Click="Rating_Click" Tag="5" Foreground="Gray" />
                    <Button x:Name="ClearRatingBtn" Content="清除" Style="{StaticResource GhostButtonStyle}" FontSize="10.5" Padding="6,2" Margin="6,0,0,0" VerticalAlignment="Center" Click="ClearRating_Click" />
                </StackPanel>
                <TextBox x:Name="NotesBox" AcceptsReturn="True" TextWrapping="Wrap"
                         VerticalScrollBarVisibility="Auto" MinHeight="60" MaxHeight="120"
                         FontSize="12" Padding="8,6" Margin="0,8,0,0"
                         Background="{DynamicResource HoverBgBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1"
                         LostFocus="NotesBox_LostFocus" />
                <TextBlock x:Name="SaveHintText" Text="" FontSize="10.5" Foreground="{DynamicResource PrimaryBrush}" Margin="0,4,0,0" />

                <!-- 评论区 -->
                <Border Height="1" Background="{DynamicResource DividerBrush}" Margin="0,14,0,0" />
                <DockPanel Margin="0,14,0,0" LastChildFill="True">
                    <Button DockPanel.Dock="Right" Content="刷新评论" Style="{StaticResource GhostButtonStyle}" Padding="10,4" FontSize="11" Click="RefreshComments_Click" />
                    <TextBlock Text="评论" FontSize="12.5" FontWeight="SemiBold" VerticalAlignment="Center" />
                </DockPanel>
                <TextBlock x:Name="CommentsStatusText" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,6,0,0" Text="暂无评论数据" />
                <ListBox x:Name="CommentsList" Margin="0,8,0,0"
                         Background="Transparent" BorderThickness="0"
                         Height="420" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         ScrollViewer.VerticalScrollBarVisibility="Auto"
                         VirtualizingPanel.IsVirtualizing="True"
                         VirtualizingPanel.VirtualizationMode="Recycling"
                         VirtualizingPanel.ScrollUnit="Pixel">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem" BasedOn="{StaticResource PlainListBoxItemStyle}" />
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border Background="{DynamicResource HoverBgBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="{DynamicResource RadiusSm}" Padding="10,8" Margin="0,0,0,8">
                                <StackPanel>
                                    <DockPanel LastChildFill="False">
                                        <TextBlock Text="{Binding AuthorLine}" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" DockPanel.Dock="Left" />
                                        <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" VerticalAlignment="Center">
                                            <Path Data="{StaticResource IconPopularityLikes}" Fill="{DynamicResource TextDisabledBrush}" Stretch="Uniform" Width="10" Height="10" VerticalAlignment="Center" />
                                            <TextBlock Text="{Binding LikesText}" FontSize="10.5" Foreground="{DynamicResource TextDisabledBrush}" Margin="3,0,0,0" />
                                            <TextBlock Text="{Binding TimeText}" FontSize="10.5" Foreground="{DynamicResource TextDisabledBrush}" Margin="8,0,0,0" />
                                        </StackPanel>
                                    </DockPanel>
                                    <TextBlock Text="{Binding Content}" FontSize="12" TextWrapping="Wrap" Margin="0,6,0,0" />
                                    <ItemsControl ItemsSource="{Binding Replies}" Margin="0,8,0,0">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1,0,0,0" Padding="8,4,0,4" Margin="0,4,0,0">
                                                    <StackPanel>
                                                        <TextBlock Text="{Binding AuthorLine}" FontSize="10.5" Foreground="{DynamicResource TextSecondaryBrush}" FontWeight="SemiBold"/>
                                                        <TextBlock Text="{Binding Content}" FontSize="11" TextWrapping="Wrap" Margin="0,2,0,0" />
                                                    </StackPanel>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                    <ListBox.ItemsPanel>
                        <ItemsPanelTemplate>
                            <VirtualizingStackPanel IsVirtualizing="True" VirtualizationMode="Recycling" ScrollUnit="Pixel" />
                        </ItemsPanelTemplate>
                    </ListBox.ItemsPanel>
                </ListBox>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,4,0,0">
                    <Button x:Name="CommentsPrevButton" Style="{StaticResource GhostButtonStyle}" Content="上一页"
                            Padding="10,3" FontSize="11" Click="CommentsPrevButton_Click" IsEnabled="False" />
                    <TextBlock x:Name="CommentsPagerText" Text="1 / 1" Margin="10,0"
                               VerticalAlignment="Center" FontSize="11"
                               Foreground="{DynamicResource TextSecondaryBrush}" />
                    <Button x:Name="CommentsNextButton" Style="{StaticResource GhostButtonStyle}" Content="下一页"
                            Padding="10,3" FontSize="11" Click="CommentsNextButton_Click" IsEnabled="False" />
                </StackPanel>

                <TextBlock x:Name="PathText" FontSize="10.5" FontFamily="Consolas"
                           Foreground="{DynamicResource TextDisabledBrush}"
                           TextWrapping="Wrap" Margin="0,16,0,0" />
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>

