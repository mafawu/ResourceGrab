<UserControl x:Class="ResourceGrab.App.Views.ChapterView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:ResourceGrab.App.Controls">
    <UserControl.Resources>
        <!-- 章节卡模板（虚拟化网格 ItemTemplate 用；x:Name 需放在资源模板中才能正常注册） -->
        <DataTemplate x:Key="ChapterCardTemplate">
            <Border x:Name="Card" Style="{StaticResource ChapterTileStyle}"
                    MouseLeftButtonDown="ChapterCard_MouseLeftButtonDown">
                <Grid Margin="11,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="8"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Border x:Name="StatusDot" Width="8" Height="8" CornerRadius="4" Background="{DynamicResource TextDisabledBrush}" VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="1" Text="{Binding Title}" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" Margin="9,0,6,0" TextTrimming="CharacterEllipsis"/>
                    <Border Grid.Column="2" x:Name="SelectedCheck" Width="16" Height="16" CornerRadius="{DynamicResource RadiusSm}"
                            Background="{DynamicResource PrimaryBrush}" Visibility="Collapsed" VerticalAlignment="Center">
                        <Path Data="M 0 4 L 4 8 L 9 0" Stroke="White" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <Button Grid.Column="2" x:Name="ReadBtn" Style="{StaticResource IconButtonStyle}" Width="22" Height="22"
                            ToolTip="在线阅读" Command="{Binding ReadCommand}" Visibility="Visible">
                        <Path Data="{StaticResource IconPlay}" Stroke="{DynamicResource TextSecondaryBrush}" StrokeThickness="1.6" Stretch="Uniform" Width="10" Height="10"/>
                    </Button>
                    <TextBlock Grid.Column="2" x:Name="PageCountText"
                               Style="{StaticResource ChapterPageCountTextStyle}"
                               Text="{Binding PageCountText}" />
                </Grid>
            </Border>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsDownloaded}" Value="True">
                    <Setter TargetName="StatusDot" Property="Background" Value="{DynamicResource SuccessBrush}" />
                    <Setter TargetName="ReadBtn" Property="Visibility" Value="Collapsed" />
                    <Setter TargetName="PageCountText" Property="Visibility" Value="Visible" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsDownloading}" Value="True">
                    <Setter TargetName="StatusDot" Property="Background" Value="{DynamicResource PrimaryBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                    <Setter TargetName="Card" Property="Background" Value="{DynamicResource PrimarySubtleBrush}" />
                    <Setter TargetName="Card" Property="BorderBrush" Value="{DynamicResource PrimaryBrush}" />
                    <Setter TargetName="SelectedCheck" Property="Visibility" Value="Visible" />
                    <Setter TargetName="ReadBtn" Property="Visibility" Value="Collapsed" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
    </UserControl.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 头部 -->
        <Border Grid.Row="0" Style="{StaticResource CardPanelStyle}" Margin="20,20,20,0" Padding="18">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid>
                    <Border Width="72" Height="96" CornerRadius="14" Background="{DynamicResource HoverBgBrush}" />
                    <Image x:Name="CoverImage" Width="72" Height="96" Stretch="UniformToFill" />
                </Grid>
                <StackPanel Grid.Column="1" Margin="18,0,0,0" VerticalAlignment="Center">
                    <Grid>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Style="{StaticResource IconButtonStyle}" ToolTip="返回"
                                    Click="BackButton_Click">
                                <Path Data="{StaticResource IconBack}" Stroke="{DynamicResource TextPrimaryBrush}" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Stretch="Uniform" Width="15" Height="15" />
                            </Button>
                            <TextBlock x:Name="HeaderTitle" FontSize="18" FontWeight="Bold"
                                       TextTrimming="CharacterEllipsis" VerticalAlignment="Center"
                                       MaxWidth="520" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <Button x:Name="ReadAllButton" Style="{StaticResource PrimaryButtonStyle}"
                                    Content="在线阅读" Margin="0,0,8,0" IsEnabled="False"
                                    Click="ReadAllButton_Click" />
                        <Button x:Name="FavoriteButton" Style="{StaticResource GhostButtonStyle}"
                                HorizontalAlignment="Right" VerticalAlignment="Center"
                                Click="FavoriteButton_Click">
                            <StackPanel Orientation="Horizontal">
                                <Path x:Name="FavoriteIcon" Data="{StaticResource IconHeart}" Stroke="{DynamicResource TextPrimaryBrush}" StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Stretch="Uniform" Width="13" Height="13" />
                                <TextBlock x:Name="FavoriteText" Text="收藏" Margin="6,0,0,0" />
                            </StackPanel>
                        </Button>
                        </StackPanel>
                    </Grid>
                    <TextBlock x:Name="HeaderMeta" FontSize="12"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               Margin="0,9,0,0" TextTrimming="CharacterEllipsis" />
                    <WrapPanel x:Name="AuthorLinks" Orientation="Horizontal" Visibility="Collapsed" Margin="0,7,10,-2" />
                    <WrapPanel x:Name="TagLinks" Orientation="Horizontal" Visibility="Collapsed" Margin="0,5,10,0" />
                    <TextBlock x:Name="HeaderDesc" FontSize="12"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               TextWrapping="Wrap" MaxHeight="36" TextTrimming="CharacterEllipsis"
                               Margin="0,9,0,0" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- 章节区（框选） -->
        <Grid Grid.Row="1" Margin="20,14,20,0" x:Name="ChaptersLayer"
              PreviewMouseLeftButtonDown="ChaptersLayer_PreviewMouseLeftButtonDown"
              PreviewMouseMove="ChaptersLayer_PreviewMouseMove"
              PreviewMouseLeftButtonUp="ChaptersLayer_PreviewMouseLeftButtonUp">
            <Grid.ContextMenu>
                <ContextMenu>
                    <MenuItem Header="下载选中章节" Click="ContextDownloadSelected_Click" />
                    <MenuItem Header="全选" Click="SelectAllButton_Click" />
                    <MenuItem Header="清除选择" Click="ClearButton_Click" />
                    <Separator />
                    <MenuItem Header="下载全部章节" Click="DownloadAllButton_Click" />
                </ContextMenu>
            </Grid.ContextMenu>

            <!-- 章节列表：虚拟化网格（只实例化可视行），框选命中由代码按固定单元格做行列换算 -->
            <controls:VirtualizedCardGrid x:Name="ChapterItems" SlotWidth="178"
                                          ItemTemplate="{StaticResource ChapterCardTemplate}" />

            <Canvas x:Name="SelectionCanvas" IsHitTestVisible="False" ClipToBounds="True">
                <Rectangle x:Name="SelectionRect" Visibility="Collapsed"
                           Fill="{DynamicResource SelectionBgBrush}"
                           Stroke="{DynamicResource PrimaryBrush}"
                           StrokeThickness="1.2" RadiusX="4" RadiusY="4" />
            </Canvas>

            <StackPanel x:Name="LoadingPanel" VerticalAlignment="Center" HorizontalAlignment="Center"
                        Background="{DynamicResource AppBackgroundBrush}">
                <TextBlock Text="加载中…" FontSize="14"
                           Foreground="{DynamicResource TextSecondaryBrush}" Margin="20,12" />
            </StackPanel>
        </Grid>

        <!-- 底部操作栏 -->
        <Border Grid.Row="2" Style="{StaticResource CardPanelStyle}" Margin="20,0,20,20" Padding="16,12">
            <Grid>
                <StackPanel Orientation="Horizontal">
                    <TextBlock x:Name="SelectedText" Text="未选择章节" FontSize="12.5"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               VerticalAlignment="Center" />
                    <Button Style="{StaticResource GhostButtonStyle}" Content="全选"
                            Margin="14,0,0,0" Click="SelectAllButton_Click" />
                    <Button Style="{StaticResource GhostButtonStyle}" Content="清除"
                            Margin="8,0,0,0" Click="ClearButton_Click" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button x:Name="DownloadSelectedButton" Style="{StaticResource PrimaryButtonStyle}"
                            Content="下载选中" Click="DownloadSelectedButton_Click" />
                    <Button Style="{StaticResource GhostButtonStyle}" Content="下载全部"
                            Margin="8,0,0,0" Click="DownloadAllButton_Click" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>


