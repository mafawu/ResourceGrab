<UserControl x:Class="ResourceGrab.App.Views.ChapterView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:ResourceGrab.App.Controls">
    <UserControl.Resources>
        <!-- 章节卡模板（虚拟化网格 ItemTemplate 用；x:Name 需放在资源模板中才能正常注册） -->
        <DataTemplate x:Key="ChapterCardTemplate">
            <Border x:Name="Card" Style="{StaticResource ChapterTileStyle}"
                    MouseLeftButtonDown="ChapterCard_MouseLeftButtonDown">
                <Grid Margin="11,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="8"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Border x:Name="StatusDot" Width="8" Height="8" CornerRadius="4" Background="{DynamicResource TextDisabledBrush}" VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="1" Text="{Binding Title}" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" Margin="9,0,6,0" TextTrimming="CharacterEllipsis"/>
                    <Border Grid.Column="2" x:Name="SelectedCheck" Width="16" Height="16" CornerRadius="{DynamicResource RadiusSm}"
                            Background="{DynamicResource PrimaryBrush}" Visibility="Collapsed" VerticalAlignment="Center">
                        <Path Data="M 0 4 L 4 8 L 9 0" Stroke="White" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <Button Grid.Column="2" x:Name="ReadBtn" Style="{StaticResource IconButtonStyle}" Width="22" Height="22"
                            ToolTip="在线阅读" Command="{Binding ReadCommand}" Visibility="Visible">
                        <Path Data="{StaticResource IconPlay}" Stroke="{DynamicResource TextSecondaryBrush}" StrokeThickness="1.6" Stretch="Uniform" Width="10" Height="10"/>
                    </Button>
                    <TextBlock Grid.Column="2" x:Name="PageCountText"
                               Style="{StaticResource ChapterPageCountTextStyle}"
                               Text="{Binding PageCountText}" />
                </Grid>
            </Border>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsDownloaded}" Value="True">
                    <Setter TargetName="StatusDot" Property="Background" Value="{DynamicResource SuccessBrush}" />
                    <Setter TargetName="ReadBtn" Property="Visibility" Value="Collapsed" />
                    <Setter TargetName="PageCountText" Property="Visibility" Value="Visible" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsDownloading}" Value="True">
                    <Setter TargetName="StatusDot" Property="Background" Value="{DynamicResource PrimaryBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                    <Setter TargetName="Card" Property="Background" Value="{DynamicResource PrimarySubtleBrush}" />
                    <Setter TargetName="Card" Property="BorderBrush" Value="{DynamicResource PrimaryBrush}" />
                    <Setter TargetName="SelectedCheck" Property="Visibility" Value="Visible" />
                    <Setter TargetName="ReadBtn" Property="Visibility" Value="Collapsed" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
    </UserControl.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 头部 -->
        <Border Grid.Row="0" Style="{StaticResource CardPanelStyle}" Margin="20,20,20,0" Padding="18">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid>
                    <Border Width="72" Height="96" CornerRadius="14" Background="{DynamicResource HoverBgBrush}" />
                    <Image x:Name="CoverImage" Width="72" Height="96" Stretch="UniformToFill" />
                </Grid>
                <StackPanel Grid.Column="1" Margin="18,0,0,0" VerticalAlignment="Center">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0" Style="{StaticResource IconButtonStyle}" ToolTip="返回"
                                VerticalAlignment="Center"
                                Click="BackButton_Click">
                            <Path Data="{StaticResource IconBack}" Stroke="{DynamicResource TextPrimaryBrush}" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Stretch="Uniform" Width="15" Height="15" />
                        </Button>
                        <!-- 标题占满剩余宽度：长标题自动换行，可拖选复制 -->
                        <TextBox Grid.Column="1" x:Name="HeaderTitle" Style="{StaticResource SelectableTextStyle}"
                                 FontSize="18" FontWeight="Bold" Margin="9,0,12,0"
                                 VerticalAlignment="Center" />
                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button x:Name="CommentsToggleButton" Style="{StaticResource GhostButtonStyle}"
                                    Content="评论" Margin="0,0,8,0" Visibility="Collapsed"
                                    ToolTip="查看 / 复制本作评论"
                                    Click="CommentsToggleButton_Click" />
                            <Button x:Name="ReadAllButton" Style="{StaticResource PrimaryButtonStyle}"
                                    Content="在线阅读" Margin="0,0,8,0" IsEnabled="False"
                                    Click="ReadAllButton_Click" />
                        <Button x:Name="FavoriteButton" Style="{StaticResource GhostButtonStyle}"
                                HorizontalAlignment="Right" VerticalAlignment="Center"
                                Click="FavoriteButton_Click">
                            <StackPanel Orientation="Horizontal">
                                <Path x:Name="FavoriteIcon" Data="{StaticResource IconHeart}" Stroke="{DynamicResource TextPrimaryBrush}" StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Stretch="Uniform" Width="13" Height="13" />
                                <TextBlock x:Name="FavoriteText" Text="收藏" Margin="6,0,0,0" />
                            </StackPanel>
                        </Button>
                        </StackPanel>
                    </Grid>
                    <TextBlock x:Name="HeaderMeta" FontSize="12"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               Margin="0,9,0,0" TextTrimming="CharacterEllipsis" />
                    <WrapPanel x:Name="AuthorLinks" Orientation="Horizontal" Visibility="Collapsed" Margin="0,7,10,-2" />
                    <WrapPanel x:Name="TagLinks" Orientation="Horizontal" Visibility="Collapsed" Margin="0,5,10,0" />
                    <TextBox x:Name="HeaderDesc" Style="{StaticResource SelectableTextStyle}"
                             FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}"
                             MaxHeight="36" Margin="0,9,0,0" />

                    <!-- 评论区（仅支持 ICommentSource 的源显示，如禁漫） -->
                    <Border x:Name="CommentsPanel" Visibility="Collapsed"
                            Background="{DynamicResource HoverBgBrush}"
                            BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1"
                            CornerRadius="{DynamicResource RadiusMd}" Padding="12,10"
                            Margin="0,10,0,-4" MaxHeight="340">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <DockPanel Grid.Row="0" LastChildFill="True">
                                <Button DockPanel.Dock="Right" x:Name="CommentsRefreshButton" Content="刷新"
                                        Style="{StaticResource GhostButtonStyle}" Padding="10,3" FontSize="11"
                                        Click="CommentsRefreshButton_Click" />
                                <Button DockPanel.Dock="Right" x:Name="CommentsCopyAllButton" Content="复制全部"
                                        Style="{StaticResource GhostButtonStyle}" Padding="10,3" FontSize="11"
                                        Margin="0,0,6,0"
                                        Click="CommentsCopyAllButton_Click" />
                                <TextBlock Text="评论" FontSize="12.5" FontWeight="SemiBold" VerticalAlignment="Center" />
                            </DockPanel>
                            <TextBlock Grid.Row="1" x:Name="CommentsStatusText" FontSize="11"
                                       Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap"
                                       Margin="0,6,0,0" Text="暂无评论" />
                            <ListBox Grid.Row="2" x:Name="CommentsList" Margin="0,6,0,0"
                                     Background="Transparent" BorderThickness="0"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                     ScrollViewer.VerticalScrollBarVisibility="Auto"
                                     VirtualizingPanel.IsVirtualizing="True"
                                     VirtualizingPanel.VirtualizationMode="Recycling"
                                     VirtualizingPanel.ScrollUnit="Pixel">
                                <ListBox.ItemContainerStyle>
                                    <Style TargetType="ListBoxItem" BasedOn="{StaticResource PlainListBoxItemStyle}" />
                                </ListBox.ItemContainerStyle>
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="{DynamicResource SurfaceBrush}"
                                                BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1"
                                                CornerRadius="{DynamicResource RadiusSm}" Padding="10,8" Margin="0,0,0,8">
                                            <Border.ContextMenu>
                                                <ContextMenu>
                                                    <MenuItem Header="复制评论" Click="CopyComment_Click" />
                                                </ContextMenu>
                                            </Border.ContextMenu>
                                            <StackPanel>
                                                <DockPanel LastChildFill="False">
                                                    <TextBlock Text="{Binding AuthorLine}" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" DockPanel.Dock="Left" />
                                                    <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" VerticalAlignment="Center">
                                                        <Path Data="{StaticResource IconPopularityLikes}" Fill="{DynamicResource TextDisabledBrush}" Stretch="Uniform" Width="10" Height="10" VerticalAlignment="Center" />
                                                        <TextBlock Text="{Binding LikesText}" FontSize="10.5" Foreground="{DynamicResource TextDisabledBrush}" Margin="3,0,0,0" />
                                                        <TextBlock Text="{Binding TimeText}" FontSize="10.5" Foreground="{DynamicResource TextDisabledBrush}" Margin="8,0,0,0" />
                                                    </StackPanel>
                                                </DockPanel>
                                                <TextBox Text="{Binding Content}" Style="{StaticResource SelectableTextStyle}"
                                                         FontSize="12" Margin="0,6,0,0" ContextMenu="{x:Null}" />
                                                <ItemsControl ItemsSource="{Binding Replies}" Margin="0,8,0,0">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <Border BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1,0,0,0" Padding="8,4,0,4" Margin="0,4,0,0">
                                                                <Border.ContextMenu>
                                                                    <ContextMenu>
                                                                        <MenuItem Header="复制评论" Click="CopyComment_Click" />
                                                                    </ContextMenu>
                                                                </Border.ContextMenu>
                                                                <StackPanel>
                                                                    <TextBlock Text="{Binding AuthorLine}" FontSize="10.5" Foreground="{DynamicResource TextSecondaryBrush}" FontWeight="SemiBold"/>
                                                                    <TextBox Text="{Binding Content}" Style="{StaticResource SelectableTextStyle}"
                                                                             FontSize="11" Margin="0,2,0,0" ContextMenu="{x:Null}" />
                                                                </StackPanel>
                                                            </Border>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                                <ListBox.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <VirtualizingStackPanel IsVirtualizing="True" VirtualizationMode="Recycling" ScrollUnit="Pixel" />
                                    </ItemsPanelTemplate>
                                </ListBox.ItemsPanel>
                            </ListBox>
                            <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,6,0,0">
                                <Button x:Name="CommentsPrevButton" Style="{StaticResource GhostButtonStyle}" Content="上一页"
                                        Padding="10,3" FontSize="11" Click="CommentsPrevButton_Click" IsEnabled="False" />
                                <TextBlock x:Name="CommentsPagerText" Text="1 / 1" Margin="10,0"
                                           VerticalAlignment="Center" FontSize="11"
                                           Foreground="{DynamicResource TextSecondaryBrush}" />
                                <Button x:Name="CommentsNextButton" Style="{StaticResource GhostButtonStyle}" Content="下一页"
                                        Padding="10,3" FontSize="11" Click="CommentsNextButton_Click" IsEnabled="False" />
                            </StackPanel>
                        </Grid>
                    </Border>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 章节区（框选） -->
        <Grid Grid.Row="1" Margin="20,14,20,0" x:Name="ChaptersLayer"
              PreviewMouseLeftButtonDown="ChaptersLayer_PreviewMouseLeftButtonDown"
              PreviewMouseMove="ChaptersLayer_PreviewMouseMove"
              PreviewMouseLeftButtonUp="ChaptersLayer_PreviewMouseLeftButtonUp">
            <Grid.ContextMenu>
                <ContextMenu>
                    <MenuItem Header="下载选中章节" Click="ContextDownloadSelected_Click" />
                    <MenuItem Header="全选" Click="SelectAllButton_Click" />
                    <MenuItem Header="清除选择" Click="ClearButton_Click" />
                    <Separator />
                    <MenuItem Header="下载全部章节" Click="DownloadAllButton_Click" />
                </ContextMenu>
            </Grid.ContextMenu>

            <!-- 章节列表：虚拟化网格（只实例化可视行），框选命中由代码按固定单元格做行列换算 -->
            <controls:VirtualizedCardGrid x:Name="ChapterItems" SlotWidth="178"
                                          ItemTemplate="{StaticResource ChapterCardTemplate}" />

            <Canvas x:Name="SelectionCanvas" IsHitTestVisible="False" ClipToBounds="True">
                <Rectangle x:Name="SelectionRect" Visibility="Collapsed"
                           Fill="{DynamicResource SelectionBgBrush}"
                           Stroke="{DynamicResource PrimaryBrush}"
                           StrokeThickness="1.2" RadiusX="4" RadiusY="4" />
            </Canvas>

            <StackPanel x:Name="LoadingPanel" VerticalAlignment="Center" HorizontalAlignment="Center"
                        Background="{DynamicResource AppBackgroundBrush}">
                <TextBlock Text="加载中…" FontSize="14"
                           Foreground="{DynamicResource TextSecondaryBrush}" Margin="20,12" />
            </StackPanel>
        </Grid>

        <!-- 底部操作栏 -->
        <Border Grid.Row="2" Style="{StaticResource CardPanelStyle}" Margin="20,0,20,20" Padding="16,12">
            <Grid>
                <StackPanel Orientation="Horizontal">
                    <TextBlock x:Name="SelectedText" Text="未选择章节" FontSize="12.5"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               VerticalAlignment="Center" />
                    <Button Style="{StaticResource GhostButtonStyle}" Content="全选"
                            Margin="14,0,0,0" Click="SelectAllButton_Click" />
                    <Button Style="{StaticResource GhostButtonStyle}" Content="清除"
                            Margin="8,0,0,0" Click="ClearButton_Click" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button x:Name="DownloadSelectedButton" Style="{StaticResource PrimaryButtonStyle}"
                            Content="下载选中" Click="DownloadSelectedButton_Click" />
                    <Button Style="{StaticResource GhostButtonStyle}" Content="下载全部"
                            Margin="8,0,0,0" Click="DownloadAllButton_Click" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>


