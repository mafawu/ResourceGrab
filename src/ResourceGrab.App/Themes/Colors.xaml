<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- ================================================================
         DSO UI · 浅色（Daylight）
         Quiet Capture：中性冷灰画布 + 单一靛蓝强调色 + 发丝级描边。
         颜色只承担层级，不承担装饰；阴影极轻，靠留白和描边分层。
         ================================================================ -->
    <SolidColorBrush x:Key="AppBackgroundBrush" Color="#F5F7FB" />
    <SolidColorBrush x:Key="AppBackgroundTopBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="AppBackgroundBottomBrush" Color="#F5F7FB" />
    <SolidColorBrush x:Key="SurfaceBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="CardBorderBrush" Color="#E6EAF2" />
    <SolidColorBrush x:Key="DividerBrush" Color="#EDF0F7" />
    <SolidColorBrush x:Key="DividerStrongBrush" Color="#DCE2EE" />
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="#10141F" />
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#5C667A" />
    <SolidColorBrush x:Key="TextDisabledBrush" Color="#9AA3B4" />
    <SolidColorBrush x:Key="PrimaryBrush" Color="#4D6BFE" />
    <SolidColorBrush x:Key="PrimaryHoverBrush" Color="#3E5BF0" />
    <SolidColorBrush x:Key="PrimaryPressedBrush" Color="#2F47CC" />
    <SolidColorBrush x:Key="PrimaryFgBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="PrimaryLightBrush" Color="#7A93FF" />
    <SolidColorBrush x:Key="PrimarySubtleBrush" Color="#EEF1FF" />
    <SolidColorBrush x:Key="PrimaryGradientStartBrush" Color="#5B7BFF" />
    <SolidColorBrush x:Key="PrimaryGradientEndBrush" Color="#3F53E8" />
    <SolidColorBrush x:Key="DangerBrush" Color="#E5484D" />
    <SolidColorBrush x:Key="SuccessBrush" Color="#12B981" />
    <SolidColorBrush x:Key="WarningBrush" Color="#F5A524" />
    <SolidColorBrush x:Key="WarningSubtleBrush" Color="#FFF4E0" />
    <SolidColorBrush x:Key="NovelAccentBrush" Color="#7C5CFF" />
    <SolidColorBrush x:Key="VideoAccentBrush" Color="#12B981" />
    <SolidColorBrush x:Key="PhotobookAccentBrush" Color="#E08A1E" />
    <SolidColorBrush x:Key="PhotobookSubtleBrush" Color="#FFF5E6" />
    <SolidColorBrush x:Key="CardScrimBrush" Color="#66000000" />
    <SolidColorBrush x:Key="CardOverlayPanelBrush" Color="#B3000000" />
    <SolidColorBrush x:Key="CardBadgeScrimBrush" Color="#B810141F" />
    <SolidColorBrush x:Key="OnMediaBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="OnMediaSecondaryBrush" Color="#E6FFFFFF" />
    <SolidColorBrush x:Key="SelectionPanelBrush" Color="#F2FFFFFF" />
    <SolidColorBrush x:Key="DangerSubtleBrush" Color="#1AE5484D" />
    <Color x:Key="CardScrimColor">#66000000</Color>
    <SolidColorBrush x:Key="InputBorderBrush" Color="#DDE3EF" />
    <SolidColorBrush x:Key="InputFocusBrush" Color="#4D6BFE" />
    <SolidColorBrush x:Key="FocusGlowBrush" Color="#334D6BFE" />
    <SolidColorBrush x:Key="HoverBgBrush" Color="#0D101828" />
    <!-- 阅读器衬底：白页要在这层上「浮起来」。与纯白页面的对比需 ≥1.4:1，长时间阅读才分得清页面边界。 -->
    <SolidColorBrush x:Key="ReaderBackdropBrush" Color="#D3D8E3" />
    <SolidColorBrush x:Key="ActiveNavBgBrush" Color="#144D6BFE" />
    <SolidColorBrush x:Key="SelectionBgBrush" Color="#1F4D6BFE" />
    <SolidColorBrush x:Key="ScrollbarThumbBrush" Color="#3D98A2B4" />
    <SolidColorBrush x:Key="ScrollbarThumbHoverBrush" Color="#6698A2B4" />
    <SolidColorBrush x:Key="OverlayBrush" Color="#40000000" />
    <SolidColorBrush x:Key="WindowControlHoverBrush" Color="#0D101828" />
    <SolidColorBrush x:Key="CardHoverBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="CardHoverBorderBrush" Color="#C7D2FE" />
    <SolidColorBrush x:Key="CardShadowBrush" Color="#14101828" />
    <SolidColorBrush x:Key="CardHoverShadowBrush" Color="#1A4D6BFE" />
    <SolidColorBrush x:Key="SkeletonBrush" Color="#EDF0F7" />
    <SolidColorBrush x:Key="SnackbarBgBrush" Color="#F2FFFFFF" />
    <SolidColorBrush x:Key="TextLinkBrush" Color="#3E5BF0" />
    <Color x:Key="CardShadowColor">#14101828</Color>
    <Color x:Key="PrimaryGlowColor">#334D6BFE</Color>
    <Color x:Key="PrimaryGradientStartColor">#5B7BFF</Color>
    <Color x:Key="PrimaryGradientEndColor">#3F53E8</Color>
    <Color x:Key="PrimaryHoverColor">#3E5BF0</Color>
    <Color x:Key="PrimaryPressedColor">#2F47CC</Color>
    <Color x:Key="AppBackgroundTopColor">#FFFFFF</Color>
    <Color x:Key="AppBackgroundBottomColor">#F5F7FB</Color>
    <LinearGradientBrush x:Key="WindowBorderBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#E6EAF2" Offset="0" />
        <GradientStop Color="#E2E8F5" Offset="0.5" />
        <GradientStop Color="#EAEEF8" Offset="1" />
    </LinearGradientBrush>
</ResourceDictionary>
