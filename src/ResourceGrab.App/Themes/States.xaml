<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:controls="clr-namespace:ResourceGrab.App.Controls">
    <DataTemplate x:Key="ComicCardResultTemplate">
        <controls:VirtualizedCardGrid ItemsSource="{Binding Result, RelativeSource={RelativeSource AncestorType=controls:StateHostControl}}"
                                      SlotWidth="{Binding SlotWidth, RelativeSource={RelativeSource AncestorType=controls:StateHostControl}}"
                                      DesiredColumns="{Binding DesiredColumns, RelativeSource={RelativeSource AncestorType=controls:StateHostControl}}"
                                      CardWidth="{Binding CardWidth, RelativeSource={RelativeSource AncestorType=controls:StateHostControl}}">
            <controls:VirtualizedCardGrid.ItemTemplate>
                <DataTemplate>
                    <controls:AlbumCard Width="{Binding CardWidth, RelativeSource={RelativeSource AncestorType=controls:VirtualizedCardGrid}}" />
                </DataTemplate>
            </controls:VirtualizedCardGrid.ItemTemplate>
        </controls:VirtualizedCardGrid>
    </DataTemplate>

    <!-- 短剧：4:5 竖版卡，与漫画卡共用同一套状态机与虚拟化网格 -->
    <DataTemplate x:Key="DramaCardResultTemplate">
        <controls:VirtualizedCardGrid ItemsSource="{Binding Result, RelativeSource={RelativeSource AncestorType=controls:StateHostControl}}"
                                      SlotWidth="{Binding SlotWidth, RelativeSource={RelativeSource AncestorType=controls:StateHostControl}}"
                                      DesiredColumns="{Binding DesiredColumns, RelativeSource={RelativeSource AncestorType=controls:StateHostControl}}"
                                      CardWidth="{Binding CardWidth, RelativeSource={RelativeSource AncestorType=controls:StateHostControl}}">
            <controls:VirtualizedCardGrid.ItemTemplate>
                <DataTemplate>
                    <controls:MediaCard Width="{Binding CardWidth, RelativeSource={RelativeSource AncestorType=controls:VirtualizedCardGrid}}" />
                </DataTemplate>
            </controls:VirtualizedCardGrid.ItemTemplate>
        </controls:VirtualizedCardGrid>
    </DataTemplate>

    <!-- 在线小说：3:4 竖版卡。书名在封面下方（不是压在封面上），
         右上状态、右下「✓ 本地」——单一类型列表里类型徽标是噪音，让位给状态。 -->
    <DataTemplate x:Key="NovelCardItemTemplate">
        <DataTemplate.Resources>
            <controls:MultiplyConverter x:Key="NovelCoverRatio" />
        </DataTemplate.Resources>
        <Button Command="{Binding OpenCommand}" Cursor="Hand" Focusable="False"
                Background="Transparent" BorderThickness="0" HorizontalContentAlignment="Stretch"
                ToolTip="{Binding Title}">
            <Button.Template>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Root" CornerRadius="{DynamicResource RadiusLg}"
                            Background="{DynamicResource SurfaceBrush}"
                            BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1"
                            ClipToBounds="True">
                        <StackPanel>
                            <Grid Height="{Binding CardWidth, RelativeSource={RelativeSource AncestorType=controls:VirtualizedCardGrid}, Converter={StaticResource NovelCoverRatio}, ConverterParameter=1.3333}">
                                <Border Background="{DynamicResource HoverBgBrush}">
                                    <TextBlock Text="{Binding CoverFallbackText}"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"
                                               FontSize="34" FontWeight="Bold"
                                               Foreground="{DynamicResource TextDisabledBrush}" />
                                </Border>
                                <Image Source="{Binding Cover}" Stretch="UniformToFill" />
                                <!-- 状态：连载中 / 已完结 -->
                                <Border HorizontalAlignment="Right" VerticalAlignment="Top" Margin="6"
                                        CornerRadius="{DynamicResource RadiusXs}" Padding="6,2"
                                        Background="#8C0B0E14">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Visibility" Value="Visible" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding StatusText}" Value="">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <TextBlock Text="{Binding StatusText}" FontSize="10" FontWeight="SemiBold"
                                               Foreground="White" />
                                </Border>
                                <!-- 右下角状态条：在线卡是「✓ 本地」，书架卡是阅读进度 -->
                                <Border HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="6"
                                        CornerRadius="{DynamicResource RadiusXs}" Padding="6,2"
                                        Background="#B30B0E14">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Visibility" Value="Visible" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding BadgeText}" Value="">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <TextBlock Text="{Binding BadgeText}" FontSize="10" FontWeight="SemiBold"
                                               Foreground="{Binding BadgeColor}" />
                                </Border>
                            </Grid>
                            <StackPanel Margin="2,9,2,2">
                                <TextBlock Text="{Binding Title}" FontSize="13.5" FontWeight="SemiBold"
                                           TextTrimming="CharacterEllipsis" Foreground="{DynamicResource TextPrimaryBrush}" />
                                <TextBlock Text="{Binding Subtitle}" FontSize="11.5" Margin="0,4,0,0"
                                           TextTrimming="CharacterEllipsis" Foreground="{DynamicResource TextSecondaryBrush}" />
                            </StackPanel>
                        </StackPanel>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Root" Property="BorderBrush" Value="{DynamicResource CardHoverBorderBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Button.Template>
        </Button>
    </DataTemplate>

    <DataTemplate x:Key="NovelCardResultTemplate">
        <controls:VirtualizedCardGrid ItemsSource="{Binding Result, RelativeSource={RelativeSource AncestorType=controls:StateHostControl}}"
                                      SlotWidth="{Binding SlotWidth, RelativeSource={RelativeSource AncestorType=controls:StateHostControl}}"
                                      DesiredColumns="{Binding DesiredColumns, RelativeSource={RelativeSource AncestorType=controls:StateHostControl}}"
                                      CardWidth="{Binding CardWidth, RelativeSource={RelativeSource AncestorType=controls:StateHostControl}}">
            <controls:VirtualizedCardGrid.ItemTemplate>
                <DataTemplate>
                    <ContentControl Width="{Binding CardWidth, RelativeSource={RelativeSource AncestorType=controls:VirtualizedCardGrid}}"
                                    Content="{Binding}"
                                    ContentTemplate="{StaticResource NovelCardItemTemplate}" />
                </DataTemplate>
            </controls:VirtualizedCardGrid.ItemTemplate>
        </controls:VirtualizedCardGrid>
    </DataTemplate>

    <!-- StateHostControl 的完整状态模板集中管理。 -->
<DataTemplate x:Key="HintTemplate">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                <Border Width="80" Height="80" CornerRadius="{StaticResource CardCornerRadius}"
                        Background="{DynamicResource PrimarySubtleBrush}">
                    <Path Data="{Binding HintIcon, RelativeSource={RelativeSource AncestorType=controls:StateHostControl}}"
                          Stroke="{DynamicResource PrimaryBrush}" StrokeThickness="2.2"
                          StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                          Stretch="Uniform" Width="30" Height="30"
                          HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <TextBlock Text="{Binding HintTitle, RelativeSource={RelativeSource AncestorType=controls:StateHostControl}}"
                           FontSize="15" FontWeight="SemiBold" Margin="0,18,0,0"
                           HorizontalAlignment="Center" />
                <TextBlock Text="{Binding HintDescription, RelativeSource={RelativeSource AncestorType=controls:StateHostControl}}"
                           FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,6,0,0"
                           HorizontalAlignment="Center" TextWrapping="Wrap" MaxWidth="360" />
            </StackPanel>
        </DataTemplate>

        <DataTemplate x:Key="LoadingTemplate">
            <controls:LoadingIndicator VerticalAlignment="Center" HorizontalAlignment="Center"
                                       RingSize="44"
                                       Text="{Binding LoadingText, RelativeSource={RelativeSource AncestorType=controls:StateHostControl}}" />
        </DataTemplate>

        <DataTemplate x:Key="EmptyTemplate">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                <Border Width="72" Height="72" CornerRadius="24"
                        Background="{DynamicResource HoverBgBrush}">
                    <Path Data="{StaticResource IconDocument}" Stroke="{DynamicResource TextDisabledBrush}"
                          StrokeThickness="2.2" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                          StrokeLineJoin="Round" Stretch="Uniform" Width="26" Height="26"
                          HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <TextBlock Text="{Binding EmptyTitle, RelativeSource={RelativeSource AncestorType=controls:StateHostControl}}"
                           FontSize="15" FontWeight="SemiBold" Margin="0,16,0,0" HorizontalAlignment="Center" />
                <TextBlock Text="{Binding EmptyDescription, RelativeSource={RelativeSource AncestorType=controls:StateHostControl}}"
                           FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,6,0,0"
                           HorizontalAlignment="Center" TextWrapping="Wrap" MaxWidth="360" />
            </StackPanel>
        </DataTemplate>

        <DataTemplate x:Key="ErrorTemplate">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                <Border Width="72" Height="72" CornerRadius="24"
                        Background="{DynamicResource HoverBgBrush}">
                    <Path Data="{StaticResource IconInfo}" Stroke="{DynamicResource DangerBrush}"
                          StrokeThickness="2.2" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                          StrokeLineJoin="Round" Stretch="Uniform" Width="26" Height="26"
                          HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <TextBlock Text="{Binding ErrorTitle, RelativeSource={RelativeSource AncestorType=controls:StateHostControl}}"
                           FontSize="15" FontWeight="SemiBold" Margin="0,16,0,0" HorizontalAlignment="Center" />
                <TextBlock Text="{Binding ErrorDescription, RelativeSource={RelativeSource AncestorType=controls:StateHostControl}}"
                           FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,6,0,0"
                           HorizontalAlignment="Center" TextWrapping="Wrap" MaxWidth="360" />
                <Button Style="{StaticResource PillGhostButtonStyle}"
                        Content="{Binding RetryText, RelativeSource={RelativeSource AncestorType=controls:StateHostControl}}"
                        Command="{Binding RetryCommand, RelativeSource={RelativeSource AncestorType=controls:StateHostControl}}"
                        Margin="0,18,0,0" HorizontalAlignment="Center" />
            </StackPanel>
        </DataTemplate>

        <Style x:Key="UnifiedStateHostStyle" TargetType="ContentControl">
            <Setter Property="Focusable" Value="False" />
            <Setter Property="ContentTemplate" Value="{StaticResource HintTemplate}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding State, RelativeSource={RelativeSource AncestorType=controls:StateHostControl}}" Value="Loading">
                    <Setter Property="ContentTemplate" Value="{StaticResource LoadingTemplate}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding State, RelativeSource={RelativeSource AncestorType=controls:StateHostControl}}" Value="Empty">
                    <Setter Property="ContentTemplate" Value="{StaticResource EmptyTemplate}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding State, RelativeSource={RelativeSource AncestorType=controls:StateHostControl}}" Value="Error">
                    <Setter Property="ContentTemplate" Value="{StaticResource ErrorTemplate}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding State, RelativeSource={RelativeSource AncestorType=controls:StateHostControl}}" Value="Result">
                    <Setter Property="ContentTemplate">
                        <Setter.Value>
                            <DataTemplate>
                                <ContentPresenter Content="{Binding Result, RelativeSource={RelativeSource AncestorType=controls:StateHostControl}}"
                                                  ContentTemplate="{Binding ResultTemplate, RelativeSource={RelativeSource AncestorType=controls:StateHostControl}}" />
                            </DataTemplate>
                        </Setter.Value>
                    </Setter>
                </DataTrigger>
            </Style.Triggers>
        </Style>
</ResourceDictionary>
