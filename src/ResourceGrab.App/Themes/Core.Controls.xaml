  <Style x:Key="ModernCheckBoxStyle" TargetType="{x:Type CheckBox}">
    <Setter Property="FontFamily" Value="Microsoft YaHei UI, Segoe UI" />
    <Setter Property="FontSize" Value="13" />
    <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
    <Setter Property="FrameworkElement.Cursor" Value="Hand" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type CheckBox}">
          <StackPanel Orientation="Horizontal" Background="#00FFFFFF">
            <Border Name="Box" Width="18" Height="18" CornerRadius="6" Background="#00FFFFFF" BorderBrush="{DynamicResource InputBorderBrush}" BorderThickness="1.5" VerticalAlignment="Center">
              <!-- 勾：按 18×18 方框坐标直接绘制（短臂/长臂同为 ~45°），Stretch=None 保持 2px 描边不被缩放，
                   并显式居中——此前未设对齐且未设尺寸，勾会贴方框左上角渲染且两臂角度不一致，看起来是歪的。 -->
              <Path Name="Check" Data="M3.8,9.2 L7.1,12.5 L14.2,5.1" Stroke="#FFFFFFFF" StrokeThickness="2"
                    StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                    HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed" />
            </Border>
            <ContentPresenter Margin="8,0,0,0" VerticalAlignment="Center" />
          </StackPanel>
          <ControlTemplate.Triggers>
            <Trigger Property="ToggleButton.IsChecked" Value="True">
              <Setter TargetName="Box" Value="{DynamicResource PrimaryBrush}" Property="Border.Background" />
              <Setter TargetName="Box" Value="{DynamicResource PrimaryBrush}" Property="Border.BorderBrush" />
              <Setter TargetName="Check" Property="Visibility" Value="Visible" />
            </Trigger>
            <Trigger Property="UIElement.IsMouseOver" Value="True">
              <Setter TargetName="Box" Value="{DynamicResource PrimaryBrush}" Property="Border.BorderBrush" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="UIElement.Opacity" Value="0.45" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
