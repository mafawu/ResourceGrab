<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Style x:Key="LibraryCardBaseStyle" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource CardBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource CardCornerRadius}" />
        <Setter Property="Cursor" Value="Hand" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="BorderBrush" Value="{DynamicResource PrimaryBrush}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="ComicCardBorderStyle" TargetType="Border"
           BasedOn="{StaticResource LibraryCardBaseStyle}" />

    <Style x:Key="LocalComicCardBorderStyle" TargetType="Border"
           BasedOn="{StaticResource LibraryCardBaseStyle}">
    </Style>

    <Style x:Key="VideoFileCardBorderStyle" TargetType="Border"
           BasedOn="{StaticResource LibraryCardBaseStyle}">
        <Setter Property="CornerRadius" Value="12,12,0,0" />
    </Style>

    <Style x:Key="CompactCardBorderStyle" TargetType="Border"
           BasedOn="{StaticResource LibraryCardBaseStyle}">
        <Setter Property="CornerRadius" Value="{StaticResource ControlCornerRadius}" />
        <Setter Property="Margin" Value="0,0,14,14" />
    </Style>

    <Style x:Key="KindBadgeBorderStyle" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource PrimaryBrush}" />
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="Padding" Value="6,2" />
    </Style>

    <Style x:Key="KindBadgeTextStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="10" />
        <Setter Property="Foreground" Value="{DynamicResource OnMediaBrush}" />
        <Setter Property="FontWeight" Value="Bold" />
    </Style>

    <Style x:Key="MediaOverlayBadgeStyle" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource CardScrimBrush}" />
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="Padding" Value="6,2" />
    </Style>

    <Style x:Key="NovelProgressFillStyle" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource NovelAccentBrush}" />
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="CornerRadius" Value="2" />
    </Style>

    <Style x:Key="ChapterTileStyle" TargetType="Border"
           BasedOn="{StaticResource LibraryCardBaseStyle}">
        <Setter Property="Width" Value="168" />
        <Setter Property="Height" Value="42" />
        <Setter Property="Margin" Value="0,0,10,10" />
        <Setter Property="CornerRadius" Value="{StaticResource ControlCornerRadius}" />
    </Style>

    <Style x:Key="ChapterPageCountTextStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="9.5" />
        <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Margin" Value="0,0,2,0" />
        <Setter Property="Visibility" Value="Collapsed" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding HasPageCount}" Value="True">
                <Setter Property="Visibility" Value="Visible" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="CardCoverHostStyle" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource SkeletonBrush}" />
        <Setter Property="ClipToBounds" Value="True" />
    </Style>

    <Style x:Key="CardTitleTextStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="13" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>

    <Style x:Key="CardSubtitleTextStyle" TargetType="TextBlock" BasedOn="{StaticResource CardTitleTextStyle}">
        <Setter Property="FontWeight" Value="Normal" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
    </Style>

    <Style x:Key="CardTagPillStyle" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource PrimarySubtleBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource CardBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="999" />
        <Setter Property="Padding" Value="6,2" />
        <Setter Property="Margin" Value="0,0,4,4" />
    </Style>

    <Style x:Key="CardTagTextStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="10" />
        <Setter Property="Foreground" Value="{DynamicResource PrimaryBrush}" />
    </Style>

    <Style x:Key="CardProgressTrackStyle" TargetType="Border">
        <Setter Property="VerticalAlignment" Value="Bottom" />
        <Setter Property="Height" Value="3" />
        <Setter Property="Background" Value="{DynamicResource OverlayBrush}" />
    </Style>

    <Style x:Key="CardProgressFillStyle" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource PrimaryBrush}" />
        <Setter Property="HorizontalAlignment" Value="Left" />
    </Style>

    <Style x:Key="AlbumAuthorToolTipTextStyle" TargetType="TextBlock"
           BasedOn="{StaticResource CardSubtitleTextStyle}">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Margin" Value="0,6,0,0" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="Visibility" Value="Visible" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding AuthorText}" Value="">
                <Setter Property="Visibility" Value="Collapsed" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="AlbumKindBadgeStyle" TargetType="Border"
           BasedOn="{StaticResource KindBadgeBorderStyle}">
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="VerticalAlignment" Value="Top" />
        <Setter Property="Margin" Value="8,8,0,0" />
        <Setter Property="Opacity" Value="0.92" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding Kind}" Value="Novel">
                <Setter Property="Background" Value="{DynamicResource NovelAccentBrush}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Kind}" Value="Video">
                <Setter Property="Background" Value="{DynamicResource VideoAccentBrush}" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="AlbumSourceBadgeStyle" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource CardScrimBrush}" />
        <Setter Property="CornerRadius" Value="7" />
        <Setter Property="Padding" Value="7,2" />
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="VerticalAlignment" Value="Top" />
        <Setter Property="Margin" Value="8,28,0,0" />
        <Setter Property="Visibility" Value="Visible" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding SourceBadge}" Value="">
                <Setter Property="Visibility" Value="Collapsed" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="DownloadedBadgeStyle" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource SuccessBrush}" />
        <Setter Property="CornerRadius" Value="999" />
        <Setter Property="Padding" Value="7,2" />
        <Setter Property="HorizontalAlignment" Value="Right" />
        <Setter Property="VerticalAlignment" Value="Top" />
        <Setter Property="Margin" Value="0,8,8,0" />
        <Setter Property="Visibility" Value="Collapsed" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding IsDownloaded}" Value="True">
                <Setter Property="Visibility" Value="Visible" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="VideoCoverPlaceholderStyle" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource HoverBgBrush}" />
        <Setter Property="Visibility" Value="Collapsed" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding Source, ElementName=CoverImage}" Value="{x:Null}">
                <Setter Property="Visibility" Value="Visible" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="VideoThumbPlaceholderStyle" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource HoverBgBrush}" />
        <Setter Property="Visibility" Value="Collapsed" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding Source, ElementName=ThumbImage}" Value="{x:Null}">
                <Setter Property="Visibility" Value="Visible" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="LocalNameCnToolTipTextStyle" TargetType="TextBlock"
           BasedOn="{StaticResource CardSubtitleTextStyle}">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Margin" Value="0,4,0,0" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="Visibility" Value="Visible" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding ShowNameCn}" Value="False">
                <Setter Property="Visibility" Value="Collapsed" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="HasPopularityVisibilityStyle" TargetType="StackPanel">
        <Setter Property="Visibility" Value="Collapsed" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding HasPopularity}" Value="True">
                <Setter Property="Visibility" Value="Visible" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="HasViewsVisibilityStyle" TargetType="StackPanel">
        <Setter Property="Visibility" Value="Collapsed" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding HasViews}" Value="True">
                <Setter Property="Visibility" Value="Visible" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="HasLikesVisibilityStyle" TargetType="StackPanel">
        <Setter Property="Visibility" Value="Collapsed" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding HasLikes}" Value="True">
                <Setter Property="Visibility" Value="Visible" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="HasCommentsVisibilityStyle" TargetType="StackPanel">
        <Setter Property="Visibility" Value="Collapsed" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding HasComments}" Value="True">
                <Setter Property="Visibility" Value="Visible" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="SelectionCheckBoxBorderStyle" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource SelectionPanelBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource PrimaryBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="Padding" Value="3" />
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="VerticalAlignment" Value="Top" />
        <Setter Property="Margin" Value="8,8,0,0" />
        <Setter Property="Visibility" Value="Collapsed" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding IsSelectionMode}" Value="True">
                <Setter Property="Visibility" Value="Visible" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="LocalProgressFillStyle" TargetType="Border"
           BasedOn="{StaticResource CardProgressFillStyle}">
        <Setter Property="Width" Value="0" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding Progress}" Value="0">
                <Setter Property="Visibility" Value="Collapsed" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="LocalNameCnTextStyle" TargetType="TextBlock"
           BasedOn="{StaticResource CardSubtitleTextStyle}">
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="Margin" Value="0,2,0,0" />
        <Setter Property="Visibility" Value="Collapsed" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding ShowNameCn}" Value="True">
                <Setter Property="Visibility" Value="Visible" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="ReadInfoTextStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="10.5" />
        <Setter Property="Foreground" Value="{DynamicResource PrimaryBrush}" />
        <Setter Property="Margin" Value="6,0,0,0" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Visibility" Value="Collapsed" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding HasReadInfo}" Value="True">
                <Setter Property="Visibility" Value="Visible" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="RatingTextStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="11" />
        <Setter Property="Foreground" Value="{DynamicResource WarningBrush}" />
        <Setter Property="Margin" Value="0,1,0,0" />
        <Setter Property="Visibility" Value="Collapsed" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding HasRating}" Value="True">
                <Setter Property="Visibility" Value="Visible" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="DownloadSummaryBorderStyle" TargetType="Border"
           BasedOn="{StaticResource CardStyle}">
        <Style.Triggers>
            <DataTrigger Binding="{Binding AllDone}" Value="True">
                <Setter Property="BorderBrush" Value="{DynamicResource SuccessBrush}" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="DownloadSummaryTextStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="11" />
        <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding AllDone}" Value="True">
                <Setter Property="Foreground" Value="{DynamicResource SuccessBrush}" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="DownloadProgressBarStyle" TargetType="ProgressBar"
           BasedOn="{StaticResource ModernProgressBarStyle}">
        <Style.Triggers>
            <DataTrigger Binding="{Binding AllDone}" Value="True">
                <Setter Property="Foreground" Value="{DynamicResource SuccessBrush}" />
            </DataTrigger>
        </Style.Triggers>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ProgressBar}">
                    <Grid>
                        <Border Name="PART_Track" Background="{TemplateBinding Control.Background}" CornerRadius="2" />
                        <Border Name="PART_Indicator" Background="{TemplateBinding Control.Foreground}" CornerRadius="2" HorizontalAlignment="Left" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>