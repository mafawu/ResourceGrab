<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Style x:Key="LibrarySortComboBoxStyle" TargetType="{x:Type ComboBox}" BasedOn="{StaticResource SortPillComboBoxStyle}">
        <Setter Property="Width" Value="{StaticResource SortComboBoxWidth}" />
        <Setter Property="MinHeight" Value="{StaticResource ToolbarHeight}" />
    </Style>

    <Style x:Key="LibraryActionButtonStyle" TargetType="{x:Type Button}" BasedOn="{StaticResource GhostButtonStyle}">
        <Setter Property="Padding" Value="16,0" />
        <Setter Property="MinHeight" Value="{StaticResource ToolbarHeight}" />
        <Setter Property="Margin" Value="{StaticResource ToolbarItemSpacing}" />
    </Style>

    <Style x:Key="LibraryPrimaryButtonStyle" TargetType="{x:Type Button}" BasedOn="{StaticResource PrimaryButtonStyle}">
        <Setter Property="Padding" Value="16,0" />
        <Setter Property="MinHeight" Value="{StaticResource ToolbarHeight}" />
        <Setter Property="Margin" Value="{StaticResource ToolbarItemSpacing}" />
    </Style>

    <Style x:Key="LibraryToolIconButtonStyle" TargetType="{x:Type Button}" BasedOn="{StaticResource IconButtonStyle}">
        <Setter Property="Width" Value="{StaticResource ToolbarHeight}" />
        <Setter Property="Height" Value="{StaticResource ToolbarHeight}" />
        <Setter Property="Margin" Value="{StaticResource ToolbarItemSpacing}" />
    </Style>

    <Style x:Key="LibraryPaginationButtonStyle" TargetType="{x:Type Button}" BasedOn="{StaticResource PaginationButtonStyle}">
        <Setter Property="MinHeight" Value="{StaticResource ToolbarHeight}" />
        <Setter Property="MinWidth" Value="36" />
    </Style>

    <!-- 分格滑块：完整视觉模板集中管理。 -->
<Style x:Key="ColumnsSliderStyle" TargetType="Slider">
            <Setter Property="Height" Value="20"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <Grid VerticalAlignment="Center">
                            <Border x:Name="TrackBg" Height="4" CornerRadius="2"
                                    Background="{DynamicResource DividerBrush}"
                                    VerticalAlignment="Center" Margin="7,0,7,0"/>
                            <Track x:Name="PART_Track" VerticalAlignment="Center">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="Slider.DecreaseLarge" Focusable="False">
                                        <RepeatButton.Style>
                                            <Style TargetType="RepeatButton">
                                                <Setter Property="Focusable" Value="False"/>
                                                <Setter Property="Template">
                                                    <Setter.Value>
                                                        <ControlTemplate TargetType="RepeatButton">
                                                            <Border Height="4" CornerRadius="2" Margin="7,0,0,0"
                                                                    HorizontalAlignment="Stretch" VerticalAlignment="Center">
                                                                <Border.Background>
                                                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                                                        <GradientStop Color="{DynamicResource PrimaryGradientStartColor}" Offset="0"/>
                                                                        <GradientStop Color="{DynamicResource PrimaryGradientEndColor}" Offset="1"/>
                                                                    </LinearGradientBrush>
                                                                </Border.Background>
                                                            </Border>
                                                        </ControlTemplate>
                                                    </Setter.Value>
                                                </Setter>
                                            </Style>
                                        </RepeatButton.Style>
                                    </RepeatButton>
                                </Track.DecreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Focusable="False" Width="14" Height="14" Cursor="Hand">
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Grid>
                                                    <Border x:Name="Outer" Width="14" Height="14" CornerRadius="7"
                                                            Background="{DynamicResource SurfaceBrush}"
                                                            BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1.2">
                                                        <Border.Effect>
                                                            <DropShadowEffect BlurRadius="6" ShadowDepth="1" Direction="270"
                                                                              Opacity="0.22" Color="{DynamicResource CardShadowColor}"/>
                                                        </Border.Effect>
                                                    </Border>
                                                    <Border x:Name="Dot" Width="7" Height="7" CornerRadius="3.5"
                                                            HorizontalAlignment="Center" VerticalAlignment="Center">
                                                        <Border.Background>
                                                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                                <GradientStop Color="{DynamicResource PrimaryGradientStartColor}" Offset="0"/>
                                                                <GradientStop Color="{DynamicResource PrimaryGradientEndColor}" Offset="1"/>
                                                            </LinearGradientBrush>
                                                        </Border.Background>
                                                    </Border>
                                                </Grid>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="Outer" Property="BorderBrush" Value="{DynamicResource PrimaryBrush}"/>
                                                        <Setter TargetName="Outer" Property="Effect">
                                                            <Setter.Value>
                                                                <DropShadowEffect BlurRadius="10" ShadowDepth="0" Opacity="0.38" Color="{DynamicResource PrimaryGlowColor}"/>
                                                            </Setter.Value>
                                                        </Setter>
                                                    </Trigger>
                                                    <Trigger Property="IsDragging" Value="True">
                                                        <Setter TargetName="Outer" Property="Width" Value="13"/>
                                                        <Setter TargetName="Outer" Property="Height" Value="13"/>
                                                        <Setter TargetName="Dot" Property="Width" Value="6"/>
                                                        <Setter TargetName="Dot" Property="Height" Value="6"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="Slider.IncreaseLarge" Focusable="False" Opacity="0">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="RepeatButton">
                                                <Border Background="Transparent"/>
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.IncreaseRepeatButton>
                            </Track>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="TrackBg" Property="Background" Value="{DynamicResource DividerStrongBrush}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    <Style x:Key="CardSizeSliderBorderStyle" TargetType="Border">
        <Setter Property="Height" Value="{StaticResource ToolbarHeight}" />
        <Setter Property="Padding" Value="9,0,7,0" />
        <Setter Property="CornerRadius" Value="{StaticResource ControlCornerRadius}" />
        <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource CardBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="UseLayoutRounding" Value="True" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource CardHoverBrush}" />
                <Setter Property="BorderBrush" Value="{DynamicResource CardHoverBorderBrush}" />
            </Trigger>
        </Style.Triggers>
    </Style>
</ResourceDictionary>
