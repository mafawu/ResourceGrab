    <Color x:Key="AppBackgroundBottomColor">#0F0F12</Color>
    <LinearGradientBrush x:Key="WindowBorderBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#2A2A30" Offset="0" />
        <GradientStop Color="#2E2E34" Offset="0.5" />
        <GradientStop Color="#332A32" Offset="1" />
    </LinearGradientBrush>
