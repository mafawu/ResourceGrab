<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- ================================================================
         DSO UI · 深色（Midnight）
         与浅色同一套语义键：画布压暗、表面抬升、靛蓝强调提亮以维持 4.5:1。
         ================================================================ -->
    <SolidColorBrush x:Key="AppBackgroundBrush" Color="#0B0E14" />
    <SolidColorBrush x:Key="AppBackgroundTopBrush" Color="#12161F" />
    <SolidColorBrush x:Key="AppBackgroundBottomBrush" Color="#0B0E14" />
    <SolidColorBrush x:Key="SurfaceBrush" Color="#12161F" />
    <SolidColorBrush x:Key="CardBorderBrush" Color="#232A38" />
    <SolidColorBrush x:Key="DividerBrush" Color="#1B212D" />
    <SolidColorBrush x:Key="DividerStrongBrush" Color="#2B3345" />
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="#E9EDF5" />
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#98A2B5" />
    <SolidColorBrush x:Key="TextDisabledBrush" Color="#6B7488" />
    <SolidColorBrush x:Key="PrimaryBrush" Color="#6E86FF" />
    <SolidColorBrush x:Key="PrimaryHoverBrush" Color="#8A9EFF" />
    <SolidColorBrush x:Key="PrimaryPressedBrush" Color="#5570F0" />
    <SolidColorBrush x:Key="PrimaryFgBrush" Color="#0B0E14" />
    <SolidColorBrush x:Key="PrimaryLightBrush" Color="#9AAEFF" />
    <SolidColorBrush x:Key="PrimarySubtleBrush" Color="#1A2340" />
    <SolidColorBrush x:Key="PrimaryGradientStartBrush" Color="#7E93FF" />
    <SolidColorBrush x:Key="PrimaryGradientEndBrush" Color="#5570F0" />
    <SolidColorBrush x:Key="DangerBrush" Color="#FF6369" />
    <SolidColorBrush x:Key="SuccessBrush" Color="#3DD598" />
    <SolidColorBrush x:Key="WarningBrush" Color="#F2B356" />
    <SolidColorBrush x:Key="WarningSubtleBrush" Color="#33F2B356" />
    <SolidColorBrush x:Key="NovelAccentBrush" Color="#A08CFF" />
    <SolidColorBrush x:Key="VideoAccentBrush" Color="#3DD598" />
    <SolidColorBrush x:Key="PhotobookAccentBrush" Color="#E8B054" />
    <SolidColorBrush x:Key="PhotobookSubtleBrush" Color="#2E2618" />
    <SolidColorBrush x:Key="CardScrimBrush" Color="#99000000" />
    <SolidColorBrush x:Key="CardOverlayPanelBrush" Color="#CC000000" />
    <SolidColorBrush x:Key="CardBadgeScrimBrush" Color="#E6000000" />
    <SolidColorBrush x:Key="OnMediaBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="OnMediaSecondaryBrush" Color="#E6FFFFFF" />
    <SolidColorBrush x:Key="SelectionPanelBrush" Color="#222937" />
    <SolidColorBrush x:Key="DangerSubtleBrush" Color="#40FF6369" />
    <Color x:Key="CardScrimColor">#99000000</Color>
    <SolidColorBrush x:Key="InputBorderBrush" Color="#2A3242" />
    <SolidColorBrush x:Key="InputFocusBrush" Color="#6E86FF" />
    <SolidColorBrush x:Key="FocusGlowBrush" Color="#406E86FF" />
    <SolidColorBrush x:Key="HoverBgBrush" Color="#14E9EDF5" />
    <!-- 阅读器衬底：比画布再暗一档，让偏亮的漫画页浮起来 -->
    <SolidColorBrush x:Key="ReaderBackdropBrush" Color="#05070B" />
    <SolidColorBrush x:Key="ActiveNavBgBrush" Color="#1F6E86FF" />
    <SolidColorBrush x:Key="SelectionBgBrush" Color="#266E86FF" />
    <SolidColorBrush x:Key="ScrollbarThumbBrush" Color="#3D6B7488" />
    <SolidColorBrush x:Key="ScrollbarThumbHoverBrush" Color="#5A6B7488" />
    <SolidColorBrush x:Key="OverlayBrush" Color="#66000000" />
    <SolidColorBrush x:Key="WindowControlHoverBrush" Color="#14E9EDF5" />
    <SolidColorBrush x:Key="CardHoverBrush" Color="#1A2130" />
    <SolidColorBrush x:Key="CardHoverBorderBrush" Color="#3B4A6E" />
    <SolidColorBrush x:Key="CardShadowBrush" Color="#40000000" />
    <SolidColorBrush x:Key="CardHoverShadowBrush" Color="#1A6E86FF" />
    <SolidColorBrush x:Key="SkeletonBrush" Color="#1A1F2B" />
    <SolidColorBrush x:Key="SnackbarBgBrush" Color="#F012161F" />
    <SolidColorBrush x:Key="TextLinkBrush" Color="#8A9EFF" />
    <Color x:Key="CardShadowColor">#40000000</Color>
    <Color x:Key="PrimaryGlowColor">#336E86FF</Color>
    <Color x:Key="PrimaryGradientStartColor">#7E93FF</Color>
    <Color x:Key="PrimaryGradientEndColor">#5570F0</Color>
    <Color x:Key="PrimaryHoverColor">#8A9EFF</Color>
    <Color x:Key="PrimaryPressedColor">#5570F0</Color>
    <Color x:Key="AppBackgroundTopColor">#12161F</Color>
    <Color x:Key="AppBackgroundBottomColor">#0B0E14</Color>
    <LinearGradientBrush x:Key="WindowBorderBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#232A38" Offset="0" />
        <GradientStop Color="#2B3345" Offset="0.5" />
        <GradientStop Color="#252C3A" Offset="1" />
    </LinearGradientBrush>
</ResourceDictionary>
