<Application x:Class="ResourceGrab.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Themes/Colors.xaml" />
                <ResourceDictionary Source="Themes/Icons.xaml" />
                <ResourceDictionary Source="Themes/Tokens.xaml" />
                <ResourceDictionary Source="Themes/Core.Controls.xaml" />
                <ResourceDictionary Source="Themes/Library.Toolbar.xaml" />
                <ResourceDictionary Source="Themes/States.xaml" />
                <ResourceDictionary Source="Themes/Cards.xaml" />
                <ResourceDictionary Source="Themes/Search.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <!-- 全局转换器：模板里的 {StaticResource BoolToVis} 不再依赖各视图自己定义（漏了就会在模板实例化时炸） -->
            <BooleanToVisibilityConverter x:Key="BoolToVis" />
        </ResourceDictionary>
    </Application.Resources>
</Application>
