<UserControl x:Class="ResourceGrab.App.Controls.ReaderShell"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" x:Name="ToolbarRow" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" x:Name="BottomBarRow" />
        </Grid.RowDefinitions>

        <!-- Top Toolbar -->
        <Border Grid.Row="0" Padding="{DynamicResource SpacingSm}" x:Name="TopToolbar"
                Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource DividerBrush}" BorderThickness="0,0,0,1">
            <DockPanel>
                <Button x:Name="ReaderBackButton" DockPanel.Dock="Left"
                        Style="{DynamicResource IconButtonStyle}"
                        ToolTip="返回" Click="Back_Click" Margin="0,0,8,0">
                    <Path Data="{StaticResource IconBack}"
                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                          StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                          Stretch="Uniform" Width="16" Height="16" />
                </Button>
                <TextBlock x:Name="ReaderTitle" Text=""
                           FontSize="{DynamicResource FontEmphasis}" FontWeight="SemiBold"
                           VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis" MaxWidth="300" />
                <StackPanel x:Name="ToolbarActionsHost" DockPanel.Dock="Right"
                            Orientation="Horizontal" HorizontalAlignment="Right"
                            VerticalAlignment="Center" />
                <Border /> <!-- fill -->
            </DockPanel>
        </Border>

        <!-- Content -->
        <ContentPresenter Grid.Row="1" x:Name="ContentViewHost" />

        <!-- Bottom Bar -->
        <Border Grid.Row="2" Padding="{DynamicResource SpacingSm}" x:Name="BottomBar"
                Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource DividerBrush}" BorderThickness="0,1,0,0">
            <StackPanel x:Name="BottomBarHost" Orientation="Horizontal" HorizontalAlignment="Center" />
        </Border>
    </Grid>
</UserControl>
