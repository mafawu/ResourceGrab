<UserControl x:Class="ResourceGrab.App.Controls.VideoCard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:common="clr-namespace:ResourceGrab.App.Common"
             Margin="0,0,14,14">
    <UserControl.ContextMenu>
        <ContextMenu>
            <MenuItem Header="浏览文件" Click="Browse_Click" />
            <MenuItem Header="编辑信息…" Click="Edit_Click" />
            <MenuItem Header="重新扫描" Click="Rescan_Click" />
            <MenuItem x:Name="FavoriteMenuItem" Header="收藏" Click="Favorite_Click" />
            <Separator />
            <MenuItem Header="打开所在文件夹" Click="OpenFolder_Click" />
            <MenuItem Header="从库中移除" Click="Delete_Click" />
        </ContextMenu>
    </UserControl.ContextMenu>
    <Border Style="{StaticResource LibraryCardBaseStyle}"
            MouseLeftButtonUp="Card_Click">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="180" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <!-- 封面区域 -->
            <Border Grid.Row="0" CornerRadius="14,14,0,0" Style="{StaticResource CardCoverHostStyle}">
                <Grid>
                    <!-- 缩略图由 ImageLoader 异步加载（含缓存） -->
                    <Image x:Name="CoverImage" Stretch="UniformToFill" />
                    <Border x:Name="PlaceholderIcon" Style="{StaticResource VideoCoverPlaceholderStyle}">
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                            <TextBlock Text="🎬" FontSize="36" HorizontalAlignment="Center" />
                            <TextBlock Text="暂无封面" FontSize="11" Foreground="{DynamicResource TextDisabledBrush}"
                                       HorizontalAlignment="Center" Margin="0,6,0,0" />
                        </StackPanel>
                    </Border>
                    <!-- hover 浏览提示 -->
                    <Border x:Name="BrowseOverlay" HorizontalAlignment="Center" VerticalAlignment="Center"
                            Background="{DynamicResource CardOverlayPanelBrush}" CornerRadius="16" Padding="14,7"
                            Visibility="Collapsed" IsHitTestVisible="False">
                        <TextBlock Text="浏览文件" FontSize="12" Foreground="White" FontWeight="SemiBold" />
                    </Border>
                    <!-- 文件数角标（左上） -->
                    <Border HorizontalAlignment="Left" VerticalAlignment="Top" Margin="8"
                            Background="{DynamicResource CardBadgeScrimBrush}" CornerRadius="6" Padding="6,2">
                        <TextBlock x:Name="FileCountText" Text="0 个" FontSize="10" Foreground="White" FontWeight="Bold" />
                    </Border>
                    <!-- 收藏心形（右上，点击切换） -->
                    <Border x:Name="FavoriteBadge" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="8"
                            Background="{DynamicResource CardBadgeScrimBrush}" CornerRadius="999" Padding="6,3" Cursor="Hand"
                            MouseLeftButtonUp="Favorite_Click"
                            ToolTip="收藏 / 取消收藏">
                        <TextBlock x:Name="FavoriteIcon" Text="♡" FontSize="12" Foreground="{DynamicResource OnMediaBrush}" FontWeight="Bold" />
                    </Border>
                    <!-- 进度条 -->
                    <Border Style="{StaticResource CardProgressTrackStyle}">
                        <Border x:Name="ProgressBar" Style="{StaticResource CardProgressFillStyle}" Width="0" />
                    </Border>
                </Grid>
            </Border>
            <!-- 信息区域 -->
            <StackPanel Grid.Row="1" Margin="10,10,10,12" MinHeight="64">
                <TextBlock x:Name="TitleText" Style="{StaticResource CardTitleTextStyle}"
                           TextWrapping="Wrap" MaxHeight="34" TextTrimming="CharacterEllipsis" />
                <TextBlock x:Name="SeriesText" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}"
                           Margin="0,2,0,0" TextTrimming="CharacterEllipsis"
                           Visibility="Collapsed" />
                <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                    <TextBlock x:Name="SizeText" FontSize="10.5" Foreground="{DynamicResource TextSecondaryBrush}" />
                    <TextBlock x:Name="DurationText" FontSize="10.5" Foreground="{DynamicResource TextSecondaryBrush}"
                               Margin="8,0,0,0" />
                    <TextBlock x:Name="RatingText" FontSize="11" Foreground="{DynamicResource WarningBrush}" Margin="8,0,0,0"
                               Visibility="Collapsed" />
                    <!-- 丢失提示 -->
                    <Border x:Name="MissingBadge" Background="{DynamicResource DangerSubtleBrush}" CornerRadius="999" Padding="6,1"
                            Margin="8,0,0,0" Visibility="Collapsed">
                        <TextBlock x:Name="MissingText" Text="缺失" FontSize="10" Foreground="{DynamicResource DangerBrush}" FontWeight="Bold" />
                    </Border>
                </StackPanel>
                <ItemsControl x:Name="TagItems" Margin="0,4,0,0">
                    <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource CardTagPillStyle}">
                                <TextBlock Text="{Binding}" Style="{StaticResource CardTagTextStyle}" />
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
