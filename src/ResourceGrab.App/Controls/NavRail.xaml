<UserControl x:Class="ResourceGrab.App.Controls.NavRail"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:sys="clr-namespace:System;assembly=mscorlib">
    <UserControl.Resources>
        <Style x:Key="NavSectionHeaderStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="{DynamicResource FontCaption}" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource TextDisabledBrush}" />
            <Setter Property="Margin" Value="12,8,0,6" />
        </Style>

        <Style x:Key="NavRailItemContainerStyle" TargetType="RadioButton">
            <Setter Property="Height" Value="44" />
            <!-- 上下各留 1px，悬浮/选中圆角之间有 2px 间隔，不再完全挨着 -->
            <Setter Property="Margin" Value="2,1" />
            <Setter Property="Cursor" Value="Hand" />
            <!-- 显示样式会整体替换隐式样式：前景色必须在这里显式声明，
                 否则图标（绑定 RadioButton.Foreground）在暗色下继承窗口默认黑色 -->
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="ItemBorder"
                                CornerRadius="{DynamicResource RadiusMd}"
                                Background="Transparent"
                                Padding="10,0">
                            <ContentPresenter VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background"
                                        Value="{DynamicResource HoverBgBrush}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background"
                                        Value="{DynamicResource PrimarySubtleBrush}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <DataTemplate x:Key="NavItemTemplate">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Path Data="{Binding Icon}"
                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"
                      StrokeThickness="1.55"
                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                      Stretch="Uniform" Width="17" Height="17"
                      HorizontalAlignment="Center" VerticalAlignment="Center" />
                <TextBlock Text="{Binding Title}"
                           Margin="10,0,0,0"
                           FontWeight="SemiBold"
                           VerticalAlignment="Center" />
            </StackPanel>
        </DataTemplate>

        <DataTemplate x:Key="NavSectionTemplate">
            <StackPanel Margin="0,0,0,4">
                <TextBlock Text="{Binding Title}" Style="{StaticResource NavSectionHeaderStyle}" />
                <ItemsControl ItemsSource="{Binding Items}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <RadioButton GroupName="NavRailGroup"
                                         Style="{StaticResource NavRailItemContainerStyle}"
                                         Content="{Binding}"
                                         ContentTemplate="{StaticResource NavItemTemplate}"
                                         Click="RadioButton_Click"
                                         IsEnabled="{Binding IsEnabled}" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </DataTemplate>
    </UserControl.Resources>

    <ItemsControl x:Name="SectionsHost"
                  ItemTemplate="{StaticResource NavSectionTemplate}" />
</UserControl>
