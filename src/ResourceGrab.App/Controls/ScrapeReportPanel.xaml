<UserControl x:Class="ResourceGrab.App.Controls.ScrapeReportPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent"
             Visibility="Collapsed">
    <StackPanel x:Name="RootPanel">
        <!-- Header -->
        <Border Style="{StaticResource CardPanelStyle}" Padding="14,10" Margin="0,0,0,8"
                MouseLeftButtonUp="ToggleExpand_Click" Cursor="Hand">
            <Grid>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="刮削报告" FontSize="14" FontWeight="Bold" VerticalAlignment="Center" />
                    <Border Background="{DynamicResource HoverBgBrush}" CornerRadius="8" Padding="8,2" Margin="10,0,0,0"
                            VerticalAlignment="Center">
                        <TextBlock x:Name="SummaryText" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" />
                    </Border>
                </StackPanel>
                <TextBlock x:Name="ExpandArrow" Text="▸" FontSize="12" HorizontalAlignment="Right"
                           VerticalAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}" />
            </Grid>
        </Border>

        <!-- Detail panel (toggleable) -->
        <Border x:Name="DetailBorder" Visibility="Collapsed" Margin="0,0,0,8">
            <StackPanel Margin="4,0,0,0">
                <!-- Field source attribution -->
                <TextBlock Text="字段来源" FontSize="12" FontWeight="SemiBold"
                           Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,6" />
                <ItemsControl x:Name="FieldSourceList">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,0,0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="100" />
                                    <ColumnDefinition Width="8" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding FieldName}" FontSize="12"
                                           Foreground="{DynamicResource TextSecondaryBrush}" />
                                <TextBlock Grid.Column="2" FontSize="12" FontWeight="SemiBold"
                                           Text="{Binding SourceDisplay}" />
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <Border Height="1" Background="{DynamicResource DividerBrush}" Margin="0,10,0,10" />

                <!-- Source execution list -->
                <TextBlock Text="来源执行记录" FontSize="12" FontWeight="SemiBold"
                           Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,6" />
                <ItemsControl x:Name="AttemptList">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,3,0,3">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="16" />
                                    <ColumnDefinition Width="90" />
                                    <ColumnDefinition Width="60" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="60" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding StatusIcon}" FontSize="12" VerticalAlignment="Center"
                                           Foreground="{Binding StatusBrush}" />
                                <TextBlock Grid.Column="1" Text="{Binding SourceId}" FontSize="12"
                                           VerticalAlignment="Center" />
                                <TextBlock Grid.Column="2" Text="{Binding OutcomeText}" FontSize="11"
                                           VerticalAlignment="Center" Foreground="{Binding OutcomeBrush}" />
                                <TextBlock Grid.Column="3" Text="{Binding Reason}" FontSize="11"
                                           VerticalAlignment="Center" Foreground="{DynamicResource TextDisabledBrush}"
                                           TextTrimming="CharacterEllipsis" />
                                <TextBlock Grid.Column="4" Text="{Binding ElapsedText}" FontSize="11"
                                           VerticalAlignment="Center" Foreground="{DynamicResource TextDisabledBrush}"
                                           HorizontalAlignment="Right" />
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>
