<UserControl x:Class="ResourceGrab.App.Controls.TagEditorInput"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Border BorderBrush="{DynamicResource InputBorderBrush}" BorderThickness="1"
            CornerRadius="{DynamicResource RadiusSm}" Padding="6,4" Background="Transparent"
            MouseLeftButtonDown="Host_Click">
        <StackPanel>
            <ItemsControl x:Name="ChipItems">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Background="{DynamicResource PrimarySubtleBrush}"
                                BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1"
                                CornerRadius="{DynamicResource RadiusXs}" Padding="8,2" Margin="0,2,4,2">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding}" FontSize="11"
                                           Foreground="{DynamicResource PrimaryBrush}" VerticalAlignment="Center" />
                                <TextBlock Text="✕" FontSize="10" Margin="6,0,0,0" Cursor="Hand"
                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                           VerticalAlignment="Center"
                                           MouseLeftButtonUp="RemoveChip_Click" />
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <TextBox x:Name="InputBox" Style="{StaticResource ModernTextBoxStyle}"
                     Margin="0,2,0,0" FontSize="12" Padding="4,3"
                     Background="Transparent" BorderThickness="0"
                     KeyDown="InputBox_KeyDown" LostFocus="InputBox_LostFocus" />
        </StackPanel>
    </Border>
</UserControl>

