<UserControl x:Class="ResourceGrab.App.Controls.VideoFileCard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Margin="0,0,12,12">
    <Border Style="{StaticResource VideoFileCardBorderStyle}" MouseLeftButtonUp="Card_Click">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Border CornerRadius="8,8,0,0" Background="{DynamicResource HoverBgBrush}">
                <Grid Width="{Binding CardWidth, RelativeSource={RelativeSource AncestorType=UserControl}}" Height="240" ClipToBounds="True">
                    <Image x:Name="CoverImage" Stretch="UniformToFill" />
                    <StackPanel x:Name="PlaceholderIcon" VerticalAlignment="Center" HorizontalAlignment="Center">
                        <TextBlock Text="🎞" FontSize="26" HorizontalAlignment="Center" />
                    </StackPanel>
                    <Border x:Name="PlayOverlay" Background="{DynamicResource CardScrimBrush}" Visibility="Collapsed">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <TextBlock Text="▶ 播放" FontSize="13" FontWeight="SemiBold" Foreground="White"
                                       Cursor="Hand" MouseLeftButtonUp="Play_Click" ToolTip="播放" />
                            <TextBlock Text="  打开目录" FontSize="13" Foreground="#DDFFFFFF"
                                       Margin="14,0,0,0" Cursor="Hand" MouseLeftButtonUp="OpenFolder_Click" ToolTip="打开所在目录" />
                        </StackPanel>
                    </Border>
                    <Border x:Name="WatchedBar" Width="3" Height="24" HorizontalAlignment="Left" VerticalAlignment="Top"
                            Background="{DynamicResource PrimaryBrush}" Visibility="Collapsed" />
                    <TextBlock x:Name="FavoriteHeart" Text="♡" FontSize="15" Foreground="{DynamicResource TextSecondaryBrush}"
                               HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,6,6,0" Cursor="Hand"
                               MouseLeftButtonUp="Favorite_Click" Visibility="Collapsed" MouseEnter="Card_MouseEnter" MouseLeave="Card_MouseLeave" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="6">
                        <Border x:Name="DurationBadge" Background="{DynamicResource CardBadgeScrimBrush}" CornerRadius="5" Padding="5,1" Visibility="Collapsed">
                            <TextBlock x:Name="DurationText" FontSize="10" Foreground="White" FontWeight="Bold" />
                        </Border>
                        <Border x:Name="ResolutionBadge" Background="{DynamicResource CardBadgeScrimBrush}" CornerRadius="5" Padding="5,1" Margin="4,0,0,0" Visibility="Collapsed">
                            <TextBlock x:Name="ResolutionText" FontSize="10" Foreground="White" FontWeight="Bold" />
                        </Border>
                    </StackPanel>
                    <Border x:Name="SelectionBadge" Width="26" Height="26" Margin="6" CornerRadius="13"
                            Background="{DynamicResource CardBadgeScrimBrush}" BorderThickness="1"
                            BorderBrush="{DynamicResource PrimaryBrush}" HorizontalAlignment="Left"
                            VerticalAlignment="Top" Visibility="Collapsed"
                            Cursor="Hand" MouseLeftButtonUp="Selection_Click" ToolTip="选择">
                        <TextBlock x:Name="SelectionMark" Text="" FontSize="14" FontWeight="Bold"
                                   Foreground="{DynamicResource PrimaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                </Grid>
            </Border>

            <StackPanel Grid.Row="1" Margin="9,7,9,10" MinHeight="42">
                <TextBlock x:Name="TitleText" FontSize="12" TextTrimming="CharacterEllipsis" MaxHeight="32" TextWrapping="Wrap" />
                <TextBlock x:Name="InfoText" FontSize="10.5" Foreground="{DynamicResource TextSecondaryBrush}" TextTrimming="CharacterEllipsis" Margin="0,2,0,0" />
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
