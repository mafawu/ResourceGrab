<UserControl x:Class="ResourceGrab.App.Controls.SearchBoxControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Border x:Name="FocusBorder" Style="{StaticResource SearchFieldBorderStyle}">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Path Grid.Column="0" Data="{StaticResource IconSearch}" Stroke="{DynamicResource TextDisabledBrush}"
                  StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                  StrokeLineJoin="Round" Stretch="Uniform" Width="16" Height="16"
                  Margin="14,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False" />

            <Grid Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
                <TextBox x:Name="InputTextBox" Style="{StaticResource SearchInputTextStyle}" MinWidth="100"
                         Text="{Binding Text, RelativeSource={RelativeSource AncestorType=UserControl}, UpdateSourceTrigger=PropertyChanged}"
                         TextChanged="TextBox_TextChanged" KeyDown="TextBox_KeyDown"
                         VerticalContentAlignment="Center"
                         ToolTip="{Binding Watermark, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                <TextBlock Text="{Binding Watermark, RelativeSource={RelativeSource AncestorType=UserControl}}"
                           Style="{StaticResource SearchWatermarkTextStyle}" />
            </Grid>

            <Button x:Name="ClearButton" Grid.Column="2"
                    Style="{StaticResource SearchBoxClearButtonStyle}"
                    Click="ClearButton_Click">
            </Button>
        </Grid>
    </Border>
</UserControl>
