<UserControl x:Class="ResourceGrab.App.Controls.OnlineVideoPreviewPlayer"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:fl="clr-namespace:FlyleafLib.Controls.WPF;assembly=FlyleafLib"
             xmlns:controls="clr-namespace:ResourceGrab.App.Controls">

    <!--
      在线视频预览/全片播放器（源无关）：吃 OnlineVideoDetail 的 StreamUrl + Referer 契约。
      FlyleafHost 经 DirectComposition 直接进 DWM 合成，无空域问题：
      覆盖层可放任意位置、鼠标事件正常、滚动跟随裁剪均由 WPF 处理。
    -->
    <Grid x:Name="PlayerRoot" Background="#FF101418"
          MouseEnter="PlayerRoot_MouseEnter" MouseMove="PlayerRoot_MouseMove" MouseLeave="PlayerRoot_MouseLeave">
        <!-- 播放器宿主：非播放态折叠，避免黑块挡住海报 -->
        <fl:FlyleafHost x:Name="VideoHost" Visibility="Collapsed">
            <Grid>
                <!-- 加载态 -->
                <Grid x:Name="LoadingLayer" Background="#E6101418" Visibility="Collapsed">
                    <controls:LoadingIndicator VerticalAlignment="Center" HorizontalAlignment="Center"
                                               RingSize="40" Foreground="#E6FFFFFF" />
                </Grid>

                <!-- 错误态 -->
                <Grid x:Name="ErrorLayer" Background="#E6101418" Visibility="Collapsed">
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                        <TextBlock Text="播放失败，视频可能已下架或网络受限" FontSize="12"
                                   Foreground="#B3FFFFFF" HorizontalAlignment="Center" />
                        <Button Content="重试" Style="{StaticResource LibraryActionButtonStyle}"
                                Click="Retry_Click" HorizontalAlignment="Center" Margin="0,10,0,0" />
                    </StackPanel>
                </Grid>

                <!-- 缓冲中提示：播放中网络跟不上时显示（不改变播放状态，控制条继续可操作） -->
                <Grid x:Name="BufferingLayer" Background="#33101418" Visibility="Collapsed">
                    <controls:LoadingIndicator VerticalAlignment="Center" HorizontalAlignment="Center"
                                               RingSize="34" Foreground="#CCFFFFFF" />
                </Grid>

                <!-- 底部控制条：暂停/继续 + 当前时间 + 进度滑条 + 总时长 + 画质 + 静音 + 音量 + 停止
                     （播放/暂停态显示，5 秒无操作自动隐藏） -->
                <Border x:Name="ControlBar" VerticalAlignment="Bottom" Background="#99000000"
                        Padding="12,8" Visibility="Collapsed" MouseMove="ControlBar_MouseMove">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <!-- 暂停/继续：白色图标，hover 仅背景高亮（用 Segoe UI Symbol 的 monochrome 字形，
                             不用 ⏸/▶ emoji 字形——那些会被 Segoe UI Emoji 彩色渲染，Foreground 无效） -->
                        <Button x:Name="PauseToggleButton" Width="32" Height="32"
                                Background="Transparent" BorderThickness="0"
                                FontFamily="Segoe UI Symbol"
                                Foreground="White" Content="❚❚" Click="PauseToggle_Click" ToolTip="暂停 / 继续">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                            CornerRadius="8" SnapsToDevicePixels="True">
                                        <!-- TextBlock 显式绑定前景色：ContentPresenter 对字符串内容不会继承 Foreground -->
                                        <TextBlock Text="{TemplateBinding Content}"
                                                   FontFamily="{TemplateBinding FontFamily}"
                                                   Foreground="{TemplateBinding Foreground}"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Bd" Property="Background" Value="#2EFFFFFF" />
                                        </Trigger>
                                        <Trigger Property="IsPressed" Value="True">
                                            <Setter TargetName="Bd" Property="Background" Value="#4DFFFFFF" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                        <TextBlock x:Name="CurrentTimeText" Grid.Column="1" Text="0:00" FontSize="12"
                                   FontWeight="SemiBold" Foreground="#F2FFFFFF"
                                   VerticalAlignment="Center" Margin="10,0,10,0" />
                        <Slider x:Name="SeekSlider" Grid.Column="2" Minimum="0" Maximum="100"
                                VerticalAlignment="Center" ToolTip="拖动跳转进度"
                                ValueChanged="SeekSlider_ValueChanged"
                                Thumb.DragStarted="SeekSlider_DragStarted"
                                Thumb.DragCompleted="SeekSlider_DragCompleted" />
                        <TextBlock x:Name="DurationText" Grid.Column="3" Text="--:--" FontSize="12"
                                   Foreground="#B3FFFFFF" VerticalAlignment="Center" Margin="10,0,0,0" />
                        <!-- 画质：点击弹出档位菜单；有多档时才显示，文字为当前档位 -->
                        <Button x:Name="QualityButton" Grid.Column="4" MinWidth="40" Height="32"
                                Background="Transparent" BorderThickness="0"
                                Click="QualityButton_Click" ToolTip="切换画质" Visibility="Collapsed"
                                Margin="10,0,0,0">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                            CornerRadius="8" Padding="8,0" SnapsToDevicePixels="True">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Bd" Property="Background" Value="#2EFFFFFF" />
                                        </Trigger>
                                        <Trigger Property="IsPressed" Value="True">
                                            <Setter TargetName="Bd" Property="Background" Value="#4DFFFFFF" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                            <TextBlock x:Name="QualityLabel" FontSize="12" FontWeight="SemiBold"
                                       Foreground="#F2FFFFFF" VerticalAlignment="Center" />
                        </Button>

                        <!-- 静音 / 取消静音：矢量图标随状态切换（不用 emoji，避免被彩色字形渲染） -->
                        <Button x:Name="MuteToggleButton" Grid.Column="5" Width="32" Height="32"
                                Background="Transparent" BorderThickness="0"
                                Click="MuteToggle_Click" ToolTip="静音 / 取消静音" Margin="4,0,0,0">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                            CornerRadius="8" SnapsToDevicePixels="True">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Bd" Property="Background" Value="#2EFFFFFF" />
                                        </Trigger>
                                        <Trigger Property="IsPressed" Value="True">
                                            <Setter TargetName="Bd" Property="Background" Value="#4DFFFFFF" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                            <Grid Width="16" Height="16">
                                <Path x:Name="VolumeOnIcon" Data="{StaticResource IconVolumeHigh}"
                                      Stroke="White" StrokeThickness="1.6" StrokeStartLineCap="Round"
                                      StrokeEndLineCap="Round" StrokeLineJoin="Round" Stretch="Uniform" />
                                <Path x:Name="VolumeOffIcon" Data="{StaticResource IconVolumeMute}"
                                      Stroke="White" StrokeThickness="1.6" StrokeStartLineCap="Round"
                                      StrokeEndLineCap="Round" StrokeLineJoin="Round" Stretch="Uniform"
                                      Visibility="Collapsed" />
                            </Grid>
                        </Button>

                        <!-- 音量滑条：0-100，跨会话记住 -->
                        <Slider x:Name="VolumeSlider" Grid.Column="6" Width="70" Minimum="0" Maximum="100"
                                VerticalAlignment="Center" Margin="6,0,0,0" ToolTip="音量"
                                ValueChanged="VolumeSlider_ValueChanged"
                                Thumb.DragCompleted="VolumeSlider_DragCompleted" />

                        <!-- 停止：白色图标 -->
                        <Button x:Name="StopButton" Grid.Column="7" Width="32" Height="32"
                                Background="Transparent" BorderThickness="0"
                                FontFamily="Segoe UI Symbol"
                                Foreground="White" Content="■" Margin="10,0,0,0" Click="StopButton_Click" ToolTip="停止播放">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                            CornerRadius="8" SnapsToDevicePixels="True">
                                        <TextBlock Text="{TemplateBinding Content}"
                                                   FontFamily="{TemplateBinding FontFamily}"
                                                   Foreground="{TemplateBinding Foreground}"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Bd" Property="Background" Value="#2EFFFFFF" />
                                        </Trigger>
                                        <Trigger Property="IsPressed" Value="True">
                                            <Setter TargetName="Bd" Property="Background" Value="#4DFFFFFF" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </Grid>
                </Border>
            </Grid>
        </fl:FlyleafHost>

        <!-- 海报占位 + 播放大按钮（空闲态）：封面全亮显示，按钮浮于其上不压暗画面 -->
        <Grid x:Name="PosterLayer">
            <Image x:Name="PosterImage" Stretch="Uniform" Opacity="1" />
            <StackPanel x:Name="PlayHost" VerticalAlignment="Center" HorizontalAlignment="Center"
                        Cursor="Hand" MouseLeftButtonUp="PlayHost_Click">
                <Border Width="64" Height="64" CornerRadius="999"
                        Background="#66000000" BorderBrush="#B3FFFFFF" BorderThickness="1.5">
                    <Path Data="M 0,0 L 16,9 L 0,18 Z" Fill="White"
                          Stretch="Uniform" Width="20" Height="20"
                          HorizontalAlignment="Center" VerticalAlignment="Center" Margin="3,0,0,0" />
                </Border>
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
