<UserControl x:Class="ResourceGrab.App.Controls.DetailShell"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Padding="{DynamicResource SpacingMd}"
                BorderBrush="{DynamicResource DividerBrush}" BorderThickness="0,0,0,1">
            <DockPanel>
                <Button x:Name="BackButton" DockPanel.Dock="Left"
                        Style="{DynamicResource IconButtonStyle}"
                        ToolTip="返回" Click="Back_Click" Margin="0,0,8,0">
                    <Path Data="{StaticResource IconBack}"
                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                          StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                          Stretch="Uniform" Width="16" Height="16" />
                </Button>
                <TextBlock x:Name="HeaderText" Text=""
                           FontSize="{DynamicResource FontPageTitle}" FontWeight="Bold"
                           VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis" MaxWidth="400" />
                <StackPanel x:Name="ActionHost" DockPanel.Dock="Right"
                            Orientation="Horizontal" VerticalAlignment="Center"
                            HorizontalAlignment="Right" />
                <Border /> <!-- fill -->
            </DockPanel>
        </Border>

        <!-- Body -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <ContentPresenter x:Name="BodyHost" Margin="{DynamicResource SpacingLg}" />
        </ScrollViewer>
    </Grid>
</UserControl>
