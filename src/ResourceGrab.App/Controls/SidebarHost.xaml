<UserControl x:Class="ResourceGrab.App.Controls.SidebarHost"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Padding="{DynamicResource SpacingMd}"
                BorderBrush="{DynamicResource DividerBrush}"
                BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <ContentPresenter x:Name="HeaderIcon" Grid.Column="0"
                                  VerticalAlignment="Center" Margin="0,0,8,0" />
                <TextBlock x:Name="HeaderText" Grid.Column="1"
                           FontSize="{DynamicResource FontSectionTitle}"
                           FontWeight="SemiBold"
                           VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis" />
                <Button x:Name="PrimaryActionButton" Grid.Column="2"
                        Style="{DynamicResource IconButtonStyle}"
                        Visibility="Collapsed" Margin="4,0,0,0" />
                <Button x:Name="CloseButton" Grid.Column="3"
                        Style="{DynamicResource IconButtonStyle}"
                        ToolTip="关闭侧栏" Click="Close_Click" Margin="4,0,0,0">
                    <Path Data="{StaticResource IconCloseWindow}"
                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                          StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                          Stretch="Uniform" Width="13" Height="13" />
                </Button>
            </Grid>
        </Border>

        <!-- Body：面板自带滚动区，这里不做二次滚动 -->
        <ContentPresenter x:Name="BodyHost" Grid.Row="1" />
    </Grid>
</UserControl>
