<UserControl x:Class="ResourceGrab.App.Controls.LoadingIndicator"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:ResourceGrab.App.Controls">
    <UserControl.Resources>
        <controls:NonEmptyToVisibilityConverter x:Key="NonEmptyToVis" />
    </UserControl.Resources>
    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
        <Path Data="{StaticResource IconLoading}"
              Stroke="{DynamicResource PrimaryBrush}" StrokeThickness="3"
              StrokeStartLineCap="Round" Stretch="Uniform"
              Width="{Binding RingSize, RelativeSource={RelativeSource AncestorType=UserControl}}"
              Height="{Binding RingSize, RelativeSource={RelativeSource AncestorType=UserControl}}"
              HorizontalAlignment="Center"
              RenderTransformOrigin="0.5,0.5">
            <Path.RenderTransform>
                <RotateTransform x:Name="RingRotation" />
            </Path.RenderTransform>
            <Path.Triggers>
                <EventTrigger RoutedEvent="Loaded">
                    <BeginStoryboard>
                        <Storyboard RepeatBehavior="Forever">
                            <DoubleAnimation Storyboard.TargetName="RingRotation"
                                             Storyboard.TargetProperty="Angle"
                                             From="0" To="360" Duration="0:0:0.9" />
                        </Storyboard>
                    </BeginStoryboard>
                </EventTrigger>
            </Path.Triggers>
        </Path>
        <TextBlock Text="{Binding Text, RelativeSource={RelativeSource AncestorType=UserControl}}"
                   Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=UserControl}}"
                   FontSize="13" FontWeight="SemiBold" Margin="0,12,0,0"
                   HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" />
        <TextBlock Text="{Binding SubText, RelativeSource={RelativeSource AncestorType=UserControl}}"
                   Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=UserControl}}"
                   Opacity="0.75" FontSize="12" Margin="0,4,0,0"
                   HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" MaxWidth="320"
                   Visibility="{Binding SubText, RelativeSource={RelativeSource AncestorType=UserControl},
                                        Converter={StaticResource NonEmptyToVis}}" />
    </StackPanel>
</UserControl>
