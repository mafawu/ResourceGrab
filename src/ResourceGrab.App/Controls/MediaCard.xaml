<UserControl x:Class="ResourceGrab.App.Controls.MediaCard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:common="clr-namespace:ResourceGrab.App.Common"
             UseLayoutRounding="True" SnapsToDevicePixels="True">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        <controls:NonEmptyToVisibilityConverter x:Key="NonEmptyToVis"
                                                xmlns:controls="clr-namespace:ResourceGrab.App.Controls" />
        <controls:FavoriteTextConverter x:Key="FavoriteTextConverter"
                                         xmlns:controls="clr-namespace:ResourceGrab.App.Controls" />
        <controls:BadgeBackgroundConverter x:Key="BadgeBackgroundConverter"
                                           xmlns:controls="clr-namespace:ResourceGrab.App.Controls" />
        <controls:BadgeForegroundConverter x:Key="BadgeForegroundConverter"
                                           xmlns:controls="clr-namespace:ResourceGrab.App.Controls" />
        <controls:MultiplyConverter x:Key="MultiplyConverter"
                                    xmlns:controls="clr-namespace:ResourceGrab.App.Controls" />

        <!-- 短剧封面悬停操作：详情 / 下载全部，两枚半透明胶囊 -->
        <Style x:Key="DramaHoverActionButton" TargetType="Button">
            <Setter Property="Height" Value="28" />
            <Setter Property="Padding" Value="10,0" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="14" Padding="{TemplateBinding Padding}"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                              TextElement.Foreground="{TemplateBinding Foreground}"
                                              TextElement.FontSize="{TemplateBinding FontSize}"
                                              TextElement.FontWeight="{TemplateBinding FontWeight}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.86" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.68" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- PortraitCover -->
        <DataTemplate x:Key="PortraitCoverTemplate">
            <Border CornerRadius="{DynamicResource RadiusLg}"
                    Background="{DynamicResource SurfaceBrush}"
                    BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1"
                    ClipToBounds="True" Cursor="Hand">
                <StackPanel>
                    <!-- 纵向封面高度跟随卡片宽度（2:3），列数变化时等比放大 -->
                    <Grid Height="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=Border}, Converter={StaticResource MultiplyConverter}, ConverterParameter=1.5}">
                        <Border Background="{DynamicResource HoverBgBrush}">
                            <TextBlock Text="{Binding CoverFallbackText}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                       FontSize="28" FontWeight="Bold"
                                       Foreground="{DynamicResource TextDisabledBrush}" />
                        </Border>
                        <Image Source="{Binding Cover}" Stretch="UniformToFill" />
                        <Border VerticalAlignment="Bottom" Padding="8,4"
                                Background="#80000000">
                            <TextBlock Text="{Binding Title}"
                                       Foreground="White" FontSize="{DynamicResource FontBody}"
                                       FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                        </Border>
                    </Grid>
                    <Border Padding="10,8">
                        <StackPanel>
                            <TextBlock Text="{Binding Subtitle}" FontSize="{DynamicResource FontCaption}"
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       TextTrimming="CharacterEllipsis" />
                            <ItemsControl ItemsSource="{Binding Badges}" Margin="0,4,0,0">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="{Binding Color, Converter={StaticResource BadgeBackgroundConverter}}"
                                                CornerRadius="{DynamicResource RadiusXs}"
                                                Padding="6,2" Margin="0,0,4,0">
                                            <TextBlock Text="{Binding Text}" FontSize="10" FontWeight="SemiBold"
                                                       Foreground="{Binding Color, Converter={StaticResource BadgeForegroundConverter}}" />
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>
        </DataTemplate>

        <!-- WideThumb：本地视频等横向缩略图卡片 -->
        <DataTemplate x:Key="WideThumbTemplate">
            <Border x:Name="CardRoot" CornerRadius="{DynamicResource RadiusLg}"
                    Background="{DynamicResource SurfaceBrush}"
                    BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1"
                    ClipToBounds="True" Cursor="Hand">
                <StackPanel>
                    <!-- 横向缩略图高度跟随卡片宽度（16:9），列数变化时等比放大；
                         封面原比例完整显示（Uniform），竖版海报两侧留白也不裁切 -->
                    <Grid Height="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=Border}, Converter={StaticResource MultiplyConverter}, ConverterParameter=0.5625}"
                          Background="{DynamicResource HoverBgBrush}">
                        <Border Background="{DynamicResource HoverBgBrush}">
                            <TextBlock Text="{Binding CoverFallbackText}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                       FontSize="22" FontWeight="Bold"
                                       Foreground="{DynamicResource TextDisabledBrush}" />
                        </Border>
                        <Image Source="{Binding Cover}" Stretch="Uniform" />
                        <!-- 未观看标记 -->
                        <Border Width="3" Height="24" HorizontalAlignment="Left" VerticalAlignment="Top"
                                Background="{DynamicResource PrimaryBrush}"
                                Visibility="{Binding ShowUnwatchedMark, Converter={StaticResource BoolToVis}}" />
                        <!-- 刮削状态徽章 -->
                        <Border HorizontalAlignment="Left" VerticalAlignment="Top" Margin="6"
                                CornerRadius="{DynamicResource RadiusXs}" Padding="6,1"
                                Visibility="{Binding ScrapeBadge.Text, Converter={StaticResource NonEmptyToVis}}">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Background" Value="Transparent" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding ScrapeBadge.BrushKey}" Value="SuccessBrush">
                                            <Setter Property="Background" Value="{DynamicResource SuccessBrush}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding ScrapeBadge.BrushKey}" Value="WarningBrush">
                                            <Setter Property="Background" Value="{DynamicResource WarningBrush}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding ScrapeBadge.BrushKey}" Value="DangerBrush">
                                            <Setter Property="Background" Value="{DynamicResource DangerBrush}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <TextBlock Text="{Binding ScrapeBadge.Text}" FontSize="10" FontWeight="Bold" Foreground="White" />
                        </Border>
                        <!-- 选中徽章（框选模式） -->
                        <Border Width="26" Height="26" Margin="6" CornerRadius="13"
                                HorizontalAlignment="Right" VerticalAlignment="Top"
                                Background="#80000000" BorderThickness="1"
                                BorderBrush="{DynamicResource PrimaryBrush}" Cursor="Hand"
                                Visibility="{Binding IsSelectable, Converter={StaticResource BoolToVis}}">
                            <Border.InputBindings>
                                <MouseBinding Command="{Binding SelectionCommand}" Gesture="LeftClick" />
                            </Border.InputBindings>
                            <TextBlock Text="✓" FontSize="14" FontWeight="Bold"
                                       Foreground="{DynamicResource PrimaryBrush}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                       Visibility="{Binding IsSelected, Converter={StaticResource BoolToVis}}" />
                        </Border>
                        <!-- 时长 / 分辨率角标 -->
                        <Border VerticalAlignment="Bottom" HorizontalAlignment="Right"
                                Padding="6,2" Margin="6"
                                Background="#CC000000" CornerRadius="{DynamicResource RadiusXs}"
                                Visibility="{Binding Subtitle, Converter={StaticResource NonEmptyToVis}}">
                            <TextBlock Text="{Binding Subtitle}" Foreground="White" FontSize="11" />
                        </Border>
                        <!-- 悬停操作浮层：播放 / 打开目录 -->
                        <Border x:Name="PlayOverlay" Background="{DynamicResource CardScrimBrush}">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsMouseOver, ElementName=CardRoot}" Value="True">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <TextBlock Text="▶ 播放" FontSize="13" FontWeight="SemiBold" Foreground="White"
                                           Cursor="Hand" ToolTip="播放">
                                    <TextBlock.InputBindings>
                                        <MouseBinding Command="{Binding PrimaryCommand}" Gesture="LeftClick" />
                                    </TextBlock.InputBindings>
                                </TextBlock>
                                <TextBlock Text="  打开目录" FontSize="13" Foreground="#DDFFFFFF"
                                           Margin="14,0,0,0" Cursor="Hand" ToolTip="打开所在目录">
                                    <TextBlock.InputBindings>
                                        <MouseBinding Command="{Binding SecondaryCommand}" Gesture="LeftClick" />
                                    </TextBlock.InputBindings>
                                </TextBlock>
                            </StackPanel>
                        </Border>
                        <!-- 收藏心形（悬停显示） -->
                        <TextBlock Text="{Binding IsFavorite, Converter={StaticResource FavoriteTextConverter}}"
                                   FontSize="15" Foreground="{DynamicResource TextSecondaryBrush}"
                                   HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,6,38,0"
                                   Cursor="Hand" ToolTip="收藏">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsMouseOver, ElementName=CardRoot}" Value="True">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                            <TextBlock.InputBindings>
                                <MouseBinding Command="{Binding FavoriteCommand}" Gesture="LeftClick" />
                            </TextBlock.InputBindings>
                        </TextBlock>
                    </Grid>
                    <Border Padding="10,8">
                        <StackPanel>
                            <TextBlock Text="{Binding Title}" FontWeight="SemiBold"
                                       FontSize="{DynamicResource FontCardTitle}"
                                       TextTrimming="CharacterEllipsis" />
                            <TextBlock Text="{Binding SecondaryTitle}" FontSize="10.5"
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       TextTrimming="CharacterEllipsis" Margin="0,2,0,0"
                                       Visibility="{Binding SecondaryTitle, Converter={StaticResource NonEmptyToVis}}" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>
        </DataTemplate>

        <!-- DramaCover：短剧 4:5 竖版。封面是唯一主角：角标/评分/集数压在封面上，
             标题与「类型 · 时间」在封面下方，卡片本身不加底与描边外框（由封面自己撑边界）。 -->
        <DataTemplate x:Key="DramaCoverTemplate">
            <StackPanel Cursor="Hand" Background="Transparent">
                <Border x:Name="DramaCoverRoot"
                        CornerRadius="{DynamicResource RadiusLg}" ClipToBounds="True"
                        BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1"
                        Background="{DynamicResource CardHoverBrush}">
                    <Grid Height="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=Border}, Converter={StaticResource MultiplyConverter}, ConverterParameter=1.25}">
                        <!-- 封面兜底层：图源拿不到/解不出时显示确定性渐变 + 剧名首字，
                             保证 6 列网格是"一面封面墙"而不是一排空盒子。真图能出时下面这层 Image 会盖住它。 -->
                        <Border Background="{Binding CoverPlaceholderBrush}">
                            <TextBlock Text="{Binding CoverFallbackText}" FontSize="40" FontWeight="Bold"
                                       Foreground="#59FFFFFF"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <Image common:ImageLoader.Source="{Binding CoverUrl}" Stretch="UniformToFill" />

                        <!-- 底部压暗：保证右下角集数在任何封面上都可读 -->
                        <Border VerticalAlignment="Bottom" Height="72" IsHitTestVisible="False">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                    <GradientStop Color="#00000000" Offset="0" />
                                    <GradientStop Color="#73000000" Offset="1" />
                                </LinearGradientBrush>
                            </Border.Background>
                        </Border>

                        <!-- 左上角标（新上/热播/高分/原创） -->
                        <Border HorizontalAlignment="Left" VerticalAlignment="Top" Margin="8"
                                CornerRadius="{DynamicResource RadiusXs}" Padding="7,2"
                                Background="{DynamicResource PrimarySubtleBrush}"
                                Visibility="{Binding ShowBadge, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="{Binding BadgeText}" FontSize="10.5" FontWeight="SemiBold"
                                       Foreground="{DynamicResource PrimaryLightBrush}" />
                        </Border>

                        <!-- 左上「本地」徽章（已下载）：状态用填充，绿底绿字 -->
                        <Border HorizontalAlignment="Left" VerticalAlignment="Top" Margin="8"
                                CornerRadius="{DynamicResource RadiusXs}" Padding="7,2"
                                Background="#263DD598"
                                Visibility="{Binding IsLocal, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="本地" FontSize="10.5" FontWeight="SemiBold"
                                       Foreground="{DynamicResource SuccessBrush}" />
                        </Border>

                        <!-- 右上评分 -->
                        <Border HorizontalAlignment="Right" VerticalAlignment="Top" Margin="8"
                                CornerRadius="{DynamicResource RadiusXs}" Padding="6,2"
                                Background="{DynamicResource CardScrimBrush}"
                                Visibility="{Binding ScoreText, Converter={StaticResource NonEmptyToVis}}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="★" FontSize="9" Margin="0,0,3,0"
                                           Foreground="{DynamicResource WarningBrush}"
                                           VerticalAlignment="Center" />
                                <TextBlock Text="{Binding ScoreText}" FontSize="11" FontWeight="Bold"
                                           Foreground="White" />
                            </StackPanel>
                        </Border>

                        <!-- 右下集数 / 已下载进度 -->
                        <Border HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="8"
                                CornerRadius="{DynamicResource RadiusXs}" Padding="7,2"
                                Background="{DynamicResource CardScrimBrush}"
                                Visibility="{Binding EpisodeText, Converter={StaticResource NonEmptyToVis}}">
                            <TextBlock Text="{Binding EpisodeText}" FontSize="10.5" FontWeight="SemiBold"
                                       Foreground="White" />
                        </Border>

                        <!-- 悬停：详情 / 下载全部（短剧默认全剧入队，已下载自动跳过） -->
                        <Border x:Name="DramaPlayOverlay" Background="#73000000" Visibility="Collapsed">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Button x:Name="DramaDetailAction" Width="52" Margin="0,0,5,0"
                                        Background="#66000000" BorderBrush="#59FFFFFF" BorderThickness="1"
                                        Foreground="White"
                                        Style="{StaticResource DramaHoverActionButton}"
                                        Command="{Binding OpenCommand}" ToolTip="打开详情">
                                    <TextBlock Text="详情" Foreground="White" FontSize="11.5" FontWeight="SemiBold" />
                                </Button>
                                <Button x:Name="DramaDownloadAction" Width="72"
                                        Background="#7C92FF" Foreground="White"
                                        Style="{StaticResource DramaHoverActionButton}"
                                        Command="{Binding DownloadCommand}"
                                        ToolTip="下载全部剧集（已下载的自动跳过）">
                                    <TextBlock Text="下载全部" Foreground="White" FontSize="11.5" FontWeight="SemiBold" />
                                </Button>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Border>

                <TextBlock Text="{Binding Title}" Margin="2,8,2,0"
                           FontSize="{DynamicResource FontCardTitle}" FontWeight="SemiBold"
                           Foreground="{DynamicResource TextPrimaryBrush}"
                           TextTrimming="CharacterEllipsis" />
                <TextBlock Text="{Binding Subtitle}" Margin="2,3,2,0"
                           FontSize="{DynamicResource FontCaption}"
                           Foreground="{DynamicResource TextDisabledBrush}"
                           TextTrimming="CharacterEllipsis"
                           Visibility="{Binding Subtitle, Converter={StaticResource NonEmptyToVis}}" />
            </StackPanel>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsMouseOver, ElementName=DramaCoverRoot}" Value="True">
                    <Setter TargetName="DramaPlayOverlay" Property="Visibility" Value="Visible" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsLocal}" Value="True">
                    <Setter TargetName="DramaDownloadAction" Property="Visibility" Value="Collapsed" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!-- TextCover -->
        <DataTemplate x:Key="TextCoverTemplate">
            <Border CornerRadius="{DynamicResource RadiusLg}"
                    Background="{DynamicResource SurfaceBrush}"
                    BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1"
                    Padding="14,12" Cursor="Hand">
                <StackPanel>
                    <Border Width="48" Height="48" CornerRadius="{DynamicResource RadiusMd}"
                            HorizontalAlignment="Left" Margin="0,0,0,6">
                        <Border.Background>
                            <SolidColorBrush Color="{DynamicResource PrimaryColor}" Opacity="0.12"/>
                        </Border.Background>
                        <TextBlock Text="{Binding CoverFallbackText}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                   FontSize="20" FontWeight="Bold"
                                   Foreground="{DynamicResource PrimaryBrush}" />
                    </Border>
                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold"
                               FontSize="{DynamicResource FontCardTitle}"
                               TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="{Binding Subtitle}" FontSize="{DynamicResource FontCaption}"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               TextTrimming="CharacterEllipsis" />
                </StackPanel>
            </Border>
        </DataTemplate>

        <local:MediaCardTemplateSelector x:Key="CardTemplateSelector"
            PortraitTemplate="{StaticResource PortraitCoverTemplate}"
            WideThumbTemplate="{StaticResource WideThumbTemplate}"
            TextCoverTemplate="{StaticResource TextCoverTemplate}"
            DramaTemplate="{StaticResource DramaCoverTemplate}"
            xmlns:local="clr-namespace:ResourceGrab.App.Controls" />
    </UserControl.Resources>

    <ContentControl Content="{Binding}" ContentTemplateSelector="{StaticResource CardTemplateSelector}" />
</UserControl>
