<UserControl x:Class="ResourceGrab.App.Controls.MediaCard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <!-- PortraitCover -->
        <DataTemplate x:Key="PortraitCoverTemplate">
            <Border CornerRadius="{DynamicResource RadiusLg}"
                    Background="{DynamicResource SurfaceBrush}"
                    BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1"
                    ClipToBounds="True" Cursor="Hand">
                <StackPanel>
                    <Grid Height="160">
                        <Border Background="{DynamicResource HoverBgBrush}">
                            <TextBlock Text="{Binding CoverFallbackText}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                       FontSize="28" FontWeight="Bold"
                                       Foreground="{DynamicResource TextDisabledBrush}" />
                        </Border>
                        <Image Source="{Binding Cover}" Stretch="UniformToFill" />
                        <Border VerticalAlignment="Bottom" Padding="8,4"
                                Background="#80000000">
                            <TextBlock Text="{Binding Title}"
                                       Foreground="White" FontSize="{DynamicResource FontBody}"
                                       FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                        </Border>
                    </Grid>
                    <Border Padding="10,8">
                        <StackPanel>
                            <TextBlock Text="{Binding Subtitle}" FontSize="{DynamicResource FontCaption}"
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       TextTrimming="CharacterEllipsis" />
                            <ItemsControl ItemsSource="{Binding Badges}" Margin="0,4,0,0">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="{DynamicResource PrimarySubtleBrush}"
                                                CornerRadius="{DynamicResource RadiusPill}"
                                                Padding="6,2" Margin="0,0,4,0">
                                            <TextBlock Text="{Binding Text}" FontSize="10"
                                                       Foreground="{DynamicResource PrimaryBrush}" />
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>
        </DataTemplate>

        <!-- WideThumb -->
        <DataTemplate x:Key="WideThumbTemplate">
            <Border CornerRadius="{DynamicResource RadiusLg}"
                    Background="{DynamicResource SurfaceBrush}"
                    BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1"
                    ClipToBounds="True" Cursor="Hand">
                <StackPanel>
                    <Grid Height="100">
                        <Border Background="{DynamicResource HoverBgBrush}">
                            <TextBlock Text="{Binding CoverFallbackText}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                       FontSize="22" FontWeight="Bold"
                                       Foreground="{DynamicResource TextDisabledBrush}" />
                        </Border>
                        <Image Source="{Binding Cover}" Stretch="UniformToFill" />
                        <Border VerticalAlignment="Bottom" HorizontalAlignment="Right"
                                Padding="6,2" Margin="6"
                                Background="#CC000000" CornerRadius="{DynamicResource RadiusXs}">
                            <TextBlock Text="{Binding Subtitle}" Foreground="White" FontSize="11" />
                        </Border>
                    </Grid>
                    <Border Padding="10,8">
                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold"
                                   FontSize="{DynamicResource FontCardTitle}"
                                   TextTrimming="CharacterEllipsis" />
                    </Border>
                </StackPanel>
            </Border>
        </DataTemplate>

        <!-- TextCover -->
        <DataTemplate x:Key="TextCoverTemplate">
            <Border CornerRadius="{DynamicResource RadiusLg}"
                    Background="{DynamicResource SurfaceBrush}"
                    BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1"
                    Padding="14,12" Cursor="Hand">
                <StackPanel>
                    <Border Width="48" Height="48" CornerRadius="{DynamicResource RadiusMd}"
                            HorizontalAlignment="Left" Margin="0,0,0,6">
                        <Border.Background>
                            <SolidColorBrush Color="{DynamicResource PrimaryColor}" Opacity="0.12"/>
                        </Border.Background>
                        <TextBlock Text="{Binding CoverFallbackText}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                   FontSize="20" FontWeight="Bold"
                                   Foreground="{DynamicResource PrimaryBrush}" />
                    </Border>
                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold"
                               FontSize="{DynamicResource FontCardTitle}"
                               TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="{Binding Subtitle}" FontSize="{DynamicResource FontCaption}"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               TextTrimming="CharacterEllipsis" />
                </StackPanel>
            </Border>
        </DataTemplate>

        <local:MediaCardTemplateSelector x:Key="CardTemplateSelector"
            PortraitTemplate="{StaticResource PortraitCoverTemplate}"
            WideThumbTemplate="{StaticResource WideThumbTemplate}"
            TextCoverTemplate="{StaticResource TextCoverTemplate}"
            xmlns:local="clr-namespace:ResourceGrab.App.Controls" />
    </UserControl.Resources>

    <ContentControl Content="{Binding}" ContentTemplateSelector="{StaticResource CardTemplateSelector}" />
</UserControl>
