<UserControl x:Class="ResourceGrab.App.Controls.AlbumCard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:common="clr-namespace:ResourceGrab.App.Common"
             Margin="0,0,14,14"
             SizeChanged="Card_SizeChanged">
    <Grid x:Name="Root" Cursor="Hand" MouseEnter="Root_MouseEnter" MouseLeave="Root_MouseLeave" MouseLeftButtonUp="Root_MouseLeftButtonUp">
        <Grid.ToolTip>
            <ToolTip MaxWidth="360" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" Padding="10">
                <StackPanel MaxWidth="340">
                    <TextBlock Text="{Binding Name}" FontSize="13" FontWeight="Bold" TextWrapping="Wrap" />
                    <TextBlock Text="{Binding AuthorText}" Style="{StaticResource AlbumAuthorToolTipTextStyle}" />
                </StackPanel>
            </ToolTip>
        </Grid.ToolTip>
        <Border Style="{StaticResource ComicCardBorderStyle}">
            <StackPanel>
                <Border x:Name="CoverHost" CornerRadius="14,14,0,0" Style="{StaticResource CardCoverHostStyle}">
                    <Grid>
                        <Image common:ImageLoader.Source="{Binding CoverUrl}" common:ImageLoader.Headers="{Binding ImageHeaders}" Stretch="UniformToFill" />
                        <Border VerticalAlignment="Bottom" Height="40" Opacity="0.85">
                            <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1"><GradientStop Color="Transparent" Offset="0"/><GradientStop Color="{StaticResource CardScrimColor}" Offset="1"/></LinearGradientBrush>
                            </Border.Background>
                        </Border>
                        <Border Style="{StaticResource AlbumKindBadgeStyle}">
                            <TextBlock Text="漫" Style="{StaticResource KindBadgeTextStyle}"/>
                        </Border>
                        <Border Style="{StaticResource AlbumSourceBadgeStyle}">
                            <TextBlock Text="{Binding SourceBadge}" FontSize="10" Foreground="White" FontWeight="Bold"/>
                        </Border>
                        <Border x:Name="Overlay" Background="{DynamicResource CardScrimBrush}" Visibility="Collapsed" CornerRadius="14,14,0,0">
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Button Style="{StaticResource PrimaryButtonStyle}" MinWidth="64"
                                        Content="详情"
                                        Click="ViewDetailButton_Click" />
                                <Button Style="{StaticResource PrimaryButtonStyle}" Margin="0,8,0,0"
                                        MinWidth="64"
                                        ToolTip="一键下载全部章节"
                                        Command="{Binding DownloadCommand}"
                                        Click="DownloadAllButton_Click"
                                        Content="下载" />
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource DownloadedBadgeStyle}">
                            <TextBlock Text="✓ 已下载" FontSize="10" Foreground="White" FontWeight="Bold"/>
                        </Border>
                    </Grid>
                </Border>
                <StackPanel Margin="10,10,10,12" MinHeight="48">
                    <Grid MinHeight="32">
                        <TextBlock Text="{Binding Name}" Style="{StaticResource CardTitleTextStyle}" common:TextBlockExt.MaxLines="2" LineHeight="16" />
                    </Grid>
                    <TextBlock Text="{Binding AuthorText}" Style="{StaticResource CardSubtitleTextStyle}" Margin="0,4,0,0" MaxHeight="16" />
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
