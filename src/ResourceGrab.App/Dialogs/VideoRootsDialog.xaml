<Window x:Class="ResourceGrab.App.Dialogs.VideoRootsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="视频根目录管理" Width="620" Height="420"
        WindowStartupLocation="CenterOwner" Background="{DynamicResource SurfaceBrush}">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Text="已保存的视频根目录" FontSize="16" FontWeight="Bold" />
        <ListBox x:Name="RootList" Grid.Row="1" Margin="0,14,0,14"
                 Background="{DynamicResource HoverBgBrush}" BorderThickness="0" />

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button x:Name="RemoveButton" Style="{StaticResource LibraryActionButtonStyle}"
                    Content="移除所选目录" Click="RemoveRoot_Click" />
            <Button x:Name="CloseButton" Style="{StaticResource LibraryPrimaryButtonStyle}"
                    Content="关闭" Margin="10,0,0,0" Click="Close_Click" />
        </StackPanel>
    </Grid>
</Window>
