<Window x:Class="ResourceGrab.App.Dialogs.SettingsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="设置" Width="552" SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        UseLayoutRounding="True"
        Background="{DynamicResource SurfaceBrush}"
        MouseLeftButtonDown="Window_MouseLeftButtonDown">
    <!-- 不用 AllowsTransparency（分层窗口 = 软件渲染 + 每帧把 DirectX 结果整幅像素拷贝到 GDI）；
         WindowChrome 保持硬件加速，底部 1px 玻璃帧让 DWM 绘制窗口阴影，圆角由 DWM 裁剪（见 OnSourceInitialized） -->
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0"
                      ResizeBorderThickness="0"
                      GlassFrameThickness="0,0,0,1"
                      CornerRadius="0"
                      UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>
    <Border Background="{DynamicResource SurfaceBrush}"
            BorderBrush="{DynamicResource CardBorderBrush}"
            BorderThickness="1"
            CornerRadius="16"
            Padding="26,22">
        <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="680">
        <StackPanel>
            <Grid>
                <TextBlock Text="设置" FontSize="17" FontWeight="Bold" VerticalAlignment="Center" />
                <Button Style="{StaticResource IconButtonStyle}"
                        HorizontalAlignment="Right" VerticalAlignment="Center"
                        Click="CloseButton_Click" ToolTip="关闭">
                    <Path Data="{StaticResource IconClose}" Stroke="{DynamicResource TextPrimaryBrush}" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Stretch="Uniform" Width="16" Height="16" />
                </Button>
            </Grid>

            <TextBlock Text="下载设置" FontSize="13" FontWeight="Bold" Margin="0,16,0,0" />
            <Grid Margin="0,10,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="96" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock Text="下载目录" Grid.Row="0" VerticalAlignment="Center"
                           FontSize="12.5" Foreground="{DynamicResource TextSecondaryBrush}" />
                <Grid Grid.Row="0" Grid.Column="1" Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="DownloadDirBox" Padding="8,6" VerticalAlignment="Center" />
                    <Button Grid.Column="1" Style="{StaticResource GhostButtonStyle}" Content="浏览…"
                            Margin="8,0,0,0" VerticalAlignment="Center"
                            Click="BrowseDownloadDir_Click" />
                </Grid>

                <TextBlock Text="图片格式" Grid.Row="1" VerticalAlignment="Center"
                           FontSize="12.5" Foreground="{DynamicResource TextSecondaryBrush}" />
                <ComboBox x:Name="FormatBox" Grid.Row="1" Grid.Column="1" Width="160"
                          HorizontalAlignment="Left" Margin="0,0,0,10" VerticalAlignment="Center">
                    <ComboBoxItem Content="JPEG" Tag="Jpeg" />
                    <ComboBoxItem Content="PNG" Tag="Png" />
                    <ComboBoxItem Content="WEBP" Tag="Webp" />
                </ComboBox>

                <TextBlock Text="接口域名" Grid.Row="2" VerticalAlignment="Center"
                           FontSize="12.5" Foreground="{DynamicResource TextSecondaryBrush}" />
                <TextBox x:Name="ApiDomainsBox" Grid.Row="2" Grid.Column="1"
                         Margin="0,0,0,4" Padding="8,6" Height="64"
                         AcceptsReturn="True" TextWrapping="Wrap"
                         VerticalScrollBarVisibility="Auto" VerticalAlignment="Top" />

                <TextBlock Text="多个域名用逗号分隔，请求失败自动切换；留空使用默认列表" Grid.Row="3" Grid.Column="1"
                           FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" />
            </Grid>

            <TextBlock Text="阅读设置" FontSize="13" FontWeight="Bold" Margin="0,16,0,0" />
            <Grid Margin="0,10,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="96" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <TextBlock Text="滚动速度" Grid.Row="0" VerticalAlignment="Center"
                           FontSize="12.5" Foreground="{DynamicResource TextSecondaryBrush}" />
                <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Slider x:Name="ScrollSpeedSlider" Width="200" Minimum="0.3" Maximum="3.0"
                            TickFrequency="0.1" IsSnapToTickEnabled="True" AutoToolTipPlacement="BottomRight"
                            TickPlacement="BottomRight" VerticalAlignment="Center"
                            ValueChanged="ScrollSpeedSlider_ValueChanged"/>
                    <TextBlock x:Name="ScrollSpeedValueText" Margin="10,0,0,0" VerticalAlignment="Center"
                               FontSize="12.5" FontWeight="Bold" MinWidth="40"/>
                </StackPanel>
                <TextBlock Text="仅滚动模式生效：0.3 慢 — 1.0 默认 — 3.0 快，可在阅读页即时调节" Grid.Row="1" Grid.Column="1"
                           FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,4,0,0"/>
            </Grid>

            <TextBlock Text="本地管理" FontSize="13" FontWeight="Bold" Margin="0,16,0,0" />
            <Grid Margin="0,10,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="96" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <TextBlock Text="本地路径" Grid.Row="0" VerticalAlignment="Center"
                           FontSize="12.5" Foreground="{DynamicResource TextSecondaryBrush}" />
                <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Style="{StaticResource GhostButtonStyle}" Content="管理本地路径…"
                            Click="ManageLocalDirs_Click" Padding="10,5" />
                    <Button Style="{StaticResource GhostButtonStyle}" Content="刷新本地"
                            Margin="8,0,0,0" Click="RefreshLocal_Click" Padding="10,5" />
                    <Button Style="{StaticResource GhostButtonStyle}" Content="查看日志"
                            Margin="8,0,0,0" Click="ViewLogs_Click" Padding="10,5" />
                </StackPanel>
                <TextBlock Text="管理本地漫画扫描目录、重新扫描本地库、打开日志/数据目录" Grid.Row="1" Grid.Column="1"
                           FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,4,0,0"/>
            </Grid>

            <TextBlock Text="标题翻译（中文名）" FontSize="13" FontWeight="Bold" Margin="0,14,0,0" />
            <CheckBox x:Name="TranslateEnabledBox"
                      Content="启用翻译（扫描时自动为缺失中文名的漫画翻译标题）"
                      Margin="0,10,0,0" FontSize="12.5" />
            <Grid Margin="0,10,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="96" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock Text="接口地址" Grid.Row="0" VerticalAlignment="Center"
                           FontSize="12.5" Foreground="{DynamicResource TextSecondaryBrush}" />
                <TextBox x:Name="TranslateBaseUrlBox" Grid.Row="0" Grid.Column="1"
                         Margin="0,0,0,10" Padding="8,6" VerticalAlignment="Center" />

                <TextBlock Text="API Key" Grid.Row="1" VerticalAlignment="Center"
                           FontSize="12.5" Foreground="{DynamicResource TextSecondaryBrush}" />
                <TextBox x:Name="TranslateApiKeyBox" Grid.Row="1" Grid.Column="1"
                         Margin="0,0,0,10" Padding="8,6" VerticalAlignment="Center" />

                <TextBlock Text="模型" Grid.Row="2" VerticalAlignment="Center"
                           FontSize="12.5" Foreground="{DynamicResource TextSecondaryBrush}" />
                <TextBox x:Name="TranslateModelBox" Grid.Row="2" Grid.Column="1"
                         Padding="8,6" VerticalAlignment="Center" />
            </Grid>

            <TextBlock Text="视频刮削" FontSize="13" FontWeight="Bold" Margin="0,14,0,0" />
            <CheckBox x:Name="ScrapeEnabledBox" Content="启用视频刮削（添加文件后自动补齐元数据）" Margin="0,10,0,0" FontSize="12.5" />
            <Grid Margin="0,10,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="96" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock Text="代理" Grid.Row="0" VerticalAlignment="Center" FontSize="12.5" Foreground="{DynamicResource TextSecondaryBrush}" />
                <TextBox x:Name="ScrapeProxyBox" Grid.Row="0" Grid.Column="1" Padding="8,6" VerticalAlignment="Center" />

                <TextBlock Text="JavBus 地址" Grid.Row="1" VerticalAlignment="Center" FontSize="12.5" Foreground="{DynamicResource TextSecondaryBrush}" />
                <TextBox x:Name="JavBusUrlBox" Grid.Row="1" Grid.Column="1" Margin="0,10,0,10" Padding="8,6" VerticalAlignment="Center" />

                <TextBlock Text="Cookie" Grid.Row="2" VerticalAlignment="Center" FontSize="12.5" Foreground="{DynamicResource TextSecondaryBrush}"
                           ToolTip="从浏览器复制 JavBus 的 Cookie，用于通过年龄验证 / Cloudflare 检测。格式：PHPSESSID=xxx; existmag=mag" />
                <TextBox x:Name="JavBusCookieBox" Grid.Row="2" Grid.Column="1" Margin="0,0,0,4" Padding="8,6" VerticalAlignment="Center"
                         ToolTip="从浏览器复制 JavBus 的 Cookie，用于通过年龄验证 / Cloudflare 检测。格式：PHPSESSID=xxx; existmag=mag" />

                <TextBlock Grid.Row="2" Grid.Column="1" Margin="0,32,0,10" FontSize="10.5"
                       Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap"
                       Text="浏览器 F12 → Network → 任意请求 → Request Headers → Cookie 值整段复制粘贴到这里"/>

                <TextBlock Text="JavDB 地址" Grid.Row="3" VerticalAlignment="Center" FontSize="12.5" Foreground="{DynamicResource TextSecondaryBrush}" />
                <TextBox x:Name="JavDbUrlBox" Grid.Row="4" Grid.Column="1" Margin="0,0,0,10" Padding="8,6" VerticalAlignment="Center"
                         ToolTip="JavDB 提供中文标题、评分、短评、剧照；域名经常更换，填当前可用的镜像地址（如 javdb575.com）" />
                <CheckBox x:Name="AutoScrapeNewFilesBox" Content="自动刮削新增文件" Grid.Row="5" Grid.Column="1" FontSize="12.5" />
                <CheckBox x:Name="WriteNfoBox" Content="生成 Kodi / Jellyfin 兼容 NFO" Grid.Row="6" Grid.Column="1" Margin="0,8,0,0" FontSize="12.5" />
                <CheckBox x:Name="AiravEnabledBox" Content="使用 AirAv 补充中文标题和简介" Grid.Row="7" Grid.Column="1" Margin="0,8,0,0" FontSize="12.5"
                          ToolTip="JavDB 没有中文译名或简介时，从 AirAv 补齐；失败不影响其他刮削数据。" />
            </Grid>

            <TextBlock Text="视频库管理" FontSize="13" FontWeight="Bold" Margin="0,14,0,0" />
            <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                <Button Style="{StaticResource GhostButtonStyle}" Content="清空视频库…"
                        Click="ClearVideoLibrary_Click" Padding="10,5" ToolTip="移除所有视频记录，不删除磁盘文件" />
                <Button Style="{StaticResource GhostButtonStyle}" Content="打开日志目录"
                        Margin="8,0,0,0" Click="ViewLogs_Click" Padding="10,5" />
            </StackPanel>
            <TextBlock Text="清空后需重新「添加文件夹」导入视频；封面缓存和刮削数据保留但不再关联"
                       FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,4,0,0"/>

            <TextBlock x:Name="ErrorText" FontSize="12"
                       Foreground="{DynamicResource DangerBrush}"
                       Margin="0,10,0,0" Visibility="Collapsed" />

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
                <Button Style="{StaticResource GhostButtonStyle}" Content="取消"
                        Click="CancelButton_Click" />
                <Button Style="{StaticResource PrimaryButtonStyle}" Content="保存"
                        Margin="10,0,0,0" Click="SaveButton_Click" />
            </StackPanel>
        </StackPanel>
        </ScrollViewer>
    </Border>
</Window>
