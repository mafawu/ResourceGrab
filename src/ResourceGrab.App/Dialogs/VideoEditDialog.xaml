<Window x:Class="ResourceGrab.App.Dialogs.VideoEditDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:ResourceGrab.App.Controls"
        Title="编辑视频信息" Width="560" Height="660" MinWidth="520" MinHeight="520"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        ResizeMode="CanResize"
        ShowInTaskbar="False"
        UseLayoutRounding="True"
        Background="{DynamicResource SurfaceBrush}"
        MouseLeftButtonDown="Window_MouseLeftButtonDown">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0"
                      ResizeBorderThickness="6"
                      GlassFrameThickness="0,0,0,1"
                      CornerRadius="0"
                      UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>
    <Border Background="{DynamicResource SurfaceBrush}"
            BorderBrush="{DynamicResource CardBorderBrush}"
            BorderThickness="1"
            CornerRadius="16">
        <Grid Margin="26,22">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- 标题栏 -->
            <Grid Grid.Row="0">
                <TextBlock x:Name="HeaderText" Text="编辑视频信息" FontSize="17" FontWeight="Bold"
                           VerticalAlignment="Center" />
                <Button Style="{StaticResource IconButtonStyle}"
                        HorizontalAlignment="Right" VerticalAlignment="Center"
                        Click="CloseButton_Click" ToolTip="关闭">
                    <Path Data="{StaticResource IconClose}" Stroke="{DynamicResource TextPrimaryBrush}" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Stretch="Uniform" Width="16" Height="16" />
                </Button>
            </Grid>

            <!-- 表单 -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,14,0,0">
                <StackPanel>
                    <TextBlock Text="名称" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" />
                    <TextBox x:Name="NameBox" Style="{StaticResource ModernTextBoxStyle}" Margin="0,4,0,12" />

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="14" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="系列名" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" />
                            <TextBox x:Name="SeriesBox" Style="{StaticResource ModernTextBoxStyle}" Margin="0,4,0,12" />
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="导演" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" />
                            <TextBox x:Name="DirectorBox" Style="{StaticResource ModernTextBoxStyle}" Margin="0,4,0,12" />
                        </StackPanel>
                    </Grid>

                    <TextBlock Text="标签（回车 / 逗号添加）" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" />
                    <controls:TagEditorInput x:Name="TagsEditor" Margin="0,4,0,12" />

                    <TextBlock Text="演员" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" />
                    <controls:TagEditorInput x:Name="ActorsEditor" Margin="0,4,0,12" />

                    <TextBlock Text="声优" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" />
                    <controls:TagEditorInput x:Name="VoiceActorsEditor" Margin="0,4,0,12" />

                    <TextBlock Text="制作组" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" />
                    <controls:TagEditorInput x:Name="ProductionTeamEditor" Margin="0,4,0,12" />

                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,0,12">
                        <TextBlock Text="评分" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}"
                                   VerticalAlignment="Center" Margin="0,0,10,0" />
                        <StackPanel x:Name="RatingStars" Orientation="Horizontal" />
                        <TextBlock x:Name="RatingClear" Text="清除" FontSize="11" Cursor="Hand"
                                   Foreground="{DynamicResource TextSecondaryBrush}" Margin="10,0,0,0"
                                   VerticalAlignment="Center" MouseLeftButtonUp="RatingClear_Click" />
                    </StackPanel>

                    <TextBlock Text="描述" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" />
                    <TextBox x:Name="DescriptionBox" Style="{StaticResource ModernTextBoxStyle}"
                             Margin="0,4,0,12" MinHeight="64"
                             AcceptsReturn="True" TextWrapping="Wrap"
                             VerticalContentAlignment="Top"
                             VerticalScrollBarVisibility="Auto" />

                    <TextBlock Text="备注" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" />
                    <TextBox x:Name="NotesBox" Style="{StaticResource ModernTextBoxStyle}"
                             Margin="0,4,0,4" MinHeight="48"
                             AcceptsReturn="True" TextWrapping="Wrap"
                             VerticalContentAlignment="Top"
                             VerticalScrollBarVisibility="Auto" />
                </StackPanel>
            </ScrollViewer>

            <!-- 底部按钮 -->
            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
                <Button Style="{StaticResource GhostButtonStyle}" Content="取消"
                        Click="CancelButton_Click" />
                <Button Style="{StaticResource PrimaryButtonStyle}" Content="保存"
                        Margin="10,0,0,0" Padding="22,7" Click="SaveButton_Click" />
            </StackPanel>
        </Grid>
    </Border>
</Window>
