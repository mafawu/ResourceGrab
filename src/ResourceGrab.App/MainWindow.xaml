<Window x:Class="ResourceGrab.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:views="clr-namespace:ResourceGrab.App.Views"
        xmlns:controls="clr-namespace:ResourceGrab.App.Controls"
        Title="抓资源"
        Width="1440" Height="900"
        MinWidth="1200" MinHeight="750"
        UseLayoutRounding="True"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        ResizeMode="CanResize"
        StateChanged="Window_StateChanged">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="48"
                      ResizeBorderThickness="6"
                      GlassFrameThickness="0"
                      CornerRadius="0"
                      UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>
    <Window.Background>
        <DynamicResource ResourceKey="AppBackgroundBrush" />
    </Window.Background>

    <!-- 淡雅外框：窗口由 DWM 圆角（8px），边框圆角略小（6px）保证弧线处边框完整 -->
    <Border BorderBrush="{DynamicResource WindowBorderBrush}"
            BorderThickness="1" CornerRadius="6"
            Padding="0" Margin="0"
            Background="{DynamicResource AppBackgroundBrush}"
            ClipToBounds="True">
        <Border CornerRadius="5" ClipToBounds="True"
                Background="{DynamicResource AppBackgroundBrush}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- 顶部应用栏：品牌 + 源切换 + 操作区 + 窗口控制 -->
        <Border Grid.Row="0" Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource DividerBrush}" BorderThickness="0,0,0,1"
                Padding="18,8,6,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- 品牌 -->
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Grid Width="32" Height="32">
                        <!-- 专用阴影层：渐变背景 + 光晕，不承载文字 -->
                        <Border CornerRadius="10" Effect="{StaticResource CardShadowEffect}">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Color="{DynamicResource PrimaryGradientStartColor}" Offset="0" />
                                    <GradientStop Color="{DynamicResource PrimaryGradientEndColor}" Offset="1" />
                                </LinearGradientBrush>
                            </Border.Background>
                        </Border>
                        <!-- 内容层：文字不挂 Effect，避免被光栅化变糊 -->
                        <Border CornerRadius="10">
                            <TextBlock Text="JM" Foreground="White" FontSize="12" FontWeight="Bold"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </Grid>
                    <TextBlock Text="JM 下载器" FontSize="14" FontWeight="Bold"
                               Margin="10,0,0,0" VerticalAlignment="Center" />
                    <Border Style="{StaticResource KindPillGroupStyle}" Margin="16,0,0,0" VerticalAlignment="Center" shell:WindowChrome.IsHitTestVisibleInChrome="True">
                        <StackPanel Orientation="Horizontal">
                            <RadioButton x:Name="KindMangaPill" Content="漫画" IsChecked="True" Style="{StaticResource KindPillRadioStyle}" Tag="Manga" GroupName="KindGroup" Click="KindPill_Click"/>
                            <RadioButton x:Name="KindVideoPill" Content="视频" Style="{StaticResource KindPillRadioStyle}" Tag="Video" GroupName="KindGroup" Margin="2,0,0,0" Click="KindPill_Click"/>
                            <RadioButton x:Name="KindNovelPill" Content="本地小说" Style="{StaticResource KindPillRadioStyle}" Tag="Novel" GroupName="KindGroup" Margin="2,0,0,0" Click="KindPill_Click"/>
                        </StackPanel>
                    </Border>
                </StackPanel>

                                <!-- 操作区：按 漫画/视频/小说 切换 -->
                <Grid Grid.Column="1" Margin="0,0,10,0" VerticalAlignment="Center" shell:WindowChrome.IsHitTestVisibleInChrome="True">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <!-- 动态区：随漫画/视频/小说切换 -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,12,0">
                        <StackPanel x:Name="MangaTopActions" Orientation="Horizontal" VerticalAlignment="Center">
                            <Border CornerRadius="6" Background="{DynamicResource PrimarySubtleBrush}" Padding="8,4" VerticalAlignment="Center">
                                <TextBlock Text="漫画" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryBrush}"/>
                            </Border>
                            <TextBlock Text="在线搜索与本地浏览" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="8,0,0,0"/>
                        </StackPanel>
                        <StackPanel x:Name="VideoTopActions" Orientation="Horizontal" VerticalAlignment="Center" Visibility="Collapsed">
                            <Border CornerRadius="6" Background="{DynamicResource WarningSubtleBrush}" Padding="8,4" VerticalAlignment="Center">
                                <TextBlock Text="视频" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource WarningBrush}"/>
                            </Border>
                            <TextBlock Text="敬请期待" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="8,0,0,0"/>
                        </StackPanel>
                    </StackPanel>
                    <!-- 全局通用区 -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Style="{StaticResource IconButtonStyle}" ToolTip="设置" Click="Settings_Click">
                            <Path Data="{StaticResource IconSetting}" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Stretch="Uniform" Width="16" Height="16" />
                        </Button>
                        <Button Style="{StaticResource IconButtonStyle}" ToolTip="打开配置目录" Margin="4,0,0,0" Click="OpenConfigDir_Click">
                            <Path Data="{StaticResource IconFolderOpen}" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Stretch="Uniform" Width="16" Height="16" />
                        </Button>
                        <Button x:Name="ThemeButton" Style="{StaticResource IconButtonStyle}" ToolTip="切换深浅色主题" Margin="4,0,0,0" Click="ThemeToggle_Click">
                            <Path x:Name="ThemeIcon" Data="{StaticResource IconMoon}" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Stretch="Uniform" Width="16" Height="16" />
                        </Button>
                        <Button x:Name="PanelToggleButton" Style="{StaticResource IconButtonStyle}" ToolTip="显示/隐藏侧栏" Margin="4,0,0,0" Click="PanelToggle_Click">
                            <Path Data="{StaticResource IconPanelToggle}" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Stretch="Uniform" Width="16" Height="16" />
                        </Button>
                    </StackPanel>
                </Grid>

                <!-- 窗口控制 -->
                <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Stretch"
                            shell:WindowChrome.IsHitTestVisibleInChrome="True">
                    <Border Width="1" Height="18" Background="{DynamicResource DividerBrush}"
                            VerticalAlignment="Center" Margin="8,0,8,0" />
                    <Button x:Name="MinimizeButton" Style="{StaticResource WindowButtonStyle}"
                            ToolTip="最小化" Click="MinimizeButton_Click">
                        <Path Data="{StaticResource IconMinimize}"
                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                              StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                              Stretch="Uniform" Width="13" Height="13" />
                    </Button>
                    <Button x:Name="MaximizeButton" Style="{StaticResource WindowButtonStyle}"
                            ToolTip="最大化" Click="MaximizeButton_Click">
                        <Path x:Name="MaximizeIcon"
                              Data="{StaticResource IconMaximize}"
                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                              StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                              Stretch="Uniform" Width="13" Height="13" />
                    </Button>
                    <Button Style="{StaticResource WindowCloseButtonStyle}"
                            ToolTip="关闭" Click="CloseButton_Click">
                        <Path Data="{StaticResource IconCloseWindow}"
                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                              StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                              Stretch="Uniform" Width="13" Height="13" />
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 主体：左侧导航栏 + 内容区 + 右侧面板 -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition x:Name="PanelColumn" Width="0" MinWidth="0" MaxWidth="440" />
            </Grid.ColumnDefinitions>

            <!-- 左侧霓虹导航栏：阴影/背景只挂在专用层上，内容层不挂 Effect 保持文字清晰 -->
            <Grid x:Name="LeftNavHost" Grid.Column="0" Width="196" Margin="14,14,0,14">
                <Border Background="{DynamicResource SurfaceBrush}"
                        BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1"
                        CornerRadius="18"
                        Effect="{StaticResource CardShadowEffect}" />
                <Border CornerRadius="18" Padding="10,12">
                    <DockPanel>
                        <StackPanel x:Name="AccountHost" DockPanel.Dock="Bottom" Margin="2,8,2,0" />
                        <StackPanel>
                    <!-- 旧导航项（兼容层，视觉隐藏） -->
                    <StackPanel x:Name="LegacyNavItems" Visibility="Collapsed">
                    <!-- 发现 -->
                    <TextBlock Text="发现" FontSize="10.5" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextDisabledBrush}"
                               Margin="12,4,0,6" />
                    <RadioButton x:Name="NavSearch" GroupName="Nav"
                                 Style="{StaticResource NavItemStyle}" IsChecked="True"
                                 Click="Nav_Checked">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Border Width="28" Height="28" CornerRadius="9" Margin="-2,0,0,0" Background="Transparent" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" SnapsToDevicePixels="True" VerticalAlignment="Center">
                                <Path Data="{StaticResource IconSearch}"
                                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"
                                      StrokeThickness="1.55" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                      Stretch="Uniform" Width="15" Height="15" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <TextBlock Text="搜索" Margin="10,0,0,0" FontWeight="SemiBold" VerticalAlignment="Center" />
                        </StackPanel>
                    </RadioButton>
                    <RadioButton x:Name="NavRank" GroupName="Nav"
                                 Style="{StaticResource NavItemStyle}"
                                 Click="Nav_Checked">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Border Width="28" Height="28" CornerRadius="9" Margin="-2,0,0,0" Background="Transparent" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" SnapsToDevicePixels="True" VerticalAlignment="Center">
                                <Path Data="{StaticResource IconRank}"
                                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"
                                      StrokeThickness="1.55" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                      Stretch="Uniform" Width="15" Height="15" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <TextBlock Text="排行" Margin="10,0,0,0" FontWeight="SemiBold" VerticalAlignment="Center" />
                        </StackPanel>
                    </RadioButton>
                    <RadioButton x:Name="NavCategory" GroupName="Nav"
                                 Style="{StaticResource NavItemStyle}"
                                 Click="Nav_Checked">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Border Width="28" Height="28" CornerRadius="9" Margin="-2,0,0,0" Background="Transparent" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" SnapsToDevicePixels="True" VerticalAlignment="Center">
                                <Path Data="{StaticResource IconCategory}"
                                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"
                                      StrokeThickness="1.55" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                      Stretch="Uniform" Width="15" Height="15" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <TextBlock Text="分类" Margin="10,0,0,0" FontWeight="SemiBold" VerticalAlignment="Center" />
                        </StackPanel>
                    </RadioButton>
                    <RadioButton x:Name="NavWeekly" GroupName="Nav"
                                 Style="{StaticResource NavItemStyle}"
                                 Click="Nav_Checked">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Border Width="28" Height="28" CornerRadius="9" Margin="-2,0,0,0" Background="Transparent" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" SnapsToDevicePixels="True" VerticalAlignment="Center">
                                <Path Data="{StaticResource IconWeekly}"
                                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"
                                      StrokeThickness="1.55" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                      Stretch="Uniform" Width="15" Height="15" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <TextBlock Text="每周必看" Margin="10,0,0,0" FontWeight="SemiBold" VerticalAlignment="Center" />
                        </StackPanel>
                    </RadioButton>

                    <!-- 分隔 -->
                    <Border Height="1" Background="{DynamicResource DividerBrush}" Margin="8,10" />

                    <!-- 我的 -->
                    <TextBlock Text="我的" FontSize="10.5" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextDisabledBrush}"
                               Margin="12,4,0,6" />
                    <RadioButton x:Name="NavLocal" GroupName="Nav"
                                 Style="{StaticResource NavItemStyle}"
                                 Click="Nav_Checked">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Border Width="28" Height="28" CornerRadius="9" Margin="-2,0,0,0" Background="Transparent" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" SnapsToDevicePixels="True" VerticalAlignment="Center">
                                <Path Data="{StaticResource IconLocal}"
                                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"
                                      StrokeThickness="1.55" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                      Stretch="Uniform" Width="15" Height="15" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <TextBlock Text="本地" Margin="10,0,0,0" VerticalAlignment="Center" FontWeight="SemiBold" />
                        </StackPanel>
                    </RadioButton>
                    <RadioButton x:Name="NavFavorite" GroupName="Nav"
                                 Style="{StaticResource NavItemStyle}"
                                 Click="Nav_Checked">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Border Width="28" Height="28" CornerRadius="9" Margin="-2,0,0,0" Background="Transparent" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" SnapsToDevicePixels="True" VerticalAlignment="Center">
                                <Path Data="{StaticResource IconFavoriteStar}"
                                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"
                                      StrokeThickness="1.55" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                      Stretch="Uniform" Width="15" Height="15" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <TextBlock Text="收藏" Margin="10,0,0,0" FontWeight="SemiBold" VerticalAlignment="Center" />
                        </StackPanel>
                   </RadioButton>
                   </StackPanel>
                    <!-- 漫画源切换：仅漫画模式显示 -->
                    <StackPanel x:Name="SourceSwitcherHost" Margin="2,0,2,8">
                        <TextBlock Text="漫画源" FontSize="10.5" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextDisabledBrush}"
                                   Margin="10,8,0,6" />
                        <ComboBox x:Name="SourceBox" Width="164"
                                  FontSize="12"
                                  SelectionChanged="SourceBox_SelectionChanged"
                                  ToolTip="当前漫画源（影响搜索 / 排行 / 分类 / 收藏）" />
                    </StackPanel>

                    <!-- 数据驱动导航栏 -->

                   <controls:NavRail x:Name="NavRailControl" Margin="0,4,0,0" />
               </StackPanel>
                   </DockPanel>
                </Border>
            </Grid>

            <!-- 内容区 -->
            <ContentControl x:Name="PageHost" Grid.Column="1" Margin="0,0,0,0" />

            <GridSplitter x:Name="PanelSplitter" Grid.Column="2" Width="5" Visibility="Collapsed"
                          HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                          Background="Transparent" ShowsPreview="True" />

            <!-- 右侧面板（兼容层保留；新代码通过 ISidebarPanel + ShellController 控制） -->
            <ContentControl x:Name="RightPanelHost" Grid.Column="3">
                <views:DownloadPanel x:Name="DownloadPanelView" />
            </ContentControl>

            <controls:SnackbarHost x:Name="Snackbars" Grid.Column="1"
                                   HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                   Margin="0,0,12,18" Panel.ZIndex="100" />
        </Grid>

    </Grid>
        </Border>
    </Border>
</Window>
