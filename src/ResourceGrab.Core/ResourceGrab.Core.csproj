<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <BaseOutputPath>$(MSBuildThisFileDirectory)..\..\bin\</BaseOutputPath><AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <AppendRuntimeIdentifierToOutputPath>false</AppendRuntimeIdentifierToOutputPath>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="AngleSharp" Version="1.7.1" />
    <PackageReference Include="Polly" Version="8.7.0" />
    <PackageReference Include="SixLabors.ImageSharp" Version="3.1.11" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="10.0.11" />
    <PackageReference Include="System.Text.Encoding.CodePages" Version="10.0.11" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="ResourceGrab.Core.Tests" />
  </ItemGroup>
  <ItemGroup>
    <!-- 离线词典：演员名翻译/标签归一化（amane 项目分发的 mapping 表）与繁简转换词典，随包内嵌无网络可用 -->
    <EmbeddedResource Include="Resources\mapping_actor.xml" />
    <EmbeddedResource Include="Resources\mapping_info.xml" />
    <EmbeddedResource Include="Resources\zhcdict.json" />
  </ItemGroup>
</Project>
